msgstr "Звичайна собі скульптура глиняного гончака."

#. STRINGS.RECIPE_DESC.CHESSPIECE_CLAYHOUND_SKETCH
msgctxt "STRINGS.RECIPE_DESC.CHESSPIECE_CLAYHOUND_SKETCH"
msgid "A sculpture sketch of the Clay Hound."
msgstr "Замальовка скульптури глиняного гончака."

#. STRINGS.RECIPE_DESC.CHESSPIECE_CLAYWARG_BUILDER
msgctxt "STRINGS.RECIPE_DESC.CHESSPIECE_CLAYWARG_BUILDER"
