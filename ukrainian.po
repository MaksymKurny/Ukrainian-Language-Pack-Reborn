msgstr "Ху-ух, кошеня дуже добре ховалося!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4"
