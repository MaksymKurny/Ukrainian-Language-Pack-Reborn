msgid "Is little metal helper."
msgstr "Маленький металевий помічничок."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINONA_TELEBRELLA.CHARGED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINONA_TELEBRELLA.CHARGED"
msgid "Is very funny umbrella."
msgstr "Дуже кумедна парасолька."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WINONA_TELEBRELLA.CHARGING
