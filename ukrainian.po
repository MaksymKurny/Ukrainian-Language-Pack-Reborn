msgstr "Треба погодувати птаха."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BIRDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BIRDCORPSE.BURNING"
