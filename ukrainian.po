#. STRINGS.SKIN_DESCRIPTIONS.woby_big_ribbon
msgctxt "STRINGS.SKIN_DESCRIPTIONS.woby_big_ribbon"
msgid "Who's the cutest?! Yes, you are, Woby! Yes, you are!"
msgstr "Хто в нас наймиліша?! Звісно ж ти, Вобі! Звісно ти!"

#. STRINGS.SKIN_DESCRIPTIONS.woby_big_ribbon_lunar
msgctxt "STRINGS.SKIN_DESCRIPTIONS.woby_big_ribbon_lunar"
msgid "n/a"
