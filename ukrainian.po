msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING"
msgid "All that beautiful wood wasted on carving birds..."
msgstr "Скільки чудової деревини змарновано на різьблення птахів..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_HERDING_CHICK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_HERDING_CHICK"
msgid "Get back here, you hoser!"
msgstr "Ану повернися, бевзю!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_HERDING_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.CARNIVALGAME_HERDING_KIT"
