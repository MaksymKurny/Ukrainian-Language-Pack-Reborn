msgstr "Унизу чути дивне гудіння."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMORDRAGONFLY"
