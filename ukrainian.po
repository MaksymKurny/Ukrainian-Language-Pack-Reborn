msgstr "Замальовка скульптури чарівного біфало."

#. STRINGS.RECIPE_DESC.CHESSPIECE_BEEQUEEN_BUILDER
msgctxt "STRINGS.RECIPE_DESC.CHESSPIECE_BEEQUEEN_BUILDER"
