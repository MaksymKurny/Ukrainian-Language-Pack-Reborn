msgstr "На вигляд як шкіра, смакує як м'ясо."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SNAPPER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SNAPPER"
