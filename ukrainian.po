msgstr "СТАРІЙШИНА ХОЧЕ СПАТИ"

#. STRINGS.QUAGMIRE_ELDER_TALK_BUY.6
msgctxt "STRINGS.QUAGMIRE_ELDER_TALK_BUY.6"
