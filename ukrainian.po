msgstr "Доповнення до вашої обстави, варте виїденого яйця."

#. STRINGS.RECIPE_DESC.CARNIVALDECOR_EGGRIDE2_KIT
msgctxt "STRINGS.RECIPE_DESC.CARNIVALDECOR_EGGRIDE2_KIT"
msgid "Pint-sized eggcitement!"
msgstr "Крута, як яйце!"

#. STRINGS.RECIPE_DESC.CARNIVALDECOR_EGGRIDE3_KIT
msgctxt "STRINGS.RECIPE_DESC.CARNIVALDECOR_EGGRIDE3_KIT"
