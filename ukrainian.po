msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FUMAROLEPICKAXE.WARM"
msgid "It'll keep me warm while I break rocks!"
msgstr "Воно грітиме мене, поки я лупатиму каміння!"

