msgid "Can tiny costume fit over Wolfgang's muscles?"
msgstr "Чи налізе крихітний костюмчик на Вольфґанґові м'язи?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC"
msgid "Little statue needs fire!"
msgstr "Малій статуї потрібен вогонь!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT"
msgid "Aw, is little statue!"
msgstr "Ой, маленька статуя!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC"
msgid "Little statue needs fire!"
msgstr "Малій статуї потрібен вогонь!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT"
msgid "Wolfgang likes looking at cute little lamb statue."
msgstr "Вольфґанґові подобається дивитися на милу статую ягнятка."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC"
msgid "Little statue needs fire!"
msgstr "Малій статуї потрібен вогонь!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT"
msgid "Tiny statue has grown mighty!"
msgstr "Крихітна статуя стала могутньою!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COTL_TRINKET
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COTL_TRINKET"
msgid "Is spooky crown for tiny head."
msgstr "Моторошна корона для крихітної голови."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COZY_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COZY_BUNNYMAN"
msgid "Rabbits look ready for bedtime."
msgstr "Зайчики, схоже, готові спатоньки."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRABKING.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRABKING.GENERIC"
msgid "This makes Wolfgang very scared AND hungry."
msgstr "Через нього Вольфґанґ дуже наляканий ТА голодний."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRABKING.INERT"
msgid "Is giant castle of sand!"
msgstr "Величезний замок з піску!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRABKING_CANNONTOWER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRABKING_CANNONTOWER"
msgid "Cowardly crabs like to toss rock."
msgstr "Краби-боягузи полюбляють кидатися каменюками."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRABKING_CLAW"
msgid "Keep away from boat, big pinchers!"
msgstr "Тримайтеся подалі від човна, величезні щипачі!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRABKING_ICEWALL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRABKING_ICEWALL"
msgid "Puny ice wall not stop Wolfgang."
msgstr "Жалюгідна крижана стінка не спинить Вольфґанґа."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRABKING_MOB
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRABKING_MOB"
msgid "Little crab is very bold for creature that is so delicious."
msgstr "Крабенятко надто зухвале, як для такого смачного звірятка."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRABKING_MOB_KNIGHT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRABKING_MOB_KNIGHT"
msgid "Come, tough guy. Wolfgang just warmed up."
msgstr "Підходь, здоровило. Вольфґанґ щойно розім'явся."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTERLAB"
msgid "Wolfgang hear little noises inside."
msgstr "Вольфґанґ чує тихесеньке шурхотіння всередині."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_BULBIN"
msgid "Onions are Wolfgang's best friend! Second to potato!"
msgstr "Цибуля — найкращий друг Вольфґанґа!.. Після картоплі!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_DRAGONLING"
msgid "Mighty pet! Very good!"
msgstr "Могутня тваринка! Дуже добре!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_EETS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_EETS"
msgid "Its legs look weak and scrawny, but jump good!"
msgstr "Ніжки в нього хирляві й худющі, але стрибає він добре!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_EYEOFTERROR"
msgid "Little eye not so scary!"
msgstr "Маленьке око не таке страшне!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_GLOMLING"
msgid "Flying bug friend!"
msgstr "Летючий жучок-дружок!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_KITTEN"
msgid "Small fur is Wolfgang's friend."
msgstr "Маленький пухнастик — друг Вольфґанґа."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_LAMB"
msgid "Is walking fluff!"
msgstr "Ходяча вовна!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "Strong Wolfgang will protect soft flutterby."
msgstr "Сильний Вольфґанґ захистить тендітного метеличка."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_PERDLING"
msgid "Bird baby is weak, but good."
msgstr "Пташенятко слабеньке, але добре."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRITTER_PUPPY"
msgid "I am call him Pupgang!"
msgstr "Зватиму його Варґанґ!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CROW.GENERIC"
msgid "I do not like birds. Too fragile."
msgstr "Я не люблю пташок. Затендітні."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CROW.HELD"
msgid "He is squawky."
msgstr "Вона галаслива."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CRUMBS"
msgid "Is clue! Yummy, yummy clue!"
msgstr "Це слід! Смачний, солодкий слід!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CURSED_MONKEY_TOKEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CURSED_MONKEY_TOKEN"
msgid "Gives Wolfgang the heebiddy jeebies."
msgstr "У Вольфґанґа аж мурашки біжать по шкірі."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CUTGRASS"
msgid "Is pile of grass."
msgstr "Купка трави."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CUTLESS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CUTLESS"
msgid "Is hard to cut with wooden sword."
msgstr "Важко рубати дерев'яним мечем."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CUTLICHEN"
msgid "Tastes terrible."
msgstr "Смакує жахливо."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CUTREEDS"
msgid "Is clump of reeds."
msgstr "Оберемок рогозу."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CUTSTONE"
msgid "Rock was crushed to make brick!"
msgstr "З розтрощеної каменюки вийшла цеглина!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DAYWALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DAYWALKER.GENERIC"
msgid "H-how about friendly game of arm wrestle, yes?"
msgstr "Я-як щодо товариської боротьби на руках, не проти?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DAYWALKER.IMPRISONED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DAYWALKER.IMPRISONED"
msgid "Angry piggie has gotten more muscles!"
msgstr "Зле порося наростило більше м'язів!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DAYWALKER2.BURIED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DAYWALKER2.BURIED"
msgid "Big monster piggie don't look so tough now."
msgstr "Тепер велика свинюка не здається такою вже й грізною."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DAYWALKER2.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DAYWALKER2.GENERIC"
msgid "Hey piggie! Wolfgang love to eat bacon for breakfast."
msgstr "Гей, поросятко! Вольфґанґ любить снідати беконом."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DAYWALKER2.HOSTILE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DAYWALKER2.HOSTILE"
msgid "Nice piggie. Wolfgang can't remember last time eat bacon."
msgstr "Гарне порося. Вольфґанґ і не пригадає, коли востаннє їв бекон."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DAYWALKER_PILLAR.EXPOSED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DAYWALKER_PILLAR.EXPOSED"
msgid "Mighty Wolfgang could... not break pillar."
msgstr "Могутній Вольфґанґ міг би... не ламати колону."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DAYWALKER_PILLAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DAYWALKER_PILLAR.GENERIC"
msgid "Mighty Wolfgang could break pillar!"
msgstr "Могутній Вольфґанґ міг би зламати колону!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DEADLYFEAST"
msgid "Look like evil food."
msgstr "Виглядає як зла їжа."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DEAD_SEA_BONES"
msgid "Big fish is very dead."
msgstr "Велика рибина досить мертва."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "Broke it."
msgstr "Убили його."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "Is small and broken now."
msgstr "Тепер малий і мертвий."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "Ha! You lose, tiny tree!"
msgstr "Ха! Ти програло, деревце!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "Hello, tree!"
msgstr "Привіт, деревце!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "Is big and angry tree."
msgstr "Велика та зла дерев'яка."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DECK_OF_CARDS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DECK_OF_CARDS"
msgid "Rip deck of cards in half is one of Wolfgang famous feat of strength!"
msgstr "Раніше славнозвісний Вольфґанґ демонстрував свою силу, розриваючи колоду карт навпіл!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DECOR_CENTERPIECE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DECOR_CENTERPIECE"
msgid "Tiny thing has no purpose. Is what makes it fancy."
msgstr "Від нього геть немає користі. Це і робить його гарненьким."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DECOR_FLOWERVASE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.DECOR_FLOWERVASE.EMPTY"
msgid "Wolfgang will be careful not to break."
msgstr "Вольфґанґ постарається її не розбити."

