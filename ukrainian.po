msgstr "Удвічі більше очей, удвічі більше терору."

#. STRINGS.RECIPE_DESC.CHESSPIECE_VAULT_PILLAR_GUARD_BUILDER
msgctxt "STRINGS.RECIPE_DESC.CHESSPIECE_VAULT_PILLAR_GUARD_BUILDER"
msgid "Imposing presence not included."
msgstr "Величний вигляд не передбачений."

#. STRINGS.RECIPE_DESC.CHESSPIECE_WAGBOSS_LUNAR_BUILDER
msgctxt "STRINGS.RECIPE_DESC.CHESSPIECE_WAGBOSS_LUNAR_BUILDER"
msgid "The abomination."
msgstr "Потвора."

#. STRINGS.RECIPE_DESC.CHESSPIECE_WAGBOSS_ROBOT_BUILDER
msgctxt "STRINGS.RECIPE_DESC.CHESSPIECE_WAGBOSS_ROBOT_BUILDER"
