msgstr "Спіральна!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SOIL_AMENDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SOIL_AMENDER.GENERIC"
