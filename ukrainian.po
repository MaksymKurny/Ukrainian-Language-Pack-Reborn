msgstr "Скульптура страхітливого глиняного варґа."

#. STRINGS.RECIPE_DESC.CHESSPIECE_CLAYWARG_SKETCH
msgctxt "STRINGS.RECIPE_DESC.CHESSPIECE_CLAYWARG_SKETCH"
msgid "A sculpture sketch of the Clay Varg."
msgstr "Замальовка скульптури глиняного варґа."

#. STRINGS.RECIPE_DESC.CHESSPIECE_CRABKING_BUILDER
msgctxt "STRINGS.RECIPE_DESC.CHESSPIECE_CRABKING_BUILDER"
