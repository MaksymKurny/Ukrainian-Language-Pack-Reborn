msgstr "Наст. Пропозиція"

#. STRINGS.UI.TRADESCREEN.NOSPECIALS
msgctxt "STRINGS.UI.TRADESCREEN.NOSPECIALS"
msgid "Unspecials"
msgstr "Звичайні пропозиції"

#. STRINGS.UI.TRADESCREEN.NO_RECIPES
msgctxt "STRINGS.UI.TRADESCREEN.NO_RECIPES"
msgid "No offers"
msgstr "Немає пропозицій"

#. STRINGS.UI.TRADESCREEN.OFFLINE
msgctxt "STRINGS.UI.TRADESCREEN.OFFLINE"
msgid "The Trade Inn is not available in offline mode."
msgstr "Міняйломат недоступний поза мережею."

#. STRINGS.UI.TRADESCREEN.OK
msgctxt "STRINGS.UI.TRADESCREEN.OK"
msgid "OK"
msgstr "Так"

#. STRINGS.UI.TRADESCREEN.PREV
msgctxt "STRINGS.UI.TRADESCREEN.PREV"
msgid "Prev. Special"
msgstr "Поп. Пропозиція"

