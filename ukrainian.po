msgstr "Захистимо вас"

#. STRINGS.SHADOWTHRALL_PARASITE_CHANT.27
msgctxt "STRINGS.SHADOWTHRALL_PARASITE_CHANT.27"
msgid "Under the veil"
msgstr "Під серпанком"

#. STRINGS.SHADOWTHRALL_PARASITE_CHANT.3
msgctxt "STRINGS.SHADOWTHRALL_PARASITE_CHANT.3"
msgid "salutations"
msgstr "вітання"

#. STRINGS.SHADOWTHRALL_PARASITE_CHANT.4
msgctxt "STRINGS.SHADOWTHRALL_PARASITE_CHANT.4"
msgid "friends"
msgstr "друзі"

#. STRINGS.SHADOWTHRALL_PARASITE_CHANT.5
