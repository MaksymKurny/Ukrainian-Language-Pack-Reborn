msgstr "Грибодерево має нездоровий запах."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHTREE_TALL_WEBBED.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUSHTREE_TALL_WEBBED.GENERIC"
