msgstr "Замальовка скульптури могутнього мальбатроса."

#. STRINGS.RECIPE_DESC.CHESSPIECE_MANRABBIT_BUILDER
msgctxt "STRINGS.RECIPE_DESC.CHESSPIECE_MANRABBIT_BUILDER"
