msgstr "Тому роботу слід узяти себе в руки."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78MODULE_MUSIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78MODULE_MUSIC"
msgid "They wouldn't..."
msgstr "Робот не посміє..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78MODULE_NIGHTVISION
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.WX78MODULE_NIGHTVISION"
