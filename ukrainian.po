msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUTATEDBIRD"
msgid "Hello, monster birdie. Stay away from Wolfgang, please."
msgstr "Вітаю, пташисько. Тримайся подалі від Вольфґанґа, будь ласка."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUTATEDBUZZARD_GESTALT.EATING_CORPSE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUTATEDBUZZARD_GESTALT.EATING_CORPSE"
