msgid "ME WON'T DESTROY YOU... PROMISE."
msgstr "Я НЕ ЗНИЩУВАТИ ТЕБЕ... ОБІЦЯТИ."

#. STRINGS.DAYWALKER2_CHASE_AWAY.1
msgctxt "STRINGS.DAYWALKER2_CHASE_AWAY.1"
msgid "ME DESTROY YOU!"
msgstr "Я ЗНИЩИТИ ТЕБЕ!"

#. STRINGS.DAYWALKER2_CHASE_AWAY.2
msgctxt "STRINGS.DAYWALKER2_CHASE_AWAY.2"
msgid "THIEF!"
msgstr "КРАДІЙ!"

#. STRINGS.DAYWALKER2_CHASE_AWAY.3
msgctxt "STRINGS.DAYWALKER2_CHASE_AWAY.3"
msgid "RAAAAAAAAGGHH!"
msgstr "ГАР-Р-Р-Р-Р-Р-Р!"

#. STRINGS.DAYWALKER2_CHASE_AWAY.4
msgctxt "STRINGS.DAYWALKER2_CHASE_AWAY.4"
msgid "YOU MUST DIE!"
msgstr "ПОМРИ!"

#. STRINGS.DAYWALKER2_CHASE_AWAY.5
msgctxt "STRINGS.DAYWALKER2_CHASE_AWAY.5"
msgid "IS ALL MINE!"
msgstr "ЦЕ ВСЕ МОЄ!"

#. STRINGS.DAYWALKER2_JUNK_WARNING.1
msgctxt "STRINGS.DAYWALKER2_JUNK_WARNING.1"
msgid "ALL MINE."
msgstr "ВСЕ МОЄ."

#. STRINGS.DAYWALKER2_JUNK_WARNING.2
msgctxt "STRINGS.DAYWALKER2_JUNK_WARNING.2"
msgid "DON'T TOUCH."
msgstr "НЕ ЧІПАЙ."

#. STRINGS.DAYWALKER2_JUNK_WARNING.3
msgctxt "STRINGS.DAYWALKER2_JUNK_WARNING.3"
msgid "LAST WARNING."
msgstr "ОСТАННЄ ПОПЕРЕДЖЕННЯ."

#. STRINGS.DAYWALKER2_JUNK_WARNING.4
msgctxt "STRINGS.DAYWALKER2_JUNK_WARNING.4"
msgid "GET LOST!"
msgstr "ЙДИ ГЕТЬ!"

#. STRINGS.DAYWALKER2_JUNK_WARNING.5
msgctxt "STRINGS.DAYWALKER2_JUNK_WARNING.5"
msgid "NOT FOR YOU!"
msgstr "НЕ ДЛЯ ТЕБЕ!"

#. STRINGS.DAYWALKER2_JUNK_WARNING.6
msgctxt "STRINGS.DAYWALKER2_JUNK_WARNING.6"
msgid "GET OUT!"
msgstr "ЗАБИРАЙСЯ!"

#. STRINGS.DAYWALKER2_RUMMAGE_FAIL.1
msgctxt "STRINGS.DAYWALKER2_RUMMAGE_FAIL.1"
msgid "TRASH!"
msgstr "СМІТТЯ!"

#. STRINGS.DAYWALKER2_RUMMAGE_FAIL.2
msgctxt "STRINGS.DAYWALKER2_RUMMAGE_FAIL.2"
msgid "BLEGH!"
msgstr "ТЬХУ!"

#. STRINGS.DAYWALKER2_RUMMAGE_FAIL.3
msgctxt "STRINGS.DAYWALKER2_RUMMAGE_FAIL.3"
msgid "WORTHLESS."
msgstr "НЕПОТРІБ."

#. STRINGS.DAYWALKER2_RUMMAGE_FAIL.4
msgctxt "STRINGS.DAYWALKER2_RUMMAGE_FAIL.4"
msgid "USELESS!"
msgstr "НІКУДИШНІЙ!"

#. STRINGS.DAYWALKER2_RUMMAGE_FAIL.5
msgctxt "STRINGS.DAYWALKER2_RUMMAGE_FAIL.5"
msgid "RAAAAAAGGHH! ALL GARBAGE!"
msgstr "ГАР-Р-Р-Р-Р-Р-Р! ВСЕ СМІТТЯ!"

#. STRINGS.DAYWALKER2_RUMMAGE_SUCCESS.1
msgctxt "STRINGS.DAYWALKER2_RUMMAGE_SUCCESS.1"
msgid "ME LIKE."
msgstr "МЕНІ ПОДОБАТИСЯ."

#. STRINGS.DAYWALKER2_RUMMAGE_SUCCESS.2
msgctxt "STRINGS.DAYWALKER2_RUMMAGE_SUCCESS.2"
msgid "GOOD STUFF."
msgstr "ГАРНИЙ ШТУКА."

#. STRINGS.DAYWALKER2_RUMMAGE_SUCCESS.3
msgctxt "STRINGS.DAYWALKER2_RUMMAGE_SUCCESS.3"
msgid "MINE."
msgstr "МОЄ."

#. STRINGS.DAYWALKER2_RUMMAGE_SUCCESS.4
msgctxt "STRINGS.DAYWALKER2_RUMMAGE_SUCCESS.4"
msgid "YES!"
msgstr "ТАК!"

#. STRINGS.DAYWALKER2_RUMMAGE_SUCCESS.5
msgctxt "STRINGS.DAYWALKER2_RUMMAGE_SUCCESS.5"
msgid "MORE!"
msgstr "БІЛЬШЕ!"

#. STRINGS.DAYWALKER2_RUMMAGE_SUCCESS.6
msgctxt "STRINGS.DAYWALKER2_RUMMAGE_SUCCESS.6"
msgid "NICE."
msgstr "ДОБРЕ."

#. STRINGS.DAYWALKER2_RUMMAGE_SUCCESS.7
msgctxt "STRINGS.DAYWALKER2_RUMMAGE_SUCCESS.7"
msgid "NEED MORE POWER."
msgstr "ТРЕБА БІЛЬШЕ ЕНЕРГІЯ."

#. STRINGS.DAYWALKER2_RUMMAGE_SUCCESS.8
msgctxt "STRINGS.DAYWALKER2_RUMMAGE_SUCCESS.8"
msgid "OOH."
msgstr "О-ОХ."

#. STRINGS.DAYWALKER2_RUMMAGE_SUCCESS.9
msgctxt "STRINGS.DAYWALKER2_RUMMAGE_SUCCESS.9"
msgid "MMM."
msgstr "М-М-М."

#. STRINGS.DAYWALKER_ATTACK.1
msgctxt "STRINGS.DAYWALKER_ATTACK.1"
msgid "HEH HEH HEH..."
msgstr "ХЕ-ХЕ-ХЕ..."

#. STRINGS.DAYWALKER_ATTACK.2
msgctxt "STRINGS.DAYWALKER_ATTACK.2"
msgid "FREE... FREE!!"
msgstr "ВІЛЬНИЙ... ВІЛЬНИЙ!!"

#. STRINGS.DAYWALKER_ATTACK.3
msgctxt "STRINGS.DAYWALKER_ATTACK.3"
msgid "GRAAAR!!"
msgstr "ГА-А-АР-Р!!"

#. STRINGS.DAYWALKER_ATTACK.4
msgctxt "STRINGS.DAYWALKER_ATTACK.4"
msgid "PESTS!"
msgstr "ШКІДНИКИ!"

#. STRINGS.DAYWALKER_ATTACK.5
msgctxt "STRINGS.DAYWALKER_ATTACK.5"
msgid "ME DESTROY YOU!"
msgstr "Я ЗНИЩИТИ ТЕБЕ!"

#. STRINGS.DAYWALKER_ATTACK.6
msgctxt "STRINGS.DAYWALKER_ATTACK.6"
msgid "IS MINE! MINE!!"
msgstr "ЦЕ МОЄ! МОЄ!!"

#. STRINGS.DAYWALKER_COLLIDE.1
msgctxt "STRINGS.DAYWALKER_COLLIDE.1"
msgid "OWWWWW!"
msgstr "ОУ-У-У-У-У-У!"

#. STRINGS.DAYWALKER_COLLIDE.2
msgctxt "STRINGS.DAYWALKER_COLLIDE.2"
msgid "OOF!"
msgstr "УХ!"

#. STRINGS.DAYWALKER_IMPRISONED_FAR.1
msgctxt "STRINGS.DAYWALKER_IMPRISONED_FAR.1"
msgid "UUGH..."
msgstr "У-УХ-Х..."

#. STRINGS.DAYWALKER_IMPRISONED_FAR.2
msgctxt "STRINGS.DAYWALKER_IMPRISONED_FAR.2"
msgid "...(growl)..."
msgstr "...(гарчить)..."

#. STRINGS.DAYWALKER_IMPRISONED_FAR.3
msgctxt "STRINGS.DAYWALKER_IMPRISONED_FAR.3"
msgid "ME FOUND IT FIRST... ME!"
msgstr "Я ЗНАЙТИ ЦЕ ПЕРШИЙ... Я!"

#. STRINGS.DAYWALKER_IMPRISONED_FAR.4
msgctxt "STRINGS.DAYWALKER_IMPRISONED_FAR.4"
msgid "...UUUGH..."
msgstr "...У-У-УХ..."

#. STRINGS.DAYWALKER_IMPRISONED_NEAR.1
msgctxt "STRINGS.DAYWALKER_IMPRISONED_NEAR.1"
msgid "FREE... ME..."
msgstr "ЗВІЛЬНИ... МЕНЕ..."

#. STRINGS.DAYWALKER_IMPRISONED_NEAR.2
msgctxt "STRINGS.DAYWALKER_IMPRISONED_NEAR.2"
msgid "...UUGH..."
msgstr "...У-УХ..."

#. STRINGS.DAYWALKER_IMPRISONED_NEAR.3
msgctxt "STRINGS.DAYWALKER_IMPRISONED_NEAR.3"
msgid "COME... CLOSER..."
msgstr "ПІДІЙДИ... БЛИЖЧЕ..."

#. STRINGS.DAYWALKER_IMPRISONED_NEAR.4
msgctxt "STRINGS.DAYWALKER_IMPRISONED_NEAR.4"
msgid "PLEASE..."
msgstr "ПРОШУ..."

#. STRINGS.DAYWALKER_IMPRISONED_PILLAR_BREAKING.1
msgctxt "STRINGS.DAYWALKER_IMPRISONED_PILLAR_BREAKING.1"
msgid "YES!"
msgstr "ТАК!"

#. STRINGS.DAYWALKER_IMPRISONED_PILLAR_BREAKING.2
msgctxt "STRINGS.DAYWALKER_IMPRISONED_PILLAR_BREAKING.2"
msgid "KEEP GOING!"
msgstr "ДАЛІ, ДАЛІ!"

#. STRINGS.DAYWALKER_IMPRISONED_PILLAR_BREAKING.3
msgctxt "STRINGS.DAYWALKER_IMPRISONED_PILLAR_BREAKING.3"
msgid "HURRY! HURRY!"
msgstr "ШВИДШЕ! ШВИДШЕ!"

#. STRINGS.DAYWALKER_IMPRISONED_STRUGGLE.1
msgctxt "STRINGS.DAYWALKER_IMPRISONED_STRUGGLE.1"
msgid "ITCHY!"
msgstr "СВЕРБИТЬ!"

#. STRINGS.DAYWALKER_IMPRISONED_STRUGGLE.2
msgctxt "STRINGS.DAYWALKER_IMPRISONED_STRUGGLE.2"
msgid "CAN'T MOVE!"
msgstr "НЕ ВОРУХНУТИСЯ!"

#. STRINGS.DAYWALKER_LEECH_BITE.1
msgctxt "STRINGS.DAYWALKER_LEECH_BITE.1"
msgid "AHHH!"
msgstr "А-А-А-А!"

#. STRINGS.DAYWALKER_LEECH_BITE.2
msgctxt "STRINGS.DAYWALKER_LEECH_BITE.2"
msgid "OW!!"
msgstr "ОЙ!!"

#. STRINGS.DAYWALKER_POWERDOWN.1
msgctxt "STRINGS.DAYWALKER_POWERDOWN.1"
msgid "M-MY POWER..."
msgstr "М-МОЯ СИЛА..."

#. STRINGS.DAYWALKER_POWERDOWN.2
msgctxt "STRINGS.DAYWALKER_POWERDOWN.2"
msgid "THIS NOT OVER!"
msgstr "ЦЕ НЕ КІНЕЦЬ!"

#. STRINGS.DAYWALKER_RE_IMPRISONED_NEAR.1
msgctxt "STRINGS.DAYWALKER_RE_IMPRISONED_NEAR.1"
msgid "CAN'T KEEP... ME HERE... FOREVER..."
msgstr "МЕНЕ НЕ ВТРИМАТИ... ТУТ... НАЗАВЖДИ..."

#. STRINGS.DAYWALKER_RE_IMPRISONED_NEAR.2
msgctxt "STRINGS.DAYWALKER_RE_IMPRISONED_NEAR.2"
msgid "ME FIND CRACK TO DARK PLACE... ME!"
msgstr "Я ЗНАЙТИ ТРІЩИНА ДО ТЕМНОГО МІСЦЯ... Я!"

#. STRINGS.DAYWALKER_RE_IMPRISONED_NEAR.3
msgctxt "STRINGS.DAYWALKER_RE_IMPRISONED_NEAR.3"
msgid "POWER SHOULD BE FOR ME!"
msgstr "СИЛА ПОВИНА БУТИ МОЯ!"

#. STRINGS.DAYWALKER_RE_IMPRISONED_NEAR.4
msgctxt "STRINGS.DAYWALKER_RE_IMPRISONED_NEAR.4"
msgid "COWARDS!"
msgstr "БОЯГУЗИ!"

#. STRINGS.DAYWALKER_SHAKE_LEECHES.1
msgctxt "STRINGS.DAYWALKER_SHAKE_LEECHES.1"
msgid "OFF OF ME!"
msgstr "ГЕТЬ ВІД МЕНЕ!"

#. STRINGS.DAYWALKER_SHAKE_LEECHES.2
msgctxt "STRINGS.DAYWALKER_SHAKE_LEECHES.2"
msgid "GET OFF!!"
msgstr "ГЕТЬ!!"

#. STRINGS.DAYWALKER_SHAKE_LEECHES.3
msgctxt "STRINGS.DAYWALKER_SHAKE_LEECHES.3"
msgid "RAAAAUUGGHH!"
msgstr "ГА-А-АР-Р-Р-Р!"

#. STRINGS.DAYWALKER_SHAKE_LEECHES.4
msgctxt "STRINGS.DAYWALKER_SHAKE_LEECHES.4"
msgid "VERMIN!"
msgstr "ПАРАЗИТ!"

#. STRINGS.DAYWALKER_TIRED.1
msgctxt "STRINGS.DAYWALKER_TIRED.1"
msgid "HUFF... HUFF..."
msgstr "ХУХ... ХУХ..."

#. STRINGS.DAYWALKER_TIRED.2
msgctxt "STRINGS.DAYWALKER_TIRED.2"
msgid "BETTER... YES, MUCH BETTER."
msgstr "КРАЩЕ... ТАК, КУДИ КРАЩЕ."

#. STRINGS.DEADCREATURE
msgctxt "STRINGS.DEADCREATURE"
msgid "Dead"
msgstr "Мертвий"

