msgstr "Ти ба! Ти старанно тренувалась!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC"
