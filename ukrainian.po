msgstr "Майже не поступається справжній фортеці."

#. STRINGS.RECIPE_DESC.CHESSPIECE_SHARKBOI_BUILDER
msgctxt "STRINGS.RECIPE_DESC.CHESSPIECE_SHARKBOI_BUILDER"
