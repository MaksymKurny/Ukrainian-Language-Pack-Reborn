msgstr "Скульптура грози морів."

#. STRINGS.RECIPE_DESC.CHESSPIECE_MALBATROSS_SKETCH
msgctxt "STRINGS.RECIPE_DESC.CHESSPIECE_MALBATROSS_SKETCH"
