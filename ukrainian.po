msgstr "Тріумфальна скульптура чемпіонки."

#. STRINGS.RECIPE_DESC.CHESSPIECE_CARRAT_SKETCH
msgctxt "STRINGS.RECIPE_DESC.CHESSPIECE_CARRAT_SKETCH"
msgid "A sculpture sketch of a victorious carrat."
msgstr "Замальовка скульптури звитяжної щурквини."

#. STRINGS.RECIPE_DESC.CHESSPIECE_CATCOON_BUILDER
msgctxt "STRINGS.RECIPE_DESC.CHESSPIECE_CATCOON_BUILDER"
