msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENTFRUIT_GEM"
msgid "Even Wolfgang's mighty jaw can't bite into funny rock-fruit."
msgstr "Навіть Вольфґанґові могутні щелепи не розкусять дивний кам'яний фрукт."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENTFRUIT_NIGHTVISION
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENTFRUIT_NIGHTVISION"
msgid "Eeep!"
msgstr "О-о-о-о!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED"
msgid "Is less gross, but still not look yummy."
msgstr "Менш бридотна, та все ще не дуже апетитна."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENTTREE_GEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENTTREE_GEM.GENERIC"
msgid "Rocky tree have big strong trunk like Wolfgang."
msgstr "Стовбур великого кам'яного дерева так само сильний, як Вольфґанґ."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENTTREE_GEM.STUMP
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENTTREE_GEM.STUMP"
msgid "You give to us everything."
msgstr "Ти віддав нам усе."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC"
msgid "Tree give Wolfgang sad feelings."
msgstr "Вольфґанґові сумно від цього дерева."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP"
msgid "Much better."
msgstr "Значно краще."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC"
msgid "Little tree, grow mighty like Wolfgang!"
msgstr "Деревце, рости могутнім, як Вольфґанґ!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON"
msgid "Maybe try again later, little one."
msgstr "Може, спробуй пізніше, малюче."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE"
msgid "Little one don't like it here?"
msgstr "Деревцю тут не до вподоби?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENTTREE_SAPLING_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENTTREE_SAPLING_ITEM"
msgid "Don't worry, little tree. Wolfgang find good home for you."
msgstr "Не хвилюйся, деревце. Вольфґанґ знайде тобі хороший дім."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENTTREE_SEED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENTTREE_SEED"
msgid "What does little seed want to be when it grow up?"
msgstr "Ким зернятко хоче стати, як виросте?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENT_ALTAR"
msgid "Is nasty, creepy altar."
msgstr "Гидкий, моторошний вівтар."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "Is broken altar."
msgstr "Зруйнований вівтар."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENT_HUSK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENT_HUSK"
msgid "Too much violence for Wolfgang."
msgstr "Забагато насилля для Вольфґанґа."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANCIENT_STATUE"
msgid "Ugly, ugly, ugly."
msgstr "Негарна, негарна, негарна."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANIMAL_TRACK"
msgid "Animal went this way."
msgstr "Звір ішов цим шляхом."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANTCHOVIES
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANTCHOVIES"
msgid "Is little squirmy sea bug."
msgstr "Манюсінький верткий морський жучок."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANTLION.GENERIC"
msgid "Scary monster is friend?"
msgstr "Страшний монстр — друг?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANTLION.UNHAPPY"
msgid "Monster is looking very scary!"
msgstr "Монстр виглядає дуже страшним!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANTLION.VERYHAPPY"
msgid "Monster does not look hungry today."
msgstr "Монстр сьогодні не дуже голодний."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANTLIONHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANTLIONHAT"
msgid "The ground will flee before mighty Wolfgang!"
msgstr "Земля тікатиме від могутнього Вольфґанґа!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ANTLIONTRINKET"
msgid "Is not for head."
msgstr "Не для голови."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_CENTIPEDE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_CENTIPEDE"
msgid "Metal bug is angry."
msgstr "Металевий жук злий."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK"
msgid "Is big pile of junk."
msgstr "Величезна купа сміття."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_COOKPOT.BURNT"
msgid "Pot is dead."
msgstr "Казану хана."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG"
msgid "This take long time."
msgstr "Це забере багато часу."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT"
msgid "Is almost cook!"
msgstr "Майже готово!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_COOKPOT.DONE"
msgid "Is time to eat!"
msgstr "Час попоїсти!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_COOKPOT.EMPTY"
msgid "Is dusty old pot."
msgstr "Старий казан, увесь в пилюці."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_LOCKBOX
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_LOCKBOX"
msgid "Strange box puzzles Wolfgang..."
msgstr "Дивна скринька пантеличить Вольфґанґа..."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC"
msgid "Buttons for Wolfgang to mash mightily!"
msgstr "Кнопки, які Вольфґанґ може щосили натискати!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF"
msgid "Silly machine does nothing."
msgstr "Дурна машина нічого не робить."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_MOON_STATUE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_MOON_STATUE"
msgid "Ha! Wolfgang could carry big rock all by himself!"
msgstr "Ха! А Вольфґанґ може тягати великі каменюки самотужки!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN"
msgid "Floor is making sounds!"
msgstr "Підлога видає звуки!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_PORTAL.GENERIC"
msgid "Maybe is just pretty floor."
msgstr "Можливо, це просто гарна підлога."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_PORTAL.POWEROFF
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_PORTAL.POWEROFF"
msgid "Is another door?"
msgstr "Ще одні двері?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_RESONATOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_RESONATOR.GENERIC"
msgid "Will show the way to... something."
msgstr "Покаже шлях... кудись."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_RESONATOR.IDLE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_RESONATOR.IDLE"
msgid "Is pointing way no more."
msgstr "Більше не показує дорогу."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_RESONATOR_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_RESONATOR_ITEM"
msgid "Is magic or science, Wolfgang not picky."
msgstr "Магія чи наука, Вольфґанґ неперебірливий."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1"
msgid "Is nice statue, but is covered in scribblemarks."
msgstr "Гарна статуя, але вся розписана каракулями."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2"
msgid "Very fancy."
msgstr "Дуже красиво."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3"
msgid "Is nice statue, but is covered in scribblemarks."
msgstr "Гарна статуя, але вся розписана каракулями."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4"
msgid "Very fancy."
msgstr "Дуже красиво."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5"
msgid "Is nice statue, but is covered in scribblemarks."
msgstr "Гарна статуя, але вся розписана каракулями."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC"
msgid "Wolfgang was wrong, is very bad."
msgstr "Вольфґанґ помилився, він дуже небезпечний."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF"
msgid "Seems fine to Wolfgang."
msgstr "Вольфґанґ думає, що він безпечний."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_SECURITY_PULSE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_SECURITY_PULSE"
msgid "Where you going? Wolfgang will follow!"
msgstr "Куди це ти? Вольфґанґ піде за тобою!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_SWITCH.GEMS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_SWITCH.GEMS"
msgid "Fancy pillar is empty. Too bad."
msgstr "Розкішний стовп порожній. Дуже шкода."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_SWITCH.VALID
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARCHIVE_SWITCH.VALID"
