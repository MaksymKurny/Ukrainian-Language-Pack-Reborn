msgstr "Замальовка скульптури грайливого зайцелюда."

#. STRINGS.RECIPE_DESC.CHESSPIECE_MINOTAUR_BUILDER
msgctxt "STRINGS.RECIPE_DESC.CHESSPIECE_MINOTAUR_BUILDER"
