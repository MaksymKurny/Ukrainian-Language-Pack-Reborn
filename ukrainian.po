msgstr "Машина."

#. STRINGS.RECIPE_DESC.CHESSPIECE_WARG_MUTATED_BUILDER
msgctxt "STRINGS.RECIPE_DESC.CHESSPIECE_WARG_MUTATED_BUILDER"
