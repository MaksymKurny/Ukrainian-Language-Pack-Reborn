msgid "Set your profile icon to a pack-leading Varg.\nHappy Year of the Varg!"
msgstr "Встановіть вожака варґів як значок свого профілю.\nЩасливого року Варґа!"

#. STRINGS.SKIN_DESCRIPTIONS.profileflair_victorian_boar
msgctxt "STRINGS.SKIN_DESCRIPTIONS.profileflair_victorian_boar"
