msgstr "Ваги, аби виміряти могутність риби!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM"
