msgstr "Південь"

#. STRINGS.DIRECTIONS.SE
msgctxt "STRINGS.DIRECTIONS.SE"
msgid "Southeast"
msgstr "Південний схід"

#. STRINGS.DIRECTIONS.SW
msgctxt "STRINGS.DIRECTIONS.SW"
msgid "Southwest"
msgstr "Південний захід"

