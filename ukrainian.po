msgstr "Не думаю, що мені варто тримати її в себе."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABIGAIL_FLOWER.LEVEL1
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABIGAIL_FLOWER.LEVEL1"
msgid "Do you need some alone time?"
msgstr "Тобі потрібно побути наодинці?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABIGAIL_FLOWER.LEVEL2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ABIGAIL_FLOWER.LEVEL2"
