msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CONSTRUCTION_PLANS"
msgid "If Wolfgang build it, they will come."
msgstr "Якщо Вольфґанґ його збудує — вони прийдуть."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOKBOOK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOKBOOK"
msgid "Is book of things to fill Wolfgang's mighty belly!"
msgstr "Книга про все, що наситить Вольфґанґовий могутній животик!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOKEDMANDRAKE"
msgid "Little plant man is food?"
msgstr "Маленьку балакучу рослинку можна їсти?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOKEDMEAT"
msgid "I made meat good with fire!"
msgstr "Від вогню м'ясо стало смачним!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOKEDMONSTERMEAT"
msgid "I still do not want to eat this."
msgstr "Я все ще не хочу його їсти."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOKEDSMALLMEAT"
msgid "It is even smaller cooked!"
msgstr "Від готування він став іще меншим!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOKIECUTTER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOKIECUTTER"
msgid "Fish has strangely punchable face..."
msgstr "Рибка має писок, у який дуже хочеться вгатити..."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOKIECUTTERHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOKIECUTTERHAT"
msgid "Keep head safe and dry!"
msgstr "Голова буде суха й захищена!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOKIECUTTERSHELL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOKIECUTTERSHELL"
msgid "Tough, but not as tough as Wolfgang!"
msgstr "Міцний, але не такий міцний, як Вольфґанґ!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOKINGRECIPECARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOKINGRECIPECARD.GENERIC"
msgid "Wolfgang can't read puny writing!"
msgstr "Вольфґанґ не вміє читати нікчемні писульки!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOKPOT.BURNT"
msgid "Pot is dead."
msgstr "Казану хана."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "This take long time."
msgstr "Це забере багато часу."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "Is almost cook!"
msgstr "Майже готово!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOKPOT.DONE"
msgid "Is time to eat!"
msgstr "Час попоїсти!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOKPOT.EMPTY"
msgid "Wolfgang will cook good meal for friends, meal like home!"
msgstr "Вольфґанґ готуватиме гарну їжу для друзів — їжу, як удома!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOLANT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COOLANT"
msgid "Bubble, bubble."
msgstr "Буль, буль."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COONTAIL"
msgid "Wiggly cat part!"
msgstr "Котик ним махає!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CORN"
msgid "Is corn. What expect?"
msgstr "Кукурудза. Що ще сказати?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CORN_COOKED"
msgid "Pop pop pop! Ha ha, funny corn."
msgstr "Лусь, лусь, лусь! Ха-ха, смішні зернятка."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CORN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CORN_OVERSIZED"
msgid "Wolfgang's muscles will get even more mighty lifting giant corn!"
msgstr "Вольфґанґові м'язи стануть іще могутнішими, піднімаючи величезну кукурудзу!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.CORN_SEEDS"
msgid "Is seeds for growing."
msgstr "Насінини для вирощування."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COSTUME_BLACKSMITH_BODY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COSTUME_BLACKSMITH_BODY"
msgid "Can tiny costume fit over Wolfgang's muscles?"
msgstr "Чи налізе крихітний костюмчик на Вольфґанґові м'язи?"

