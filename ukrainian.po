msgstr "Теплі соковиті кульки."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BERRIES_JUICY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BERRIES_JUICY"
