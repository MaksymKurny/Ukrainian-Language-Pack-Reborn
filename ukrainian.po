msgstr "Замальовка скульптури башти з єнотокошенят."

#. STRINGS.RECIPE_DESC.CHESSPIECE_KLAUS_BUILDER
msgctxt "STRINGS.RECIPE_DESC.CHESSPIECE_KLAUS_BUILDER"
