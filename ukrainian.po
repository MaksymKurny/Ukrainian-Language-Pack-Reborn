#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CALL_BEEF
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CALL_BEEF"
msgid "Come, hair-cow!"
msgstr "Ходи, волохата корово!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CANFIX
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CANFIX"
msgid "\nMighty brain could make this better!"
msgstr "\nМогутній мозок може оце повернути у форму!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CANNOT_BUILD.NO_INGREDIENTS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CANNOT_BUILD.NO_INGREDIENTS"
msgid "Is no good, Wolfgang doesn't have enough!"
msgstr "Недобре: Вольфґанґові не вистачає!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CANNOT_BUILD.NO_STATION
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CANNOT_BUILD.NO_STATION"
msgid "Wolfgang will need right working-place!"
msgstr "Вольфґанґові знадобиться належне робоче місце!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CANNOT_BUILD.NO_TECH
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CANNOT_BUILD.NO_TECH"
msgid "Hmm, is tricky. Wolfgang should learn how to make."
msgstr "Гм-м, хитромудро. Вольфґанґові варто навчитися таке робити."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CANTBUILDHERE_YOTB_POST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CANTBUILDHERE_YOTB_POST"
msgid "How will judge see Wolfgang's beautiful hair-cow from so far away?"
msgstr "Як суддя побачить Вольфґанґову прекрасну волохату корову аж з такої далечіні?"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CANT_ESCAPE_CURSE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CANT_ESCAPE_CURSE"
msgid "Aaaah! Spooky beads came back to Wolfgang!"
msgstr "А-а-а-а! Моторошні намистинки повернулися до Вольфґанґа!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP"
msgid "Is not the sleepytime!"
msgstr "Не час спати!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CARRAT_ERROR_STUNNED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CARRAT_ERROR_STUNNED"
msgid "Will not win like that! Must go!"
msgstr "Так не виграєш! Ворушися!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CARRAT_ERROR_WALKING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CARRAT_ERROR_WALKING"
msgid "Leggy carrot must go faster!"
msgstr "Морквинка з лапками має рухатися швидше!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1"
msgid "No! Wrong way!"
msgstr "Ні! Не туди!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2"
msgid "You go wrong way, leggy carrot!"
msgstr "Тобі не туди, морквинко з лапками!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CARRAT_START_RACE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CARRAT_START_RACE"
msgid "Leggy carrot race start NOW!"
msgstr "Перегони морквинок з лапками розпочнуться... ЗАРАЗ!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CAVEIN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CAVEIN"
msgid "Sky is fall soon."
msgstr "Небо скоро впаде."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CHAIR_ON_FIRE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CHAIR_ON_FIRE"
msgid "Wolfgang is fine."
msgstr "У Вольфґанґа все гаразд."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CHARLIE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CHARLIE"
msgid "Show yourself!"
msgstr "Покажися!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CHARLIESAVE.1
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CHARLIESAVE.1"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CHARLIE_ATTACK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CHARLIE_ATTACK"
msgid "Ow! It got me!"
msgstr "Ой! Мене зачепило!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_COACH.1
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_COACH.1"
msgid "Do not worry, friends! Wolfgang is here to fight with you!"
msgstr "Не хвилюйтеся, друзі! Вольфґанґ тут, аби битися з вами!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_COACH.2
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_COACH.2"
msgid "Remember what Wolfgang has taught you!"
msgstr "Пам'ятайте, чого вас навчив Вольфґанґ!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_COACH.3
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_COACH.3"
msgid "When you are scared, just think of Wolfgang!"
msgstr "Коли вам лячно, просто згадайте Вольфґанґа!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_COACH.4
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_COACH.4"
msgid "Be brave, friends! Like Wolfgang!"
msgstr "Будьте хоробрі, друзі! Як Вольфґанґ!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_COACH.5
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_COACH.5"
msgid "You are strong! Strong like Wolfgang!"
msgstr "Ви сильні! Сильні, як Вольфґанґ!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_COACH.6
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_COACH.6"
msgid "Believe in yourself, like Wolfgang believes in you!"
msgstr "Вірте у себе так, як Вольфґанґ вірить у вас!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_COACH.7
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_COACH.7"
msgid "Good job! Burning feeling in muscles means you're doing it right!"
msgstr "Гарна робота! Якщо вам пече у м'язах, значить, ви все робите правильно!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_COACH.8
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_COACH.8"
msgid "Do not give up!"
msgstr "Не здаватися!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_COACH.9
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_COACH.9"
msgid "Yes! You can do it!"
msgstr "Так! Ви все зможете!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_COLD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_COLD"
msgid "Brrrrrrr! Is frosty!"
msgstr "Бр-р-р-р-р-р-р! Холодно!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_COMPASS_OUT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_COMPASS_OUT"
msgid "Little needle broke off!"
msgstr "Стрілочка зламалася!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_COZY_SLEEP
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_COZY_SLEEP"
msgid "Wolfgang had nice dreams of fluffy bunnies."
msgstr "Вольфґанґові снилися гарненькі пухнасті кролики."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CRAFTING_FAIL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_CRAFTING_FAIL"
msgid "I need to gather more things to make that."
msgstr "Мені потрібно зібрати більше всячини, аби майструвати."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_DAMP
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_DAMP"
msgid "Water time."
msgstr "Час водички."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_DEERCLOPS"
msgid "Sound like big strong man coming."
msgstr "Звук, наче наближається великий сильний чолов'яга."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_DESPAWN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_DESPAWN"
msgid "Wolfgang is scared!"
msgstr "Вольфґанґ наляканий!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_DETACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_DETACH_BUFF_ATTACK"
msgid "Wolfgang still strong! Just little less strong!"
msgstr "Вольфґанґ усе ще сильний! Просто трохи менш сильний!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK"
msgid "Lightning magic gone."
msgstr "Магія блискавки зникла."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY"
msgid "Feels damp... Wolfgang hope not to catch cold."
msgstr "Почуваюся мокрим... Вольфґанґ має надію, що не застудиться."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION"
