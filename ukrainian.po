msgstr "Незабутній трофей на згадку про незабутню битву."

#. STRINGS.RECIPE_DESC.CHESSPIECE_EYEOFTERROR_BUILDER
msgctxt "STRINGS.RECIPE_DESC.CHESSPIECE_EYEOFTERROR_BUILDER"
