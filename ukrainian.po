msgstr "ДЯКУЮ... ТОБІ, КОЗЕНЯ."

#. STRINGS.QUAGMIRE_ELDER_TALK_GREETING.1
msgctxt "STRINGS.QUAGMIRE_ELDER_TALK_GREETING.1"
msgid "HRF? YOU TRADE? SUPPLIES?"
msgstr "ХРЮ? ТИ ТОРГУВАТИ? ПРИПАСИ?"

#. STRINGS.QUAGMIRE_ELDER_TALK_GREETING.2
msgctxt "STRINGS.QUAGMIRE_ELDER_TALK_GREETING.2"
msgid "HRF? SLEEP... GIVE ELDER NIGHTMARES"
msgstr "ХРЮ? СПАВ... СТАРІЙШИНА БАЧИВ КОШМАРИ"

#. STRINGS.QUAGMIRE_ELDER_TALK_GREETING.3
msgctxt "STRINGS.QUAGMIRE_ELDER_TALK_GREETING.3"
msgid "HRF! OUR HOMES DESTROYED"
msgstr "ХРЮ! НАШІ БУДИНКИ ЗНИЩЕНО"

#. STRINGS.QUAGMIRE_ELDER_TALK_GREETING.4
msgctxt "STRINGS.QUAGMIRE_ELDER_TALK_GREETING.4"
msgid "HRF! GNAW MAD AT PIGS"
msgstr "ХРЮ! ГЛОД ГНІВАЄТЬСЯ НА СВИНЕЙ"

#. STRINGS.QUAGMIRE_ELDER_TALK_GREETING.5
msgctxt "STRINGS.QUAGMIRE_ELDER_TALK_GREETING.5"
msgid "HRF! MOST GOATS NO HELP TO PIGS"
msgstr "ХРЮ! БАГАТО КІЗ НЕ ПОМАГАТИ СВИНЯМ"

#. STRINGS.QUAGMIRE_ELDER_TALK_GREETING.6
msgctxt "STRINGS.QUAGMIRE_ELDER_TALK_GREETING.6"
msgid "HRF! WE NEED FIX HOUSES"
msgstr "ХРЮ! НАМ ТРЕБА ПОЛАГОДИТИ БУДИНКИ"

#. STRINGS.QUAGMIRE_ELDER_TALK_GREETING.7
msgctxt "STRINGS.QUAGMIRE_ELDER_TALK_GREETING.7"
msgid "HRF? ...WHAT LITTLE PIGS DO IF ELDER GONE?"
msgstr "ХРЮ?.. ЯК БУТИ МАЛИМ СВИНЯМ, КОЛИ СТАРІЙШИНИ НЕ СТАНЕ?"

