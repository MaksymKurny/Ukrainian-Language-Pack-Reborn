msgstr "Він потрапив під гарячу руку."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_DRAGONSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_DRAGONSHRINE.EMPTY"
