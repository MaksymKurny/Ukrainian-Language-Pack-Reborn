#. STRINGS.SHADOWTHRALL_PARASITE_CHANT.6
msgctxt "STRINGS.SHADOWTHRALL_PARASITE_CHANT.6"
msgid "benevolent"
msgstr "великодушна"

#. STRINGS.SHADOWTHRALL_PARASITE_CHANT.7
msgctxt "STRINGS.SHADOWTHRALL_PARASITE_CHANT.7"
