msgstr "Вольфґанґові варто поділитися із малими, слабшими друзями."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ELIXIR_BOOSTED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ELIXIR_BOOSTED"
msgid "Very nice!"
msgstr "Дуже добре!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ELIXIR_GHOSTVISION
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ELIXIR_GHOSTVISION"
msgid "Wolfgang is brave. Wolfgang is brave."
msgstr "Вольфґанґ хоробрий. Вольфґанґ хоробрий."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ELIXIR_PLAYER_SPEED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ELIXIR_PLAYER_SPEED"
msgid "Super Wolfgang!"
msgstr "Супер Вольфґанґ!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ELIXIR_TOO_SUPER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ELIXIR_TOO_SUPER"
msgid "Yuck! No, too much."
msgstr "Бе-е! Ні, занадто."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ENCUMBERED.1
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ENCUMBERED.1"
msgid "Is good... for muscles..."
msgstr "Корисно... для м'язів..."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ENCUMBERED.10
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ENCUMBERED.10"
