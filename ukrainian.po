msgctxt "STRINGS.CHARACTERS.WANDA.ANNOUNCE_EAT.SAME_OLD_1"
msgid "only_used_by_warly"
msgstr "only_used_by_warly"

#. STRINGS.CHARACTERS.WANDA.ANNOUNCE_EAT.SAME_OLD_2
msgctxt "STRINGS.CHARACTERS.WANDA.ANNOUNCE_EAT.SAME_OLD_2"
