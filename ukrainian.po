msgstr "Все згоріло!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC"
