msgstr "Покажіть каменюкам, хто тут головний."

#. STRINGS.RECIPE_DESC.GOLDENPITCHFORK
msgctxt "STRINGS.RECIPE_DESC.GOLDENPITCHFORK"
msgid "Rearrange the whole world."
msgstr "Змінюйте світ на свій смак."

#. STRINGS.RECIPE_DESC.GOLDENSHOVEL
msgctxt "STRINGS.RECIPE_DESC.GOLDENSHOVEL"
msgid "Lasts longer, digs the same stuff."
msgstr "Копає як звичайна, проте служитиме довше."

#. STRINGS.RECIPE_DESC.GOLDEN_FARM_HOE
msgctxt "STRINGS.RECIPE_DESC.GOLDEN_FARM_HOE"
msgid "Elegantly till soil for crop seeds."
msgstr "Елегантно обробляйте ґрунт під посів культур."

#. STRINGS.RECIPE_DESC.GRASS_UMBRELLA
msgctxt "STRINGS.RECIPE_DESC.GRASS_UMBRELLA"
msgid "Posh & portable protection."
msgstr "Чудовий портативний захист."

#. STRINGS.RECIPE_DESC.GRAVEURN
msgctxt "STRINGS.RECIPE_DESC.GRAVEURN"
msgid "Transport a soul to a new location."
msgstr "Переносьте душу в нове місце."

#. STRINGS.RECIPE_DESC.GREENAMULET
msgctxt "STRINGS.RECIPE_DESC.GREENAMULET"
msgid "Craft with a discount!"
msgstr "Майструйте зі знижкою!"

#. STRINGS.RECIPE_DESC.GREENSTAFF
msgctxt "STRINGS.RECIPE_DESC.GREENSTAFF"
msgid "Clean and efficient destruction."
msgstr "Чисте та ефективне руйнування."

#. STRINGS.RECIPE_DESC.GREEN_MUSHROOMHAT
msgctxt "STRINGS.RECIPE_DESC.GREEN_MUSHROOMHAT"
msgid "It's like eating all kinds of mushrooms."
msgstr "Гриб — усьому голова."

#. STRINGS.RECIPE_DESC.GUNPOWDER
msgctxt "STRINGS.RECIPE_DESC.GUNPOWDER"
msgid "A handful of gunpowder."
msgstr "Жменя пороху."

#. STRINGS.RECIPE_DESC.HALLOWEEN_EXPERIMENT_BRAVERY
msgctxt "STRINGS.RECIPE_DESC.HALLOWEEN_EXPERIMENT_BRAVERY"
msgid "Liquid courage."
msgstr "Хоробрість у пляшці."

#. STRINGS.RECIPE_DESC.HALLOWEEN_EXPERIMENT_HEALTH
msgctxt "STRINGS.RECIPE_DESC.HALLOWEEN_EXPERIMENT_HEALTH"
msgid "Good for your heart."
msgstr "Корисний для серця."

#. STRINGS.RECIPE_DESC.HALLOWEEN_EXPERIMENT_MOON
msgctxt "STRINGS.RECIPE_DESC.HALLOWEEN_EXPERIMENT_MOON"
msgid "There's a change brewing."
msgstr "Насуваються зміни."

#. STRINGS.RECIPE_DESC.HALLOWEEN_EXPERIMENT_ROOT
msgctxt "STRINGS.RECIPE_DESC.HALLOWEEN_EXPERIMENT_ROOT"
msgid "Spine-chilling saplings."
msgstr "Паростки, від яких мурашки бігають по спині."

#. STRINGS.RECIPE_DESC.HALLOWEEN_EXPERIMENT_SANITY
msgctxt "STRINGS.RECIPE_DESC.HALLOWEEN_EXPERIMENT_SANITY"
msgid "Put your mind at ease."
msgstr "Заспокойте свій розум."

#. STRINGS.RECIPE_DESC.HALLOWEEN_EXPERIMENT_VOLATILE
msgctxt "STRINGS.RECIPE_DESC.HALLOWEEN_EXPERIMENT_VOLATILE"
msgid "Crystallized incandescence."
msgstr "Кристалізований жар."

#. STRINGS.RECIPE_DESC.HAMBAT
msgctxt "STRINGS.RECIPE_DESC.HAMBAT"
msgid "It takes food to make food."
msgstr "Щоб добути їжу, треба мати їжу."

#. STRINGS.RECIPE_DESC.HAMMER
msgctxt "STRINGS.RECIPE_DESC.HAMMER"
msgid "Smashes all kinds of things."
msgstr "Розбиває будь-що."

#. STRINGS.RECIPE_DESC.HANDPILLOW_BEEFALOWOOL
msgctxt "STRINGS.RECIPE_DESC.HANDPILLOW_BEEFALOWOOL"
msgid "It packs a woolly wallop!"
msgstr "Мішок шерстяних стусанів!"

#. STRINGS.RECIPE_DESC.HANDPILLOW_KELP
msgctxt "STRINGS.RECIPE_DESC.HANDPILLOW_KELP"
msgid "Nobody likes a wet blanket. Wet pillows aren't much better."
msgstr "Мокра подушка допоможе вийти сухим із битви."

#. STRINGS.RECIPE_DESC.HANDPILLOW_PETALS
msgctxt "STRINGS.RECIPE_DESC.HANDPILLOW_PETALS"
msgid "A pillow packed with flower power."
msgstr "Подушка, набита силою квітів."

#. STRINGS.RECIPE_DESC.HANDPILLOW_STEELWOOL
msgctxt "STRINGS.RECIPE_DESC.HANDPILLOW_STEELWOOL"
msgid "For folks who take their pillow fighting seriously."
msgstr "Для тих, хто хоче битися подушками по-справжньому."

#. STRINGS.RECIPE_DESC.HAWAIIANSHIRT
msgctxt "STRINGS.RECIPE_DESC.HAWAIIANSHIRT"
msgid "Fun in the sun. Or on Casual Fridays."
msgstr "Для прогулянок на сонці або повсякденних п'ятниць."

#. STRINGS.RECIPE_DESC.HEALINGSALVE
msgctxt "STRINGS.RECIPE_DESC.HEALINGSALVE"
msgid "Disinfectant for cuts and abrasions."
msgstr "Антисептик для порізів і саден."

#. STRINGS.RECIPE_DESC.HEALINGSALVE_ACID
msgctxt "STRINGS.RECIPE_DESC.HEALINGSALVE_ACID"
msgid "What doesn't kill you makes you stronger."
msgstr "Те, що нас не вбиває, робить нас сильнішими."

#. STRINGS.RECIPE_DESC.HEALINGSALVE_FUMAROLE
msgctxt "STRINGS.RECIPE_DESC.HEALINGSALVE_FUMAROLE"
msgid "Smear on some heat protection."
msgstr "Бальзам не тільки для душі, а й від спеки."

#. STRINGS.RECIPE_DESC.HEATROCK
msgctxt "STRINGS.RECIPE_DESC.HEATROCK"
msgid "Stores thermals for travel."
msgstr "Збереже температуру в дорогу."

#. STRINGS.RECIPE_DESC.HERMITCRABTEA_FIRENETTLES
msgctxt "STRINGS.RECIPE_DESC.HERMITCRABTEA_FIRENETTLES"
msgid "It'll put some fire in your belly, or at least warm you up."
msgstr "Через нього може початися печія, проте хоча б зігріє."

#. STRINGS.RECIPE_DESC.HERMITCRABTEA_FOLIAGE
msgctxt "STRINGS.RECIPE_DESC.HERMITCRABTEA_FOLIAGE"
msgid "Fortify your faculties against mind-cracking creatures."
msgstr "Зміцніть свою здатність протидіяти істотам, від яких утрачається глузд."

#. STRINGS.RECIPE_DESC.HERMITCRABTEA_FORGETMELOTS
msgctxt "STRINGS.RECIPE_DESC.HERMITCRABTEA_FORGETMELOTS"
msgid "A strong brew to refresh your fractured mind."
msgstr "Міцний напій, що допоможе привести думки до ладу."

#. STRINGS.RECIPE_DESC.HERMITCRABTEA_MOON_TREE_BLOSSOM
msgctxt "STRINGS.RECIPE_DESC.HERMITCRABTEA_MOON_TREE_BLOSSOM"
msgid "Blend in with the lunar locals."
msgstr "Порозумійтеся з місячними місцевими."

#. STRINGS.RECIPE_DESC.HERMITCRABTEA_PETALS
msgctxt "STRINGS.RECIPE_DESC.HERMITCRABTEA_PETALS"
msgid "A brew to bring a mind back from the brink."
msgstr "Напій, що допоможе повернути ясність розумові."

#. STRINGS.RECIPE_DESC.HERMITCRABTEA_PETALS_EVIL
msgctxt "STRINGS.RECIPE_DESC.HERMITCRABTEA_PETALS_EVIL"
msgid "Sip for a gentle slip into madness."
msgstr "Одного ковтка достатньо, щоб м'яко поринути в божевілля."

#. STRINGS.RECIPE_DESC.HERMITCRABTEA_SUCCULENT_PICKED
msgctxt "STRINGS.RECIPE_DESC.HERMITCRABTEA_SUCCULENT_PICKED"
msgid "Drink this if you wanna be cool."
msgstr "Випийте, якщо забажаєте охолодити серце."

#. STRINGS.RECIPE_DESC.HERMITCRABTEA_TILLWEED
msgctxt "STRINGS.RECIPE_DESC.HERMITCRABTEA_TILLWEED"
msgid "It even tastes healthy! Yum!"
msgstr "На смак — сама користь! Ням!"

#. STRINGS.RECIPE_DESC.HERMITCRAB_LIGHTPOST
msgctxt "STRINGS.RECIPE_DESC.HERMITCRAB_LIGHTPOST"
msgid "Set the mood for a seaside sanctuary!"
msgstr "Створіть атмосферу морського курорту!"

#. STRINGS.RECIPE_DESC.HERMITCRAB_RELOCATION_KIT
msgctxt "STRINGS.RECIPE_DESC.HERMITCRAB_RELOCATION_KIT"
msgid "Home is where the hermit is... relocated."
msgstr "Дім — це там, куди тебе... переселили."

#. STRINGS.RECIPE_DESC.HERMITCRAB_SHELL
msgctxt "STRINGS.RECIPE_DESC.HERMITCRAB_SHELL"
msgid "Last one to Pearl's is a rotten fish egg!"
msgstr "Хто останній до Перлинки — той гнила голова риби!"

#. STRINGS.RECIPE_DESC.HERMITCRAB_TEASHOP
msgctxt "STRINGS.RECIPE_DESC.HERMITCRAB_TEASHOP"
msgid "There's nothing a cup of Pearl's tea can't fix."
msgstr "Немає нічого, що не могла б виправити чашка чаю Перлинки."

#. STRINGS.RECIPE_DESC.HERMITHOTSPRING_CONSTR
msgctxt "STRINGS.RECIPE_DESC.HERMITHOTSPRING_CONSTR"
msgid "Drop in for a soak at Pearl's coastal retreat."
msgstr "Завітайте до прибережного курорту Перлинки, щоби попаритися."

#. STRINGS.RECIPE_DESC.HERMITHOUSE_ORNAMENT
msgctxt "STRINGS.RECIPE_DESC.HERMITHOUSE_ORNAMENT"
msgid "Give Pearl's Place a splash of whimsy with some oceanside adornments."
msgstr "Додайте оселі Перлинки краплину вигадливості за допомогою морських прикрас."

#. STRINGS.RECIPE_DESC.HERMIT_BUNDLE_SHELLS
msgctxt "STRINGS.RECIPE_DESC.HERMIT_BUNDLE_SHELLS"
msgid "The shells she sells."
msgstr "Мила мала мушлі, мушлі мила мала."

#. STRINGS.RECIPE_DESC.HERMIT_CHAIR_ROCKING
msgctxt "STRINGS.RECIPE_DESC.HERMIT_CHAIR_ROCKING"
msgid "Have a seat, you'll be drifting away in no time."
msgstr "Колись корч гойдався на хвилях, тепер гойдатиметеся ви."

#. STRINGS.RECIPE_DESC.HOMESIGN
msgctxt "STRINGS.RECIPE_DESC.HOMESIGN"
msgid "Make your mark upon the world."
msgstr "Залиште слід у цьому світі."

#. STRINGS.RECIPE_DESC.HOUNDSTOOTH_BLOWPIPE
msgctxt "STRINGS.RECIPE_DESC.HOUNDSTOOTH_BLOWPIPE"
msgid "Like biting, but from a distance."
msgstr "Кусається, але на віддалі."

#. STRINGS.RECIPE_DESC.HOUNDWHISTLE
msgctxt "STRINGS.RECIPE_DESC.HOUNDWHISTLE"
msgid "Blow the whistle on wild hounds."
msgstr "Хто сказав, що свист віщує тільки нещастя?"

#. STRINGS.RECIPE_DESC.ICEBOX
msgctxt "STRINGS.RECIPE_DESC.ICEBOX"
msgid "Slows food spoilage."
msgstr "Сповільнює псування їжі."

#. STRINGS.RECIPE_DESC.ICEHAT
msgctxt "STRINGS.RECIPE_DESC.ICEHAT"
msgid "Science, on the rocks."
msgstr "Наука в кубі."

#. STRINGS.RECIPE_DESC.ICEPACK
msgctxt "STRINGS.RECIPE_DESC.ICEPACK"
msgid "Keeps stuff fresh."
msgstr "Зберігає речі свіжими."

#. STRINGS.RECIPE_DESC.ICESTAFF
msgctxt "STRINGS.RECIPE_DESC.ICESTAFF"
msgid "Freeze enemies in their tracks."
msgstr "Заморозьте ворогів на місці."

#. STRINGS.RECIPE_DESC.ICESTAFF2
msgctxt "STRINGS.RECIPE_DESC.ICESTAFF2"
msgid "Knock'em out cold!"
msgstr "Наженіть на ворогів холоду!"

#. STRINGS.RECIPE_DESC.ICESTAFF3
msgctxt "STRINGS.RECIPE_DESC.ICESTAFF3"
msgid "Put'em on ice!"
msgstr "Обдавайте всіх морозом!"

#. STRINGS.RECIPE_DESC.INSPECTACLESHAT
msgctxt "STRINGS.RECIPE_DESC.INSPECTACLESHAT"
msgid "Get on the same wavelength as your old boss."
msgstr "Будьте на одній довжині хвилі з вашим підстаркуватим шефом."

#. STRINGS.RECIPE_DESC.IPECACSYRUP
msgctxt "STRINGS.RECIPE_DESC.IPECACSYRUP"
msgid "Keeps you regular."
msgstr "Не тримайте все в собі."

#. STRINGS.RECIPE_DESC.KELPHAT
msgctxt "STRINGS.RECIPE_DESC.KELPHAT"
msgid "Something to agitate the nerves."
msgstr "Розбурхує нерви."

#. STRINGS.RECIPE_DESC.KITCOONDECOR1_KIT
msgctxt "STRINGS.RECIPE_DESC.KITCOONDECOR1_KIT"
msgid "Feathered fun for feline friends."
msgstr "Перната забавка для котячих друзів."

#. STRINGS.RECIPE_DESC.KITCOONDECOR2_KIT
msgctxt "STRINGS.RECIPE_DESC.KITCOONDECOR2_KIT"
msgid "A delightful exercise in futility."
msgstr "Чудовий спосіб змарнувати час за дурницями."

#. STRINGS.RECIPE_DESC.KITCOONDEN_KIT
msgctxt "STRINGS.RECIPE_DESC.KITCOONDEN_KIT"
msgid "A home for kitcoons of all stripes."
msgstr "Дім для єнотокошенят усіх мастей."

#. STRINGS.RECIPE_DESC.KITCOON_NAMETAG
msgctxt "STRINGS.RECIPE_DESC.KITCOON_NAMETAG"
msgid "Put a name to a cute little face."
msgstr "Дайте ім'я милій мордочці."

#. STRINGS.RECIPE_DESC.LANTERN
msgctxt "STRINGS.RECIPE_DESC.LANTERN"
msgid "Refuelable, bright, portable!"
msgstr "Яскравий, портативний, можна заправляти!"

#. STRINGS.RECIPE_DESC.LEIF_IDOL
msgctxt "STRINGS.RECIPE_DESC.LEIF_IDOL"
msgid "Call upon the power of the trees."
msgstr "Викличте силу дерев."

#. STRINGS.RECIPE_DESC.LIFEINJECTOR
msgctxt "STRINGS.RECIPE_DESC.LIFEINJECTOR"
msgid "Boosts your declining max health."
msgstr "Повертає втрачене максимальне здоров'я."

#. STRINGS.RECIPE_DESC.LIGHTER
msgctxt "STRINGS.RECIPE_DESC.LIGHTER"
msgid "Burns through the night and in the rain."
msgstr "Не згасне ні в ніч, ні в дощ."

#. STRINGS.RECIPE_DESC.LIGHTNING_ROD
msgctxt "STRINGS.RECIPE_DESC.LIGHTNING_ROD"
msgid "Protection from strikes."
msgstr "Захист від ураження блискавкою."

#. STRINGS.RECIPE_DESC.LIVINGLOG
msgctxt "STRINGS.RECIPE_DESC.LIVINGLOG"
msgid "Put yourself into your work."
msgstr "Віддайте роботі крихітку себе."

#. STRINGS.RECIPE_DESC.LUNARPLANTHAT
msgctxt "STRINGS.RECIPE_DESC.LUNARPLANTHAT"
msgid "Luminescent protection for your precious cranium."
msgstr "Люмінесцентний захист для дорогоцінного черепа."

#. STRINGS.RECIPE_DESC.LUNARPLANT_KIT
msgctxt "STRINGS.RECIPE_DESC.LUNARPLANT_KIT"
msgid "Fix up damaged equipment."
msgstr "Лагодьте пошкоджене спорядження."

#. STRINGS.RECIPE_DESC.LUNAR_FORGE_KIT
msgctxt "STRINGS.RECIPE_DESC.LUNAR_FORGE_KIT"
msgid "Forge otherworldly items."
msgstr "Виковуйте неземні предмети."

#. STRINGS.RECIPE_DESC.MADSCIENCE_LAB
msgctxt "STRINGS.RECIPE_DESC.MADSCIENCE_LAB"
msgid "Mad science has no limits. Except sanity."
msgstr "Божевільна наука не знає меж. Окрім меж здорового глузду."

#. STRINGS.RECIPE_DESC.MAGICIAN_CHEST
msgctxt "STRINGS.RECIPE_DESC.MAGICIAN_CHEST"
msgid "Imprison your belongings in a shadowy vortex."
msgstr "Замкніть свої пожитки у тіньовому вирі."

#. STRINGS.RECIPE_DESC.MALBATROSS_FEATHERED_WEAVE
msgctxt "STRINGS.RECIPE_DESC.MALBATROSS_FEATHERED_WEAVE"
msgid "A fine feathered fabric."
msgstr "Чудова тканина з пір'я."

#. STRINGS.RECIPE_DESC.MAPSCROLL
msgctxt "STRINGS.RECIPE_DESC.MAPSCROLL"
msgid "Show everyone what you've seen!"
msgstr "Покажіть усім, що ви бачили!"

#. STRINGS.RECIPE_DESC.MARBLEBEAN
msgctxt "STRINGS.RECIPE_DESC.MARBLEBEAN"
msgid "Grow a marble forest."
msgstr "Виростіть мармуровий ліс."

#. STRINGS.RECIPE_DESC.MAST
msgctxt "STRINGS.RECIPE_DESC.MAST"
msgid "Sail away, sail away."
msgstr "Пливіть, пливіть далеко."

#. STRINGS.RECIPE_DESC.MASTUPGRADE_LAMP_ITEM
msgctxt "STRINGS.RECIPE_DESC.MASTUPGRADE_LAMP_ITEM"
msgid "An illuminating mast attachment."
msgstr "Освітлювальний прилад, що кріпиться на щоглу."

#. STRINGS.RECIPE_DESC.MASTUPGRADE_LAMP_ITEM_YOTD
msgctxt "STRINGS.RECIPE_DESC.MASTUPGRADE_LAMP_ITEM_YOTD"
msgid "Light your way with dragon fire."
msgstr "Освітіть собі шлях вогнем дракона."

#. STRINGS.RECIPE_DESC.MASTUPGRADE_LIGHTNINGROD_ITEM
msgctxt "STRINGS.RECIPE_DESC.MASTUPGRADE_LIGHTNINGROD_ITEM"
msgid "An electrifying addition to your mast."
msgstr "Електровідвідний прилад, що кріпиться на щоглу."

#. STRINGS.RECIPE_DESC.MAST_ITEM
msgctxt "STRINGS.RECIPE_DESC.MAST_ITEM"
msgid "Sail away, sail away."
msgstr "Пливіть, пливіть далеко."

#. STRINGS.RECIPE_DESC.MAST_MALBATROSS
msgctxt "STRINGS.RECIPE_DESC.MAST_MALBATROSS"
msgid "Sail like a seabird into the blue."
msgstr "Несіться над водою, неначе морський птах у далечінь."

#. STRINGS.RECIPE_DESC.MAST_MALBATROSS_ITEM
msgctxt "STRINGS.RECIPE_DESC.MAST_MALBATROSS_ITEM"
msgid "Sail like a seabird into the blue."
msgstr "Несіться над водою, неначе морський птах у далечінь."

#. STRINGS.RECIPE_DESC.MAST_YOTD_ITEM
msgctxt "STRINGS.RECIPE_DESC.MAST_YOTD_ITEM"
msgid "No Dragonflies were harmed in the making of this mast."
msgstr "Під час виготовлення цієї щогли жодна дракономуха не постраждала."

#. STRINGS.RECIPE_DESC.MEATRACK
msgctxt "STRINGS.RECIPE_DESC.MEATRACK"
msgid "The jerkiest of racks."
msgstr "Найв'яліша у світі в'ялка."

#. STRINGS.RECIPE_DESC.MEATRACK_HERMIT_MULTI
msgctxt "STRINGS.RECIPE_DESC.MEATRACK_HERMIT_MULTI"
msgid "Pearl's personal drying rack has room to spare!"
msgstr "На особистій в'ялці Перлинки знайдеться вдосталь місця!"

#. STRINGS.RECIPE_DESC.MEGAFLARE
msgctxt "STRINGS.RECIPE_DESC.MEGAFLARE"
msgid "Light a beacon for your enemies."
msgstr "Дайте знати ворогам, де ви є."

#. STRINGS.RECIPE_DESC.MERMHAT
msgctxt "STRINGS.RECIPE_DESC.MERMHAT"
msgid "Merm-ify your friends."
msgstr "Замермізуйте своїх друзів."

#. STRINGS.RECIPE_DESC.MERMHOUSE_CRAFTED
msgctxt "STRINGS.RECIPE_DESC.MERMHOUSE_CRAFTED"
msgid "A home fit for a Merm."
msgstr "Підхожий дім для мерма."

#. STRINGS.RECIPE_DESC.MERMTHRONE_CONSTRUCTION
msgctxt "STRINGS.RECIPE_DESC.MERMTHRONE_CONSTRUCTION"
msgid "Usher in a new Merm Monarchy."
msgstr "Започаткуйте нову монархію мермів."

#. STRINGS.RECIPE_DESC.MERMWATCHTOWER
msgctxt "STRINGS.RECIPE_DESC.MERMWATCHTOWER"
msgid "True warriors live within."
msgstr "Всередині житимуть справжні воїни."

#. STRINGS.RECIPE_DESC.MERM_ARMORY
msgctxt "STRINGS.RECIPE_DESC.MERM_ARMORY"
msgid "No merm should charge into battle without a well-fitting helmet."
msgstr "Жодному мерму не слід кидатися в бій без належного шолома."

#. STRINGS.RECIPE_DESC.MERM_ARMORY_UPGRADED
msgctxt "STRINGS.RECIPE_DESC.MERM_ARMORY_UPGRADED"
msgid "For merms with discerning taste in combat headgear."
msgstr "Для мермів, що знаються на бойових головних уборах."

#. STRINGS.RECIPE_DESC.MERM_TOOLSHED
msgctxt "STRINGS.RECIPE_DESC.MERM_TOOLSHED"
msgid "A merm is only as good as their tools."
msgstr "Без сокири не тесляр — без інструмента не мерм."

#. STRINGS.RECIPE_DESC.MERM_TOOLSHED_UPGRADED
msgctxt "STRINGS.RECIPE_DESC.MERM_TOOLSHED_UPGRADED"
msgid "The best workmermship demands the best tools."
msgstr "Найліпші ремермсники потребують найліпших інструментів."

#. STRINGS.RECIPE_DESC.MESSAGEBOTTLEEMPTY
msgctxt "STRINGS.RECIPE_DESC.MESSAGEBOTTLEEMPTY"
msgid "Not just made by hermits!"
msgstr "Їх роблять не лише відлюдники!"

#. STRINGS.RECIPE_DESC.MIGHTY_GYM
msgctxt "STRINGS.RECIPE_DESC.MIGHTY_GYM"
msgid "Bring on the brawn!"
msgstr "Нарощуйте м'язи!"

#. STRINGS.RECIPE_DESC.MINERHAT
msgctxt "STRINGS.RECIPE_DESC.MINERHAT"
msgid "Light up the night with your noggin."
msgstr "Розвійте темряву своєю макітрою."

#. STRINGS.RECIPE_DESC.MINIBOATLANTERN
msgctxt "STRINGS.RECIPE_DESC.MINIBOATLANTERN"
msgid "It flickers with a warm glow."
msgstr "Від нього лине тепле світло."

#. STRINGS.RECIPE_DESC.MINIFAN
msgctxt "STRINGS.RECIPE_DESC.MINIFAN"
msgid "You have to run to create a breeze!"
msgstr "Треба побігати, аби відчути вітерець!"

#. STRINGS.RECIPE_DESC.MINIFLARE
msgctxt "STRINGS.RECIPE_DESC.MINIFLARE"
msgid "Light the way for your trusted friends."
msgstr "Дайте знати вірним друзям, де ви є."

#. STRINGS.RECIPE_DESC.MINISIGN_ITEM
msgctxt "STRINGS.RECIPE_DESC.MINISIGN_ITEM"
msgid "Draw on these with a Feather Pencil."
msgstr "Малюйте на ній пір'яним олівцем."

#. STRINGS.RECIPE_DESC.MOLEHAT
msgctxt "STRINGS.RECIPE_DESC.MOLEHAT"
msgid "Grants the wearer Smell-E-Vision."
msgstr "Погляньте на світ нюхом крота."

#. STRINGS.RECIPE_DESC.MOONBUTTERFLY
msgctxt "STRINGS.RECIPE_DESC.MOONBUTTERFLY"
msgid "Help them relive their glory."
msgstr "Допоможіть їм пережити свою славу."

#. STRINGS.RECIPE_DESC.MOONDIAL
msgctxt "STRINGS.RECIPE_DESC.MOONDIAL"
msgid "Track the phases of the moon!"
msgstr "Відстежуйте фази місяця!"

#. STRINGS.RECIPE_DESC.MOONGLASS
msgctxt "STRINGS.RECIPE_DESC.MOONGLASS"
msgid "A fragment from the Moon."
msgstr "Шматок місяця."

#. STRINGS.RECIPE_DESC.MOONGLASSAXE
msgctxt "STRINGS.RECIPE_DESC.MOONGLASSAXE"
msgid "Fragile but effective."
