#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOT_HANDLE_VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOT_HANDLE_VOIDCLOTH"
msgid "The young scout doth come into his own."
msgstr "Юний розвідник розкриває свій потенціал."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURPER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURPER"
msgid "The fur foe thinks she's a hat!"
msgstr "Хутряний супротивник думає, що він — шапка!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURPERPELT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURPERPELT"
msgid "I do love furs."
msgstr "Мені до вподоби хутра."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURPER_PELT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURPER_PELT"
msgid "I do love furs."
msgstr "Мені до вподоби хутра."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLE"
msgid "You are an angel. Of nasty."
msgstr "Ти янгол. Бридкості."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLEHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLEHAT"
msgid "A fine battle helm!"
msgstr "Славний бойовий шолом!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLEHOLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLEHOLE"
msgid "Not where I'd choose to hang my helm."
msgstr "Я б не повісила на нього свій шолом."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLESLIME
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLESLIME"
msgid "Yes. Slime."
msgstr "Так. Слиз."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLE_SHELLPIECES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLURTLE_SHELLPIECES"
msgid "They're smashed up good."
msgstr "Його добряче побило."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLBIRD.GENERIC"
msgid "You are not fierce yet, bird."
msgstr "Тобі ще бракує запеклості, птахо."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLBIRD.HUNGRY"
msgid "You must eat to grow strong."
msgstr "Ти маєш їсти, щоб рости сильним."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLBIRD.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLBIRD.SLEEPING"
msgid "Rest now, young one."
msgstr "Спочивай, юначе."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLBIRD.STARVING"
msgid "The small bird looks famished."
msgstr "Маленька птаха виглядає змореною."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLGHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLGHOST"
msgid "Such a wee specter!"
msgstr "Такий крихітний привид!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLMEAT"
msgid "A nice meaty snack."
msgstr "Добра м'ясна закуска."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SMALLMEAT_DRIED"
msgid "A small provision for a long campaign."
msgstr "Невеликий провіант для довгого походу."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SNAPPER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SNAPPER"
msgid "I shall best you, foe!"
msgstr "Я переможу тебе, супротивнику!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SNOWBALL_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SNOWBALL_ITEM"
msgid "I do love a snow skirmish."
msgstr "Мені до вподоби сніжна баталія."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SNOWMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SNOWMAN.GENERIC"
msgid "A fine tribute to the Jotnar."
msgstr "Добра данина йотунам."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SNOWMAN.SNOWBALL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SNOWMAN.SNOWBALL"
msgid "Not quite."
msgstr "Ще не готовий."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SNURTLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SNURTLE"
msgid "I like his helmet."
msgstr "Мені до смаку її шолом."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SOIL_AMENDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SOIL_AMENDER.GENERIC"
msgid "A weak brew for the non-meats."
msgstr "Слабке вариво для нем'яса."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SOIL_AMENDER.SPOILED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SOIL_AMENDER.SPOILED"
msgid "By the gods, the stench!"
msgstr "О боги, що за сморід!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SOIL_AMENDER.STALE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SOIL_AMENDER.STALE"
msgid "It's beginning to take on a powerful odor."
msgstr "Вона набуває потужного смороду."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SOIL_AMENDER_FERMENTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SOIL_AMENDER_FERMENTED"
msgid "Perhaps the non-meats are stronger that I thought, to consume such a thing..."
msgstr "Можливо, нем'ясо сильніше, ніж я гадала, якщо воно споживає таке..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPAT"
msgid "How much meat is hiding under there?"
msgstr "Як багато м'яса у ній криється?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPEAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPEAR"
msgid "That is not my favored spear, but it will do the trick."
msgstr "Не мій улюблений спис, та свою справу зробить."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPEAR_GUNGNIR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPEAR_GUNGNIR"
msgid "The weapon of a brazen Valkyrie!"
msgstr "Зброя зухвалої валькірії!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPEAR_LANCE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPEAR_LANCE"
msgid "Tis a divine spear!"
msgstr "Се дивовижний спис!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPEAR_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPEAR_WATHGRITHR"
msgid "My comrade in arms!"
msgstr "Мій бойовий побратим!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPEAR_WATHGRITHR_LIGHTNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPEAR_WATHGRITHR_LIGHTNING"
msgid "The power of Thor courses through it."
msgstr "Сила Тора плине крізь нього."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPICEPACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPICEPACK"
msgid "I'll use this to carry delicious meats!"
msgstr "Я носитиму в ній смачне м'ясо!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPICE_CHILI
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPICE_CHILI"
msgid "Full of a fiery extract."
msgstr "Повні огненного екстракту."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPICE_GARLIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPICE_GARLIC"
msgid "Its pungent smell offends mine nostrils."
msgstr "Його їдкий запах разить мої ніздрі."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPICE_SALT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPICE_SALT"
msgid "It has the briny taste of the sea."
msgstr "Вона має солоний смак моря."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPICE_SUGAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPICE_SUGAR"
msgid "The sweet juice of an enemy."
msgstr "Солодкий сік ворога."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER.DEAD"
msgid "Cut down in battle, like so many before it."
msgstr "Поліг у битві, як і багато інших до нього."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER.GENERIC"
msgid "Eight legs and still no match for me!"
msgstr "Вісім лап, та все ще не рівня мені!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER.SLEEPING"
msgid "I will give it a fair fight by waiting til it awakes."
msgstr "Я дарую йому чесну битву, зачекавши, поки він прокинеться."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERCORPSE.BURNING"
msgid "A mediocre offering to the gods."
msgstr "Убога жертва богам."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERCORPSE.GENERIC"
msgid "And it shall not be the last dead spider."
msgstr "Се не останній павук, що згине од нашої руки."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERCORPSE.REVIVING"
msgid "Curses!"
msgstr "Прокляття!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERDEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERDEN"
msgid "Crush them at the source!"
msgstr "Розчавім їх у зародку!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERDEN_BEDAZZLER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERDEN_BEDAZZLER"
msgid "The spiderchild has taken up the arts, has he?"
msgstr "Схоже, дитя-павук зайняло себе мистецтвом."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDEREGGSACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDEREGGSACK"
msgid "Squashing these would be a waste of future battles."
msgstr "Я змарную стільки битв, якщо їх розчавлю."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERGLAND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERGLAND"
msgid "Ripped from the abdomen of a slain spider."
msgstr "Вирвана із чрева вбитого павука."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERHAT"
msgid "A perfect way to infiltrate the enemy camp."
msgstr "Найкращий спосіб проникнути у табір ворога."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERHOLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERHOLE"
msgid "Webbing. Never a good sign."
msgstr "Павутиння. Завжди поганий знак."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERHOLE_ROCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERHOLE_ROCK"
msgid "Webbing. Never a good sign."
msgstr "Павутиння. Завжди поганий знак."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERQUEEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERQUEEN"
msgid "Finally, a true test of my abilities."
msgstr "Нарешті справжнє випробування моїх здібностей."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERQUEENCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERQUEENCORPSE.BURNING"
msgid "May you be honored in your burning."
msgstr "Нехай полум'я вшанує тебе гідно."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERQUEENCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERQUEENCORPSE.GENERIC"
msgid "Here lieth a worthy foe."
msgstr "Тут спочиває гідний супротивник."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERQUEENCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDERQUEENCORPSE.REVIVING"
msgid "Rest was your right, not this accursed waking."
msgstr "Спочинок був твоїм за правом, та не се прокляте життя."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_DROPPER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_DROPPER"
msgid "You are so sneaky!"
msgstr "Ти такий підступний!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_HEALER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_HEALER"
msgid "Be you the healer of your clan?"
msgstr "Ти є цілителем свого клану?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_HEALER_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_HEALER_ITEM"
msgid "It is only fit for the small toothy beasts."
msgstr "Він годиться хіба що малим гострозубим звірюкам."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_HIDER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_HIDER"
msgid "I'll smash you!"
msgstr "Я розчавлю тебе!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_MOON.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_MOON.DEAD"
msgid "It has breathed its last."
msgstr "Він випустив дух."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_MOON.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_MOON.GENERIC"
msgid "One of Hel's beasts, surely!"
msgstr "Безумовно, один зі звірів Гель!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_MOON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_MOON.SLEEPING"
msgid "It slumbers."
msgstr "Він спочиває."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_REPELLENT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_REPELLENT"
msgid "The spiderchild uses it to manage his horde."
msgstr "Завдяки йому дитя-павук верховодить своєю ватагою."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_SPITTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_SPITTER"
msgid "That one's feisty."
msgstr "Він норовливий."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_WARRIOR.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_WARRIOR.DEAD"
msgid "Victory once again!"
msgstr "І знову перемога!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_WARRIOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_WARRIOR.GENERIC"
msgid "The champion of the spiders. To battle!"
msgstr "Чемпіон серед павуків. До бою!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_WARRIOR.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_WARRIOR.SLEEPING"
msgid "It is cowardly to attack a sleeping enemy."
msgstr "Це боягузство — нападати на ворога, що спить."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_WATER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_WATER"
msgid "Have at thee, water walkers!"
msgstr "Ось вам, водяні ходаки!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_WHISTLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPIDER_WHISTLE"
msgid "'Tis a spider war horn."
msgstr "Се бойова сурма павуків."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPOILED_FISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPOILED_FISH.GENERIC"
msgid "You smell of your failure."
msgstr "Од тебе йде смердючий відгомін поразки."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPOILED_FOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPOILED_FOOD.GENERIC"
msgid "Age has only made this food gross, not wise."
msgstr "Од віку їжа ця стала лиш бридкішою, а не мудрішою."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_MEDIUM.GENERIC"
msgid "At peace, benevolent flame spirit."
msgstr "Мир тобі, доброчинний огненний духу."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_MEDIUM.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_MEDIUM.HELD"
msgid "I'll direct this light where I please."
msgstr "Я скерую це світло, куди забажаю."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_MOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_MOON"
msgid "It carries an explosive power..."
msgstr "Вона містить вибухову силу..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_SMALL.GENERIC"
msgid "At peace, benevolent forest spirit."
msgstr "Мир тобі, доброчинний лісовий духу."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_SMALL.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_SMALL.HELD"
msgid "I'll direct this light where I please."
msgstr "Я скерую це світло, куди забажаю."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_TALL.GENERIC"
msgid "At peace, benevolent river spirit."
msgstr "Мир тобі, доброчинний річковий духу."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_TALL.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SPORE_TALL.HELD"
msgid "I'll direct this light where I please."
msgstr "Я скерую це світло, куди забажаю."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SQUID
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SQUID"
msgid "It lights my voyage through murky waters."
msgstr "Він осяює мій шлях крізь темні води."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAFFCOLDLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAFFCOLDLIGHT"
msgid "Frigid as a frost giant's heart."
msgstr "Крижане, наче серце морозного велета."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAFFLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAFFLIGHT"
msgid "Behold! A gift from Wotan!"
msgstr "Гляньте! Дарунок од Вотана!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAFF_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAFF_LUNARPLANT"
msgid "To attack from afar is not my preferred way of combat."
msgstr "Не волію здалеку нападати — такі битви мені не до вподоби."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAFF_TORNADO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAFF_TORNADO"
msgid "A storm of pain."
msgstr "Буря болю."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAGEHAND.AWAKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAGEHAND.AWAKE"
msgid "Keep thy hand from out mine fires!"
msgstr "Забери свої руки од мого огню!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAGEHAND.HIDING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAGEHAND.HIDING"
msgid "Merely a table."
msgstr "Всього лиш стіл."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAGEUSHER.SITTING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAGEUSHER.SITTING"
msgid "Merely a table."
msgstr "Всього лиш стіл."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAGEUSHER.STANDING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STAGEUSHER.STANDING"
msgid "Keep thy hand from out mine fires!"
msgstr "Забери свої руки од мого огню!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALAGMITE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALAGMITE"
msgid "Cave boulder."
msgstr "Печерна брила."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALAGMITE_TALL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALAGMITE_TALL"
msgid "A pointy rock of sorts."
msgstr "Якийсь гострий камінь."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALKER"
msgid "It lives to battle once more!"
msgstr "Він живе, аби битись знов!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALKER_ATRIUM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALKER_ATRIUM"
msgid "Tis no mindless beast!"
msgstr "Се не безглуздий звір!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALKER_MINION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALKER_MINION"
msgid "A fiend woven from the night!"
msgstr "Біс, витканий із ночі!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALKER_NPC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STALKER_NPC"
msgid "The enemy of my enemy is my ally."
msgstr "Ворог мого ворога — мій союзник."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STASH_MAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STASH_MAP"
msgid "We journey to find the hidden plunder!"
msgstr "Ми мандруватимемо, щоб знайти заховану здобич!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUEGLOMMER.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUEGLOMMER.EMPTY"
msgid "That wasn't very respectful."
msgstr "Це було не дуже шанобливо."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUEGLOMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUEGLOMMER.GENERIC"
msgid "A curious homage to the gods."
msgstr "Дивна данина богам."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUEHARP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUEHARP"
msgid "It must be Gunnar. The snakes took his head."
msgstr "Певно, це Ґуннар. Змії одтяли йому голову."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUEHARP_HEDGESPAWNER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUEHARP_HEDGESPAWNER"
msgid "'Tis surrounded by a thorny thicket."
msgstr "Ся охоплена колючим чагарником."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUEMAXWELL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUEMAXWELL"
msgid "The villain turns hero!"
msgstr "Лиходій став героєм!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUE_MARBLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUE_MARBLE.GENERIC"
msgid "Delicate appearance, but hard as stone. Admirable."
msgstr "Витончений вигляд, але міцна, наче камінь. Чарівно."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUE_MARBLE.TYPE1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUE_MARBLE.TYPE1"
msgid "What plagues you, fair maiden?"
msgstr "Яка пошесть гризе тебе, прекрасна діво?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUE_MARBLE.TYPE2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUE_MARBLE.TYPE2"
msgid "A sturdy little warrior."
msgstr "Міцний маленький воїн."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUE_MARBLE.TYPE3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STATUE_MARBLE.TYPE3"
msgid "Tis a stone basin!"
msgstr "Се кам'яна ваза!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STEELWOOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STEELWOOL"
msgid "It could easily best regular wool in combat."
msgstr "Вона з легкістю перевершить у бою звичайну вовну."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STEERINGWHEEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STEERINGWHEEL"
msgid "Njord guide our journey."
msgstr "Ньйорд веде нашу подорож."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STEERINGWHEEL_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STEERINGWHEEL_ITEM"
msgid "A vital piece of a glorious vessel."
msgstr "Вкрай необхідна частина славетного судна."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STINGER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STINGER"
msgid "The sword on the back of a bee."
msgstr "Із заду бджоли стирчав меч."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STONE_CHAIR.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STONE_CHAIR.GENERIC"
msgid "A warrior doth not sit."
msgstr "Воїтелька не сидить на місці."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STONE_CHAIR.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STONE_CHAIR.OCCUPIED"
msgid "On your feet, soldier!"
msgstr "Підводься, бійцю!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STONE_TABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STONE_TABLE.GENERIC"
msgid "No sorrier sight than a bare table. Let us plunder!"
msgstr "Немає жалюгіднішого видовища, ніж порожній стіл. Час для походу!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STONE_TABLE.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STONE_TABLE.HAS_ITEM"
msgid "Not the most impressive piece of loot."
msgstr "Не найбільш приголомшлива здобич."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STORAGE_ROBOT.BROKEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STORAGE_ROBOT.BROKEN"
msgid "We must never forget our fallen comrades."
msgstr "Нам ніколи не слід забувати наших полеглих побратимів."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STORAGE_ROBOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STORAGE_ROBOT.GENERIC"
msgid "Go forth to gather the spoils of war."
msgstr "Іди, збирай трофеї війни."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STRAWHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STRAWHAT"
msgid "A hat for cooling after a raucous battle."
msgstr "Капелюх, щоб охолонути після запеклої битви."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STUFFEDEGGPLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STUFFEDEGGPLANT"
msgid "Filling the vegetable does not make it meat."
msgstr "Фарширування овочу не робить його м'ясом."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STUFFING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.STUFFING"
msgid "It bears the scent of meat. I will sample a morsel."
msgstr "Вона пахне м'ясом. Я покуштую кавалок."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUCCULENT_PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUCCULENT_PICKED"
msgid "Tis not foodstuff."
msgstr "Се не їжа."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUCCULENT_PICKED_DRIED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUCCULENT_PICKED_DRIED"
msgid "T'would make a most worthy offering to the gods!"
msgstr "Сей був би найдостойнішим підношенням богам!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUCCULENT_PLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUCCULENT_PLANT"
msgid "Hearty greenery."
msgstr "Дужа зелень."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUCCULENT_POTTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUCCULENT_POTTED"
msgid "A feast for mine eyes!"
msgstr "Бенкет для моїх очей!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUNKENCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUNKENCHEST.GENERIC"
msgid "Perhaps it was a gift from Venus?"
msgstr "Можливо, це був дарунок од Венери?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUNKENCHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUNKENCHEST.LOCKED"
msgid "Fie! Locked tight!"
msgstr "Тьху! Міцно замкнена!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUPERTACKLECONTAINER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUPERTACKLECONTAINER"
msgid "A bounty of space for my bait!"
msgstr "Море місця для моєї наживки!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUPPORT_PILLAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUPPORT_PILLAR"
msgid "This noble pillar hath withstood much for our sakes."
msgstr "Ця благородна колона витримала багато заради нас."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUPPORT_PILLAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUPPORT_PILLAR_BROKEN"
msgid "We shall rebuild!"
msgstr "Ми одбудуємо!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUPPORT_PILLAR_COMPLETE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUPPORT_PILLAR_COMPLETE"
msgid "A glorious monument to our resilience!"
msgstr "Славетний монумент нашій стійкості!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUPPORT_PILLAR_DREADSTONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUPPORT_PILLAR_DREADSTONE"
msgid "This noble pillar hath withstood much for our sakes."
msgstr "Ця благородна колона витримала багато заради нас."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_BROKEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_BROKEN"
msgid "How the mighty have fallen."
msgstr "Як же пали сильні світу цього."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_COMPLETE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_COMPLETE"
msgid "'Twould withstand Ragnarok."
msgstr "Ся витримає Раґнарок."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_SCAFFOLD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_SCAFFOLD"
msgid "The building hath commenced!"
msgstr "Початок будівництва покладено!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUPPORT_PILLAR_SCAFFOLD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SUPPORT_PILLAR_SCAFFOLD"
msgid "The building hath commenced!"
msgstr "Початок будівництва покладено!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SURFNTURF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SURFNTURF"
msgid "Nothing goes better with meat than more meat!"
msgstr "Ніщо не пасує до м'яса краще, ніж більше м'яса!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SWEATERVEST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SWEATERVEST"
msgid "It is a handsome vest, but it offers no protection."
msgstr "Ладний жилет, проте зовсім не захистить."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SWEETPOTATO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SWEETPOTATO"
msgid "Marshmallows on meat... tis an odd choice, but somehow delicious!"
msgstr "М'ясо, вкрите зефіром... се дивний вибір, проте смачно!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SWEETTEA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SWEETTEA"
msgid "A warrior does not partake in \"tea time\"."
msgstr "Воїтелька не бере участі в «чаюванні»."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SWORD_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SWORD_LUNARPLANT"
msgid "Am I worthy of wielding a weapon of such brilliance?"
msgstr "Чи гідна я носити зброю такого блиску?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TABLE_WINTERS_FEAST.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TABLE_WINTERS_FEAST.BURNT"
msgid "It's been consumed by fire."
msgstr "Він був поглинутий огнем."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TABLE_WINTERS_FEAST.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TABLE_WINTERS_FEAST.GENERIC"
msgid "A feast table worthy of Valhalla!"
msgstr "Бенкетний стіл, гідний Вальгалли!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TABLE_WINTERS_FEAST.HAS_FOOD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TABLE_WINTERS_FEAST.HAS_FOOD"
msgid "A feast fit for The Great Hall!"
msgstr "Бенкет, гідний Великої Зали!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TABLE_WINTERS_FEAST.WRONG_TYPE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TABLE_WINTERS_FEAST.WRONG_TYPE"
msgid "It is not worthy of a place here."
msgstr "Це не гідне місця на ньому."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TACKLECONTAINER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TACKLECONTAINER"
msgid "A wise hunter treats their tools with care."
msgstr "Мудрий мисливець завжди дбає про свої знаряддя."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TACKLESKETCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TACKLESKETCH"
msgid "This scroll bears hidden secrets of fishing!"
msgstr "Сувій, що містить приховані секрети риболовлі!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TACKLESTATION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TACKLESTATION"
msgid "I shall create a fishing weapon like no other!"
msgstr "Я створю рибальську зброю, якій не буде рівних!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TAFFY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TAFFY"
msgid "Long will the saga of this taffy be told."
msgstr "Сага цих ірисок триватиме ще довго."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRD"
msgid "A fearsome bird! But I am not afraid."
msgstr "Грізний птах! Проте я не жахаюсь."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG"
msgid "It will grow into a formidable foe."
msgstr "З нього виросте жасний супротивник."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_COOKED"
msgid "It was you or me, bird."
msgstr "Або ти, або я, птахо."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.COLD"
msgid "This egg would not survive a Norse winter."
msgstr "Це яйце не пережило б скандинавської зими."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC"
msgid "Fight your way out, bird!"
msgstr "Пробий свій шлях назовні, птахо!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.HOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.HOT"
msgid "Borne of flame! Unless it cooks to death."
msgstr "Дитя огню! Якщо тільки воно не звариться живцем."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.LONG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.LONG"
msgid "A time remains before this bird is to be born."
msgstr "Ще є час до народження цього птаха."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT"
msgid "It will soon wake to this world."
msgstr "Невдовзі він прокинеться в цьому світі."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDNEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDNEST.GENERIC"
msgid "A feathered warrior lurks inside."
msgstr "Пернатий воїн чигає всередині."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDNEST.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLBIRDNEST.PICKED"
msgid "A young bird of war will soon be born."
msgstr "Юний птах війни невдовзі народиться."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLEGGS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TALLEGGS"
msgid "A fine warrior's breakfast!"
msgstr "Добрий сніданок воїтельки!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TAMALES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TAMALES"
msgid "Oh ho! This bready wrap hides a morsel of spiced meat!"
msgstr "Отакої! Хлібний згорток ховає в собі кавалок пряного м'яса!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TEENBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TEENBIRD.GENERIC"
msgid "You are not yet ready for battle, bird."
msgstr "Ти ще не готова до бою, птахо."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TEENBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TEENBIRD.HUNGRY"
msgid "I hope you like vegetables... the meat is for me."
msgstr "Сподіваюся, ти любиш овочі... М'ясо — мені."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TEENBIRD.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TEENBIRD.SLEEPING"
msgid "It's gathering its strength."
msgstr "Він набирається сил."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TEENBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TEENBIRD.STARVING"
msgid "To enter battle with me is your choice, bird."
msgstr "Вступити в бій зі мною — це твій вибір, птахо."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEBASE.GEMS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEBASE.GEMS"
msgid "It requires purple gems."
msgstr "Йому потрібні фіолетові самоцвіти."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEBASE.VALID
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEBASE.VALID"
msgid "It will harness my awesome speed."
msgstr "Він приборкає мою неймовірну швидкість."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BASE.ACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BASE.ACTIVE"
msgid "To Asgard!"
msgstr "До Асґарду!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BASE.GENERIC"
msgid "A bridge to another world."
msgstr "Міст до іншого світу."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BASE.LOCKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BASE.LOCKED"
msgid "The bridge is unstable yet."
msgstr "Міст іще не стійкий."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BASE.PARTIAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BASE.PARTIAL"
msgid "The bridge is incomplete."
msgstr "Міст незавершений."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BOX
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_BOX"
msgid "Perhaps it holds the secret to this land's Bifrost."
msgstr "Можливо, саме в ній ховається секрет Біфроста цих земель."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_CRANK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_CRANK"
msgid "A sturdy crank."
msgstr "Міцний важіль."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_POTATO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_POTATO"
msgid "No decency. It's not even metal meat."
msgstr "Негідно. Це навіть не металеве м'ясо."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_RING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELEPORTATO_RING"
msgid "It appears to be similar to the Bifrost."
msgstr "Воно чимось схоже на Біфрост."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELESTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TELESTAFF"
msgid "Ride through the air and the sea!"
msgstr "Подорож крізь повітря й море!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENT.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENT.BURNT"
msgid "It has been razed."
msgstr "Його зруйновано вщент."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENT.GENERIC"
msgid "Sleep this night, and prepare for battle on the morrow."
msgstr "Я спатиму цієї ночі й набиратимусь сил для битви на світанні."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE"
msgid "It looks fierce. Into the fray!"
msgstr "Його вигляд нестерпний. До бою!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLESPIKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLESPIKE"
msgid "Gooey, but dangerous. I like it."
msgstr "Липкий, проте згубливий. Мені до вподоби."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLESPOTS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLESPOTS"
msgid "A tough hide."
msgstr "Жорстка шкура."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE_GARDEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE_GARDEN"
msgid "I will thrust my spear into that mass of tentacles!"
msgstr "Я встромлю свій спис прямо в цю купу мацаків!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE_PILLAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE_PILLAR"
msgid "A towering tentacled foe."
msgstr "Височезний супротивник із мацаками."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE_PILLAR_ARM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE_PILLAR_ARM"
msgid "A gross, grasping appendage."
msgstr "Бридкий, чіпкий одросток."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE_PILLAR_HOLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TENTACLE_PILLAR_HOLE"
msgid "The lair of my tallest foe!"
msgstr "Лігво мого найвищого супротивника!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TERRARIUM.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TERRARIUM.COOLDOWN"
msgid "The Bifrost is sealed, but for how long?"
msgstr "Біфрост запечатаний, та чи надовго?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TERRARIUM.CRIMSON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TERRARIUM.CRIMSON"
msgid "Something foul hath taken hold..."
msgstr "Тепер ним керує щось нечисте..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TERRARIUM.ENABLED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TERRARIUM.ENABLED"
msgid "Behold! The glory of the Bifrost!!"
msgstr "Гляньте! Слава Біфростові!!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TERRARIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TERRARIUM.GENERIC"
msgid "I can feel the Bifrost's warmth from inside it!"
msgstr "Я одчуваю тепло Біфроста всередині!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TERRARIUM.SPAWN_DISABLED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TERRARIUM.SPAWN_DISABLED"
msgid "The monster shall not terrorize this realm again!"
msgstr "Страховище не жахатиме цей світ знову!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TERRARIUM.WAITING_FOR_DARK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TERRARIUM.WAITING_FOR_DARK"
msgid "Something draws near..."
msgstr "Щось наближається..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TERRARIUMCHEST.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TERRARIUMCHEST.BURNT"
msgid "Consumed by flames."
msgstr "Поглинута полум'ям."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TERRARIUMCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TERRARIUMCHEST.GENERIC"
msgid "T'would be a fine place to keep my weapons."
msgstr "Се було б чудове місце, де можна зберігати мою зброю."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TERRARIUMCHEST.SHIMMER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TERRARIUMCHEST.SHIMMER"
msgid "Doth my eyes deceive me? The chest casts jagged light!"
msgstr "Чи не дурять мене мої очі? Зі скрині лине нерівне світло!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.THULECITE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.THULECITE"
msgid "This material possesses gargantuan strength!"
msgstr "Матеріал, одержимий колосальною силою!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.THULECITEBUGNET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.THULECITEBUGNET"
msgid "Not even the smallest of prey shall escape."
msgstr "Навіть найдрібніша здобич не втече."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.THULECITE_PIECES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.THULECITE_PIECES"
msgid "Looks like shiny popped corn."
msgstr "Вони схожі на блискучий попкорн."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.THURIBLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.THURIBLE"
msgid "Tis Loki's frost giant lure."
msgstr "Се приманка Локі на морозних велетів."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TICOON.ABANDONED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TICOON.ABANDONED"
msgid "Curses! We will commence this hunt without your assistance."
msgstr "Прокляття! Ми полюватимемо без твоєї помочі."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TICOON.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TICOON.GENERIC"
msgid "A mighty beast worthy of his crown. He will lead us to victory!"
msgstr "Могутній звір, гідний своєї корони. Він поведе нас до перемоги!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TICOON.LOST_TRACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TICOON.LOST_TRACK"
msgid "We were not swift enough."
msgstr "Ми були недостатньо прудкими."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TICOON.NEARBY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TICOON.NEARBY"
msgid "Do you sense the presence of a wee beast around here?"
msgstr "Ти одчуваєш присутність крихітного звіра?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TICOON.NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TICOON.NOTHING_TO_TRACK"
msgid "Seems there's no beasties to be found."
msgstr "Схоже, тут немає жодних бестій."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TICOON.SUCCESS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TICOON.SUCCESS"
msgid "Glory to you, mighty beast!"
msgstr "Слава тобі, могутній звіре!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TICOON.TARGET_TOO_FAR_AWAY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TICOON.TARGET_TOO_FAR_AWAY"
msgid "They must be too far for him to catch the scent."
msgstr "Вони певно задалеко, щоб він міг уловити їхній запах."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TICOON.TRACKING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TICOON.TRACKING"
msgid "He's on the case!"
msgstr "Він узяв слід!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TICOON.TRACKING_NOT_MINE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TICOON.TRACKING_NOT_MINE"
msgid "He's on another's case!"
msgstr "Він шукає не для мене!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TILLWEED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TILLWEED"
msgid "Remove yourself from my sight, cowardly weed!"
msgstr "Щезни з моїх очей, легкодухий бур'яне!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TILLWEEDSALVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TILLWEEDSALVE"
msgid "Hmm, it doth appear that foul weed has a use after all."
msgstr "Гм-м, схоже, од бридкого бур'яну все ж є якась користь."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TILLWEED_DRIED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TILLWEED_DRIED"
msgid "T'would make a most worthy offering to the gods!"
msgstr "Сей був би найдостойнішим підношенням богам!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL.GENERIC"
msgid "Ha! Finally, a worthy foe!"
msgstr "Ха! Нарешті гідний суперник!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL.RAGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL.RAGE"
msgid "Give me your best shot, I'll not hold back!"
msgstr "Покажи, на що здатна! Я не одступлю!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL_CAP.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL_CAP.EMPTY"
msgid "A cleft in the earth."
msgstr "Розкол у землі."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL_CAP.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL_CAP.GENERIC"
msgid "You will bend to my blade, toadstool!"
msgstr "Ти не встоїш перед моїм клинком, поганко!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL_CAP.INGROUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOADSTOOL_CAP.INGROUND"
msgid "Something emerges!"
msgstr "Щось з'явилось!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOMATO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOMATO"
msgid "It will not pass my lips!"
msgstr "Він не торкнеться моїх уст!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOMATO_COOKED"
msgid "It boasts reddest guts, yet 'tis not meat!"
msgstr "Він може похвалитись найчервонішими нутрощами, але се все ще не м'ясо!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOMATO_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOMATO_OVERSIZED"
msgid "It's only good for throwing."
msgstr "Воно гоже хіба щоб ним кидатись."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOMATO_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "Се жменя насіння, для нем'яса."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOPHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOPHAT"
msgid "It doesn't match my costume."
msgstr "Він не личить до мого вбрання."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOPHAT_MAGICIAN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOPHAT_MAGICIAN"
msgid "It hath been touched by dark magic."
msgstr "Його торкнулась темна магія."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TORCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TORCH"
msgid "Perfect for a nighttime assault."
msgstr "Ідеальний для нічної атаки."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOURTIERE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOURTIERE"
msgid "Pie hath redeemed itself!"
msgstr "Пиріг став гідним, щоб його з'їсти!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOWNPORTAL.ACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOWNPORTAL.ACTIVE"
msgid "By the power of the sand!"
msgstr "Силою піску!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOWNPORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOWNPORTAL.GENERIC"
msgid "To save my allies the journey."
msgstr "Щоб мої союзники не марнували час на подорож."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE"
msgid "I shall desert this foul place!"
msgstr "Я покину це нечисте місце!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOWNPORTALTALISMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TOWNPORTALTALISMAN.GENERIC"
msgid "A present from the mighty lion!"
msgstr "Дарунок од могутнього лева!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAILMIX
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAILMIX"
msgid "Meat of the nut is not true meat."
msgstr "М'ясисті горіхи — це все ще не м'ясо."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAILS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAILS"
msgid "Let us battle with honor!"
msgstr "Биймося із честю!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRANSISTOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRANSISTOR"
msgid "A marvel of science."
msgstr "Диво науки."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP"
msgid "A well constructed trap. Tonight we feast!"
msgstr "Добре зроблена пастка. Бенкетуватимемо увечері!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_BRAMBLE"
msgid "A most clever trap for one's foes."
msgstr "Найкмітливіша пастка для його ворогів."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_FUMAROLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_FUMAROLE.GENERIC"
msgid "Its flame is spent."
msgstr "Їхнє полум'я згасло."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_FUMAROLE.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_FUMAROLE.HELD"
msgid "A warrior is always prepared."
msgstr "Воїтелька завжди напоготові."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_FUMAROLE.HOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_FUMAROLE.HOT"
msgid "Woe to the toes of all who pursue me!"
msgstr "Лихо тим ногам, що гнатимуться за мною!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_FUMAROLE.WARM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_FUMAROLE.WARM"
msgid "My enemies shall regret crossing me... or crossing that."
msgstr "Мої вороги пожалкують, що стали у мене на шляху... або стали на них."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_STARFISH.CLOSED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_STARFISH.CLOSED"
msgid "I shalln't be vanquished that easily."
msgstr "Мене так просто не перемогти."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_STARFISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_STARFISH.GENERIC"
msgid "My warrior's instinct sounds - but why!"
msgstr "Мій інстинкт воїтельки не дає мені спокою... Але чому?!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_TEETH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_TEETH"
msgid "A treacherous trap."
msgstr "Підступна пастка."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_TEETH_MAXWELL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRAP_TEETH_MAXWELL"
msgid "An excellent mace wasted, buried in the ground."
msgstr "Чудова булава змарнована, похована в землі."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREASURECHEST.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREASURECHEST.BURNT"
msgid "Its walls were torn down by fire."
msgstr "Огонь розірвав її стінки на частини."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREASURECHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREASURECHEST.GENERIC"
msgid "A place to store my helm and spear whilst I rest."
msgstr "Місце, щоб зберігати мій шолом і спис, поки я спочиваю."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREASURECHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREASURECHEST.UPGRADED_STACKSIZE"
msgid "Enough room to store an entire armory!"
msgstr "Достатньо місця, щоб зберігати цілу зброярню!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREASURECHEST_TRAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREASURECHEST_TRAP"
msgid "I am always ready."
msgstr "Я завжди напоготові."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREECLUMP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREECLUMP"
msgid "A dead end! I must stand and fight."
msgstr "Глухий кут! Я маю стати й битися."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREEGROWTHSOLUTION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREEGROWTHSOLUTION"
msgid "An offering to the trees, may they carry it on to great Yggdrasil itself."
msgstr "Підношення деревам. Нехай вони донесуть його до самого Іґґдрасілля."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREE_ROCK.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREE_ROCK.BURNING"
msgid "The flames doth devour the noble sapling! Aye, its final saga draws to a close."
msgstr "Полум'я пожирає сей знатний паросток! Гай-гай, близько кінець його саги."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREE_ROCK.CHOPPED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREE_ROCK.CHOPPED"
msgid "Now, the spoils like ripe for the taking."
msgstr "Ось вони, трофеї. Так і просяться до рук."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREE_ROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREE_ROCK.GENERIC"
msgid "This stout sapling be a mighty champion indeed, bearin' aloft a boulder fit to crush lesser foes!"
msgstr "Сей міцний паросток — далебі могутній чемпіон! Він здіймає брилу, що здатна розчавити ницих ворогів!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREE_ROCK_SAPLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREE_ROCK_SAPLING"
msgid "A greenling that may be of some worth, or so the tale goes."
msgstr "Якщо вірити переказам, це деревце ще може нам придатись."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREE_ROCK_SEED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TREE_ROCK_SEED"
msgid "'Tis said this humble seed holds mighty potential."
msgstr "Подейкують, що на сю простеньку насінину чекає велична будучина."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRIDENT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRIDENT"
msgid "I shall lay waste to my enemies with the weapon of Poseidon!"
msgstr "Я знищу своїх ворогів зброєю Посейдона!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_1"
msgid "Toys do not interest a great warrior such as I."
msgstr "Іграшки не цікавлять таких величних воїтельок, як я."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_10
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_10"
msgid "A token of victory."
msgstr "Трофей на згадку про перемогу."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_11
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_11"
msgid "A warrior encased in armor. I'm told its name is \"Hal.\""
msgstr "Воїн, закутий в обладунки. Мені сказали, що ймення його «Гал»."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_12
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_12"
msgid "Remnants of Ms. Wicker's summons? Truly a fierce woman."
msgstr "Останки істот, прикликаних пані Вікер? Далебі безжальна жінка."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_13
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_13"
msgid "A small, peculiar woman."
msgstr "Неабияка маленька пані."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_14
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_14"
msgid "Tea is a luxury that warriors cannot afford."
msgstr "Чай — це розкіш, яку воїтелька не може собі дозволити."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_15
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_15"
msgid "A noble fighter."
msgstr "Шляхетний боєць."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_16
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_16"
msgid "A noble fighter."
msgstr "Шляхетний боєць."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_17
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_17"
msgid "A poor weapon."
msgstr "Вбога зброя."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_18
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_18"
msgid "I must mentor the young one in battle strategy."
msgstr "Я маю навчати молодечу бойовій стратегії."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_19
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_19"
msgid "A useless toy."
msgstr "Непотрібна іграшка."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_2"
msgid "Accompaniment for my ballad of triumphs."
msgstr "Акомпанемент до моїх тріумфальних балад."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_20
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_20"
msgid "Finally, a safe weapon with which to spar with my new allies."
msgstr "Нарешті безпечна зброя, щоб тренуватись із моїми новими союзниками."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_21
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_21"
msgid "Cooking utensils do not interest me."
msgstr "Кухонне приладдя мене не цікавить."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_22
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_22"
msgid "It won't stand up to the rigors of battle."
msgstr "Вона не витримає тягот бою."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_23
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_23"
msgid "Not as useful as a battle horn."
msgstr "Не настільки корисний, як бойовий ріг."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_24
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_24"
msgid "Grant me luck on the battlefield!"
msgstr "Даруй мені удачі на полі бою!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_25
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_25"
msgid "Perhaps the stench will drive the enemy away."
msgstr "Можливо, смородом можна буде одігнати ворога."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_26
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_26"
msgid "My allies will appreciate the survival training I've bestowed."
msgstr "Мої союзники будуть вдячні за проведене мною навчання з виживання."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_27
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_27"
msgid "This weak, flimsy wire reminds me... I must toughen Maxwell up!"
msgstr "Цей кволий, нетривкий дріт нагадує мені... Я маю загартувати Максвелла!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_28
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_28"
msgid "Even the feeble can wage mighty battle upon the board."
msgstr "Навіть кволі можуть вести запеклі битви за шахівницею."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_29
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_29"
msgid "Even the feeble can wage mighty battle upon the board."
msgstr "Навіть кволі можуть вести запеклі битви за шахівницею."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_3"
msgid "Even my spear cannot undo this knot."
msgstr "Навіть мій спис не може розв'язати цей вузол."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_30
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_30"
msgid "Tis not a unicorn."
msgstr "Се не єдиноріг."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_31
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_31"
msgid "Tis not a unicorn."
msgstr "Се не єдиноріг."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_32
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_32"
msgid "Reveal mine destiny, oh great fates!"
msgstr "Розкрийте мою долю, о, величні провидці!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_33
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_33"
msgid "The creature has been forever imprisoned upon the ring."
msgstr "Істота була навічно прикута до цього персня."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_34
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_34"
msgid "Begone, foul magic!"
msgstr "Згинь, нечиста магіє!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_35
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_35"
msgid "'Twas a poison, most assuredly."
msgstr "Безперечно, се була отрута."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_36
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_36"
msgid "Evidence of the undead. Stay wary, my allies!"
msgstr "Докази існування нечисті. Будьте обачними, союзники!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_37
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_37"
msgid "For warding off Loki's minions."
msgstr "Щоб одганяти поплічників Локі."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_38
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_38"
msgid "There is a tiny world trapped within!"
msgstr "Там усередині ув'язнено крихітний світ!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_39
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_39"
msgid "To arms! The gauntlet has been thrown down!"
msgstr "До зброї! Рукавичку кинуто!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_4"
msgid "A small, peculiar man."
msgstr "Неабиякий маленький пан."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_40
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_40"
msgid "I have no use for such things."
msgstr "Я не маю потреби в них."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_41
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_41"
msgid "Perhaps some sort of elixir lies within?"
msgstr "Можливо, всередині якийсь еліксир?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_42
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_42"
msgid "Tis no foe worthy of I."
msgstr "Се не ворог, що гідний мене."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_43
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_43"
msgid "What manner of creature be this?"
msgstr "Що це за істота така?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_44
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_44"
msgid "It has fallen in battle."
msgstr "Він зліг у бою."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_45
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_45"
msgid "What stories might you tell, trapped spirit?"
msgstr "Які історії ти розповіси, запроторений духу?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_46
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_46"
msgid "Tis a suspicious contraption!"
msgstr "Се підозріла штукенція!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_5
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_5"
msgid "Will it take me to Asgard?"
msgstr "Ти донесеш мене до Асґарду?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_6
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_6"
msgid "Useless technology."
msgstr "Марні технології."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_7
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_7"
msgid "No time for games! I must train my new allies!"
msgstr "Немає часу на ігри! Я маю тренувати моїх нових союзників!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_8
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_8"
msgid "It would make an okay weapon in a pinch."
msgstr "Згодиться для бою, коли під рукою не буде іншої зброї."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_9
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRINKET_9"
msgid "No decent armor could be made with these."
msgstr "З них не зробиш жодної порядної броні."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_FISH.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_FISH.BURNING"
msgid "By the gods, that fishbowl's ablaze!"
msgstr "О боги, акваріум в огні!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_FISH.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_FISH.BURNT"
msgid "Tis naught but cinders."
msgstr "Се ніщо інше, як попіл."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_FISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_FISH.GENERIC"
msgid "I will stand victorious!"
msgstr "Я здобуду перемогу!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM"
msgid "Weight: {weight}\nCaught by: {owner}"
msgstr "Вага: {weight}\nЗловлено: {owner}"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM_HEAVY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM_HEAVY"
msgid "Weight: {weight}\nCaught by: {owner}\nA most glorious catch indeed!"
msgstr "Вага: {weight}\nЗловлено: {owner}\nДалебі найславетніший улов!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_FISH.OWNER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_FISH.OWNER"
msgid "Weight: {weight}\nCaught by: {owner}\nTake heed of my fishing prowess!"
msgstr "Вага: {weight}\nЗловлено: {owner}\nДивіться всі, як майстерна я у риболовлі!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY"
msgid "Weight: {weight}\nCaught by: {owner}\n'Twas nothing for a skilled hunter!"
msgstr "Вага: {weight}\nЗловлено: {owner}\nСе було надто просто для вправної мисливиці!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNING"
msgid "It hath been set ablaze!"
msgstr "Їх охопило полум'я!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNT"
msgid "'Twas of little use anyway."
msgstr "Од них усе одно було небагато користі."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.GENERIC"
msgid "Vile veggies! Bring out the best among you to be judged!"
msgstr "Мерзенні овочі! Приведіть сюди найкращих із вас на оцінку!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM"
msgid "Weight: {weight}\nHarvested on day: {day}\nI care not."
msgstr "Вага: {weight}\nЗібрано в день: {day}\nМені до того байдуже."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_HEAVY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_HEAVY"
msgid "Weight: {weight}\nHarvested on day: {day}\n'Tis vile, but robust."
msgstr "Вага: {weight}\nЗібрано в день: {day}\nСе мерзенне, проте здоровенне."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_LIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_LIGHT"
msgid "Ha! The machine does not even deem it worthy enough to reveal its weight!"
msgstr "Ха! Машина навіть не вважає його досить гідним, аби показувати вагу!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNKVEST_SUMMER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNKVEST_SUMMER"
msgid "It will not suffice in the frozen wastes."
msgstr "Його буде замало для крижаної пустки."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNKVEST_WINTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNKVEST_WINTER"
msgid "The warm pelt of a bested creature. A fine garment."
msgstr "Тепла шкура переможеної істоти. Чудова одежина."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNK_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNK_COOKED"
msgid "A juicy reward after a hard battle."
msgstr "Соковита нагорода після важкої битви."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNK_SUMMER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNK_SUMMER"
msgid "A powerful trunk of a fallen not-so-hairy beast."
msgstr "Масивний хобот полеглого не дуже-то й волохатого звіра."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNK_WINTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TRUNK_WINTER"
msgid "A powerful trunk of a fallen hairy beast."
msgstr "Масивний хобот полеглого волохатого звіра."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TUMBLEWEED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TUMBLEWEED"
msgid "Flee, bouncing coward!"
msgstr "Тікай, стрибучий легкодуху!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURFCRAFTINGSTATION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURFCRAFTINGSTATION"
msgid "The very ground shall heed my will!"
msgstr "Сама земля зважатиме на мою волю!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_ARCHIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_ARCHIVE"
msgid "A piece of the battlefield."
msgstr "Шматок поля бою."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_BADLANDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_BADLANDS"
msgid "A piece of the battlefield."
msgstr "Шматок поля бою."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_BEARD_RUG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_BEARD_RUG"
msgid "I shan't ask any questions."
msgstr "Я не ставитиму питань."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_CARPETFLOOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_CARPETFLOOR"
msgid "It soaks up the blood of battle."
msgstr "Він усотує кров битви."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_CARPETFLOOR2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_CARPETFLOOR2"
msgid "A good color to hide the bloodstains of battle."
msgstr "Добрий колір, аби приховати криваві плями битви."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_CAVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_CAVE"
msgid "A piece of the battlefield."
msgstr "Шматок поля бою."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_CHECKERFLOOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_CHECKERFLOOR"
msgid "Fancy floor."
msgstr "Розкішна підлога."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_COTL_BRICK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_COTL_BRICK"
msgid "Sturdy bricks."
msgstr "Міцна цегла."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_COTL_GOLD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_COTL_GOLD"
msgid "The land is covered in riches!"
msgstr "Земля, вкрита скарбами!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_DECIDUOUS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_DECIDUOUS"
msgid "A piece of the battlefield."
msgstr "Шматок поля бою."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_DESERTDIRT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_DESERTDIRT"
msgid "A piece of the battlefield."
msgstr "Шматок поля бою."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_DIRT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_DIRT"
msgid "A piece of the battlefield."
msgstr "Шматок поля бою."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_DRAGONFLY"
msgid "A warm piece of the battlefield."
msgstr "Теплий шматок поля бою."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_FOREST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_FOREST"
msgid "A piece of the battlefield."
msgstr "Шматок поля бою."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_FUNGUS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_FUNGUS"
msgid "A piece of the battlefield."
msgstr "Шматок поля бою."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_FUNGUS_GREEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_FUNGUS_GREEN"
msgid "A piece of the battlefield."
msgstr "Шматок поля бою."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_FUNGUS_MOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_FUNGUS_MOON"
msgid "A piece of the battlefield."
msgstr "Шматок поля бою."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_FUNGUS_RED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_FUNGUS_RED"
msgid "A piece of the battlefield."
msgstr "Шматок поля бою."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_GRASS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_GRASS"
msgid "A piece of the battlefield."
msgstr "Шматок поля бою."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_MARSH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_MARSH"
msgid "A piece of the battlefield."
msgstr "Шматок поля бою."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_METEOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_METEOR"
msgid "A piece of the battlefield."
msgstr "Шматок поля бою."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_MONKEY_GROUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_MONKEY_GROUND"
msgid "A piece of the battlefield."
msgstr "Шматок поля бою."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_MOSAIC_BLUE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_MOSAIC_BLUE"
msgid "A piece of the battlefield."
msgstr "Шматок поля бою."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_MOSAIC_GREY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_MOSAIC_GREY"
msgid "A piece of the battlefield."
msgstr "Шматок поля бою."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_MOSAIC_RED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.TURF_MOSAIC_RED"
msgid "A piece of the battlefield."
