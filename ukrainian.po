msgstr "Знеживлений оживлений скелет."

#. STRINGS.RECIPE_DESC.CHESSPIECE_TOADSTOOL_BUILDER
msgctxt "STRINGS.RECIPE_DESC.CHESSPIECE_TOADSTOOL_BUILDER"
