msgstr "Недостатньо гною."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_INV_FULL"
