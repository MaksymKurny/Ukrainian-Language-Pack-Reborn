msgid "We're a bit old for playing peek-a-boo."
msgstr "Ми вже надто дорослі, щоб гратися в ку-ку."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.GENERIC"
msgid "Pretty petals!"
msgstr "Гарненькі пелюстки!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND"
msgid "Scary blossoms!"
msgstr "Страшне цвітіння!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET"
msgid "Put it down! Put it down!"
msgstr "Поклади! Поклади її!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.LEVEL1
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.LEVEL1"
msgid "Can she hear us in there?"
msgstr "Вона чує нас звідти?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.LEVEL2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.LEVEL2"
msgid "C'mon Abigail, Wendy misses you!"
msgstr "Ну ж бо, Абіґейл, Венді сумує за тобою!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.LEVEL3
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.LEVEL3"
msgid "Helloooo? Do you want to come out now?"
msgstr "Аго-о-о-ов? А тепер ти не хочеш вилізти?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid "I think it's listening to us!"
msgstr "Гадаю, вона слухає нас!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "It's getting creepy!"
msgstr "Стає моторошно!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "It gives us itches and skritches up our spine!"
msgstr "У нас через неї спина вкрилася сиротами!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED"
msgid "Hey! No fair!"
msgstr "Агов! Так нечесно!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABYSSPILLAR_MINION.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABYSSPILLAR_MINION.GENERIC"
msgid "We're glad it's just a statue!"
msgstr "Ми раді, що це просто статуя!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABYSSPILLAR_TRIAL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ABYSSPILLAR_TRIAL"
msgid "We'll pull it!"
msgstr "Ми потягнемо за нього!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "It gives me a goal in life."
msgstr "Він наповнює моє життя сенсом."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACORN"
msgid "Tree or food, there's something inside."
msgstr "Дерево або їжа, а всередині щось є."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACORN_COOKED"
msgid "Roasted on an open fire."
msgstr "Приготований на вогнищі."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ACORN_SAPLING"
msgid "May you have a long and free life."
msgstr "Зичу тобі довгого та вільного життя."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ADVENTURE_PORTAL"
msgid "Something wicked this way comes."
msgstr "Ми йдемо у щось лихе."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIANHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIANHAT"
msgid "We see things when we put it on..."
msgstr "Коли надіваємо її, то бачимо всяке..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIANHATSHARD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIANHATSHARD"
msgid "Uh oh... maybe we can paste them back together?"
msgstr "Ой-йой... Може, нам удасться зліпити їх назад докупи?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_CONTAINED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_CONTAINED"
msgid "It's sucking up all the glowy stuff!"
msgstr "Він всмоктує всю ту блискучу штуку!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD"
msgid "Whew, that was scary!"
msgstr "Фу-ух, то було страшно!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC"
msgid "Aah! It looks mad!"
msgstr "А-а-а! Він розлютився!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT"
msgid "It seems crankier than before!"
msgstr "Він іще більш злий, ніж раніше!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT"
msgid "So bright!"
msgstr "Такий яскравий!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD"
msgid "Is it over now?"
msgstr "Це вже все?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC"
msgid "Uh oh... we think we just made it madder..."
msgstr "Ой-йой... Здається, він іще сильніше на нас розлютився..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE"
msgid "Yikes, those are sharp!"
msgstr "Йой, вони гострі!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE3
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE3"
msgid "We're sorry! We're sorry!"
msgstr "Пробач нам! Пробач!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD"
msgid "We're not sure what he did, but it doesn't look like it's getting up again!"
msgstr "Ми не знаємо, що він зробив, але не схоже, що він знову підведеться!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB"
msgid "Watch out! It might get back up!"
msgstr "Стережіться! Він знову може повернутися!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP"
msgid "Now would be a really bad time to fall asleep."
msgstr "Зараз був би не дуже вдалий час для сну."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT"
msgid "Three-legged space spider?"
msgstr "Трилапий космічний павук?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.AMULET"
msgid "It's a fine necklace, I suppose."
msgstr "Гарне намисто, гадаю."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCHOR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCHOR"
msgid "It's really, really heavy."
msgstr "Він дуже-дуже важкий."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCHOR_ITEM"
msgid "That's for making an anchor."
msgstr "З нього можна зробити якір."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTFRUIT_GEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTFRUIT_GEM"
msgid "It's too hard to take a bite out of."
msgstr "Його дуже важко кусати."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTFRUIT_NIGHTVISION
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTFRUIT_NIGHTVISION"
msgid "Um... are we sure it's not full of baby spiders?"
msgstr "Е-е... А ми точно певні, що всередині немає павучків?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED"
msgid "It doesn't help our eyes, but it also doesn't hurt our tummy as much."
msgstr "Якщо з'їсти, то краще ми не бачитимемо, але й животик від неї не болітиме."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_GEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_GEM.GENERIC"
msgid "Aww, it's too hot to climb."
msgstr "Е-ех, він дуже гарячий. Не заліземо."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_GEM.STUMP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_GEM.STUMP"
msgid "Poor Mr. Tree."
msgstr "Бідолашний пан Дерево."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC"
msgid "It looks scary, but that doesn't mean it's bad!"
msgstr "Він страшненький, але це не означає, що він поганий!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP"
msgid "Poor Mr. Tree."
msgstr "Бідолашний пан Дерево."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC"
msgid "We think it likes its new home."
msgstr "Нам здається, йому подобається його новий дім."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON"
msgid "It's okay, you can grow when you're ready."
msgstr "Все гаразд. Виростеш, коли будеш готовий."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE"
msgid "What's wrong? Don't you like it there?"
msgstr "Що не так? Тобі тут не подобається?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_SAPLING_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_SAPLING_ITEM"
msgid "We're going to find a good home for you!"
msgstr "Ми підшукаємо для тебе гарненький дім!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_SEED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENTTREE_SEED"
msgid "We want to see what it grows into!"
msgstr "Нам хочеться побачити, що з нього виросте!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENT_ALTAR"
msgid "Old and full of mysteries."
msgstr "Стара та повна таємниць."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "It's been busted up."
msgstr "Її розтрощили."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENT_HUSK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENT_HUSK"
msgid "Were they mad at each other?"
msgstr "Вони ненавиділи один одного?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANCIENT_STATUE"
msgid "It's throbbing strangely."
msgstr "Вона дивно пульсує."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANIMAL_TRACK"
msgid "Whatever it is, it travels single file."
msgstr "Що б це не було, воно подорожує на самоті."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTCHOVIES
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTCHOVIES"
msgid "It's like peoplefood and spiderfood in one!"
msgstr "Це ніби як їжа і для людей, і для павуків!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTLION.GENERIC"
msgid "You're fuzzy. We like that."
msgstr "Ти пухнастий. Нам подобається."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTLION.UNHAPPY"
msgid "I think it's upset."
msgstr "Гадаю, він засмучений."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTLION.VERYHAPPY"
msgid "It's always nice to have more bug friends."
msgstr "Завжди гарно мати більше комашиних друзів."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTLIONHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTLIONHAT"
msgid "We can pretend we're an Antlion!"
msgstr "Ми можемо прикинутися мурашиним левом!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ANTLIONTRINKET"
msgid "Sand castles!!"
msgstr "Піщані замки!!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_CENTIPEDE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_CENTIPEDE"
msgid "We made it angry!"
msgstr "Ми її розлютили!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK"
msgid "Someone left these parts lying around."
msgstr "Хтось облишив тут ці запчастини."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_COOKPOT.BURNT"
msgid "Someone must have left the fire going."
msgstr "Хтось, мабуть, забув загасити вогонь."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG"
msgid "It won't be done for a while."
msgstr "Ще нескоро буде готово."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT"
msgid "Almost ready!"
msgstr "Майже готово!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_COOKPOT.DONE"
msgid "Supper is served."
msgstr "Вечерю подано."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_COOKPOT.EMPTY"
msgid "Bugs get hungry too! We should know!"
msgstr "Комахи теж хочуть їсти! Хто, як не ми, про це знаємо!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_LOCKBOX
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_LOCKBOX"
msgid "How will we get it open?"
msgstr "І як ми до нього дістанемося?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC"
msgid "Can we press all the buttons?"
msgstr "Можна нам понатискати на всі кнопки?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF"
msgid "We think it's broken."
msgstr "Гадаємо, воно зламане."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_MOON_STATUE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_MOON_STATUE"
msgid "Maybe the moon was important to them?"
msgstr "Мабуть, місяць був для них чимсь важливим?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN"
msgid "We love puzzles!"
msgstr "Ми обожнюємо головоломки!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_PORTAL.GENERIC"
msgid "Aw, this one didn't turn back on."
msgstr "Ой, а цей не ввімкнувся."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_PORTAL.POWEROFF
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_PORTAL.POWEROFF"
msgid "Maybe it used to go somewhere?"
msgstr "Може, він кудись вів?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_RESONATOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_RESONATOR.GENERIC"
msgid "It's taking us on a treasure hunt!"
msgstr "З ним ми вирушимо на пошуки скарбів!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_RESONATOR.IDLE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_RESONATOR.IDLE"
msgid "Aw, I guess we found them all."
msgstr "Ой, гадаю, ми вже все знайшли."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_RESONATOR_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_RESONATOR_ITEM"
msgid "We think it's for finding something."
msgstr "Гадаємо, він потрібен для пошуку чогось."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1"
msgid "We sure wish we knew what it says!"
msgstr "Нам би дуже хотілося знати, що тут написано!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2"
msgid "It's very pretty."
msgstr "Він дуже гарненький."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3"
msgid "We sure wish we knew what it says!"
msgstr "Нам би дуже хотілося знати, що тут написано!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4"
msgid "It's very pretty."
msgstr "Він дуже гарненький."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5"
msgid "We sure wish we knew what it says!"
msgstr "Нам би дуже хотілося знати, що тут написано!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC"
msgid "It's got a little night light inside!"
msgstr "У нього всередині є маленький нічник!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF"
msgid "Aw, it doesn't do anything."
msgstr "Ех, він нічого не робить."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_SECURITY_PULSE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_SECURITY_PULSE"
msgid "Wait for us!"
msgstr "Зажди нас!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_SWITCH.GEMS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_SWITCH.GEMS"
msgid "It needs something shiny!"
msgstr "Йому треба щось блискуче!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_SWITCH.VALID
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARCHIVE_SWITCH.VALID"
msgid "This one's all ready."
msgstr "Гадаємо, все готово."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORDRAGONFLY"
msgid "Another creature casing."
msgstr "Ще одна оболонка істоти."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORDREADSTONE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORDREADSTONE"
msgid "It's kinda scary, but it keeps us safe!"
msgstr "Вона трошки страшна, але добре захищає!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORGRASS"
msgid "It just feels like more hair."
msgstr "Коли його вдягаєш, то таке відчуття, ніби просто шерсті побільшало."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORMARBLE"
msgid "Marbelous protection!"
msgstr "Мармуровижний захист!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORRUINS"
msgid "Nice and lightweight."
msgstr "Чудовий та легкий."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORSKELETON"
msgid "Rattle rattle."
msgstr "Трісь-хрусь."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORSLURPER"
msgid "Squeeze our tummy tight!"
msgstr "Стискай наш животик міцно!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORSNURTLESHELL"
msgid "It didn't protect the last guy."
msgstr "Равлипашку він не зміг захистити."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORWAGPUNK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORWAGPUNK"
msgid "Ms. Wickerbottom said to keep our fingers away from the gears."
msgstr "Пані Вікерботтом сказала, щоб ми не пхали пальці між шестерень."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMORWOOD"
msgid "Wood you like to fight?"
msgstr "Хочеш наламати дров?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMOR_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMOR_BRAMBLE"
msgid "We're ready to let spikes fly!"
msgstr "Ми готові випускати колючки!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMOR_CARROTLURE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMOR_CARROTLURE"
msgid "Does this count as eating our vegetables?"
msgstr "Можна вважати, що нам не доведеться потім їсти ще овочі?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMOR_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMOR_LUNARPLANT"
msgid "We're gonna look so tough!"
msgstr "У ній ми матимемо такий крутий вигляд!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMOR_LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMOR_LUNARPLANT_HUSK"
msgid "We aren't allowed to play with that. It's just for Wormwood."
msgstr "Нам не дозволено з нею гратися. Вона для Вормвуда."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMOR_SANITY"
msgid "It's a bit uneasy wearing this, but so effective."
msgstr "Нам трохи неспокійно в ній, але вона добре захищає."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMOR_VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMOR_VOIDCLOTH"
msgid "It makes it look like our tummy's smiling!"
msgstr "У ній наш животик ніби всміхається!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMOR_YOTH_KNIGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARMOR_YOTH_KNIGHT"
msgid "Ooh, this will keep us safe!"
msgstr "О-о-о, він добряче нас захистить!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "The lettering burnt off."
msgstr "Напис вигорів."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "We could write on that if only we had a pen!"
msgstr "Якби ми мали чим писати, ми б залишили напис!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "Ooooh, what should we say?"
msgstr "О-о-о-ой, що б нам написати?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "The lettering burnt off."
msgstr "Напис вигорів."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "We could write on that if only we had a pen!"
msgstr "Якби ми мали чим писати, ми б залишили напис!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "Ooooh, what should we say?"
msgstr "О-о-о-ой, що б нам написати?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASH.GENERIC"
msgid "Funk to funky."
msgstr "Пахне димом."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "The eyebone didn't survive the trip."
msgstr "Кістяне око не витримало подорожі."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "The flower didn't make it."
msgstr "Квіточка не вижила."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "Whatever it was, it's gone back to the earth."
msgstr "Що б то не було, але воно вже покинуло наш світ."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASPARAGUS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASPARAGUS"
msgid "Mom said we should eat our vegetables."
msgstr "Мама казала, що нам треба їсти овочі."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASPARAGUSSOUP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASPARAGUSSOUP"
msgid "Mmmm...warms our tummy."
msgstr "М-м-м-м... Зігріває нам животик."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASPARAGUS_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASPARAGUS_COOKED"
msgid "Asparagus makes our pee smell funny."
msgstr "Від спаржі в нас дивно пахне сеча."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASPARAGUS_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASPARAGUS_OVERSIZED"
msgid "Oh... that's a lot of asparagus..."
msgstr "Ой... так багато спаржі..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASPARAGUS_SEEDS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASPARAGUS_SEEDS"
msgid "Do we have a garden to plant this?"
msgstr "Чи маємо ми город, де можна його посадити?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "What's it doing?"
msgstr "Що вона робить?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "It wasn't a way home, anyway."
msgstr "Все одно вона б не повернула нас додому."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "It looks like it's gonna blow up!"
msgstr "Здається, вона зараз бабахне!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_GATE.OFF"
msgid "We need another piece to turn it on."
msgstr "Нам потрібна ще одна частинка, щоб її активувати."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_GATE.ON"
msgid "Does this mean we get to go home?"
msgstr "Невже ми нарешті повернемося додому?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_KEY"
msgid "This key is REALLY old."
msgstr "Цей ключ ДУЖЕ старий."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "No light."
msgstr "Нема світла."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "We don't like it."
msgstr "Нам він не подобається."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_OVERGROWTH"
msgid "We never learned those letters."
msgstr "Ми не вчили таких літер."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
msgid "It's a picture of some bug people."
msgstr "Тут намальовані якісь люди-комахи."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
msgid "This picture's all messed up."
msgstr "Не дуже зрозуміло, що тут намальовано."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "There's a lot of black goop in this picture."
msgstr "Тут намальовано багато якоїсь чорної рідини."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
msgid "A picture of bug people escaping their bug outsides!"
msgstr "Тут намальовані люди-комахи, які скидають свої комашині оболонки!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_RUBBLE.LINE_5
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_RUBBLE.LINE_5"
msgid "A picture of a city. It looks like a nice place to live."
msgstr "Тут намальовано місто. Мабуть, там жилося гарно."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_STATUE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_STATUE"
msgid "They look sick."
msgstr "У неї хворобливий вигляд."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.AXE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.AXE"
msgid "Chop and chop."
msgstr "Стук-стук."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BABYBEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BABYBEEFALO.GENERIC"
msgid "Get busy, child."
msgstr "Займися чимсь, дитино."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BABYBEEFALO.SLEEPING"
msgid "That's the opposite of busy."
msgstr "Це антонім до слова «зайнятість»."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BACKPACK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BACKPACK"
msgid "It's like a second abdomen we can store things in."
msgstr "Він неначе другий животик, у якому можна зберігати речі."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BACONEGGS"
msgid "I'd rather have sugary cereal. Oh well."
msgstr "Я б натомість з'їв солодких пластівців. Ну що ж."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BALATRO_MACHINE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BALATRO_MACHINE"
msgid "Prizes!"
msgstr "Призи!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BALLOON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BALLOON"
msgid "Balloon animals! Balloon animals!!"
msgstr "Надувні тваринки! Надувні тваринки!!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BALLOONHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BALLOONHAT"
msgid "It looks like a bunny!"
msgstr "Він схожий на зайчика!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BALLOONPARTY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BALLOONPARTY"
msgid "Yay! It's a party!"
msgstr "Ура! У нас вечірка!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BALLOONSPEED.DEFLATED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BALLOONSPEED.DEFLATED"
msgid "We have to hold on tight or it'll fly away!"
msgstr "Треба тримати її міцно, а то улетить!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BALLOONSPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BALLOONSPEED.GENERIC"
msgid "Circles must be the speediest shape."
msgstr "Коло — це, напевно, найшвидша форма."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BALLOONS_EMPTY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BALLOONS_EMPTY"
msgid "Is there going to be a party?!"
msgstr "У нас буде вечірка?!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BALLOONVEST
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BALLOONVEST"
msgid "We should take it on our boat trips."
msgstr "Нам варто брати його з нами у наші мандрівки на човнику."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BANANABUSH
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BANANABUSH"
msgid "We didn't know bananas could grow outside!"
msgstr "Ми й не знали, що банани можуть рости надворі!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BANANAJUICE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BANANAJUICE"
msgid "Mmmm, cold and banana-y."
msgstr "М-м-м-м, холодний і банановий."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BANANAPOP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BANANAPOP"
msgid "Yaaay! Popsicle, popsicle!"
msgstr "Ура-а-а! Фруктовий лід! Фруктовий лід!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BANDAGE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BANDAGE"
msgid "Bandages for booboos."
msgstr "Бинти для бо-бошок."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BANDAGE_BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BANDAGE_BUTTERFLYWINGS"
msgid "Sticker!"
msgstr "Наліпка!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BARNACLE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BARNACLE"
msgid "We found them in the sea!"
msgstr "Ми знайшли їх у морі!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BARNACLEPITA
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BARNACLEPITA"
msgid "It's a little pocket of chewiness!"
msgstr "Маленька кишенька жувальності!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BARNACLESTUFFEDFISHHEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BARNACLESTUFFEDFISHHEAD"
msgid "Yuck!"
msgstr "Фу!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BARNACLESUSHI
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BARNACLESUSHI"
msgid "Wow, fancy!"
msgstr "Овва, гарненькі!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BARNACLE_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BARNACLE_COOKED"
msgid "We've never eaten barnacles before."
msgstr "Ми ніколи раніше не їли балянусів."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BARNACLINGUINE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BARNACLINGUINE"
msgid "Watch how fast we can slurp it up!"
msgstr "Дивіться, як швидко ми можемо його заковтнути!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BASALT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BASALT"
msgid "Impenetrable."
msgstr "Непробивний."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BAT"
msgid "Screechy mean guy!"
msgstr "Писклява злюка!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATBAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATBAT"
msgid "Flap that bat like you were born to do it."
msgstr "Бита з кажана для кожного страшка."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATCAVE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATCAVE"
msgid "Oooh they're hiding in there!"
msgstr "О-о-ой, вони там ховаються!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATHBOMB
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATHBOMB"
msgid "I miss bubble baths."
msgstr "Я сумую за піною для ванни."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATNOSE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATNOSE"
msgid "A rosy pink nosey"
msgstr "Рум'яно-рожевий носик"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATNOSEHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATNOSEHAT"
msgid "Mother said we must always drink our milk."
msgstr "Мати казала, що ми маємо завжди пити молоко."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATNOSE_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATNOSE_COOKED"
msgid "It looks very chewy."
msgstr "Схоже, жуватимемо ми їх дуже довго."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATTLESONG_CONTAINER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATTLESONG_CONTAINER"
msgid "Remember to put all the songs away when you're done!"
msgstr "Не забудь покласти всі пісні на місце, коли закінчиш!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATTLESONG_DURABILITY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATTLESONG_DURABILITY"
msgid "We like singing songs!"
msgstr "Ми любимо співати пісень!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATTLESONG_FIRERESISTANCE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATTLESONG_FIRERESISTANCE"
msgid "We like singing songs!"
msgstr "Ми любимо співати пісень!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATTLESONG_HEALTHGAIN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATTLESONG_HEALTHGAIN"
msgid "We like singing songs!"
msgstr "Ми любимо співати пісень!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATTLESONG_INSTANT_PANIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATTLESONG_INSTANT_PANIC"
msgid "The characters talk just like Wigfrid!"
msgstr "Персонажі розмовляють так само, як Віґфрід!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATTLESONG_INSTANT_REVIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATTLESONG_INSTANT_REVIVE"
msgid "We like singing songs!"
msgstr "Ми любимо співати пісень!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATTLESONG_INSTANT_TAUNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATTLESONG_INSTANT_TAUNT"
msgid "We probably shouldn't repeat this one. It sounds rude."
msgstr "Гадаємо, нам не варто повторювати такі слова. Вони грубі."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATTLESONG_LUNARALIGNED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATTLESONG_LUNARALIGNED"
msgid "We like singing songs!"
msgstr "Ми любимо співати пісень!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATTLESONG_SANITYAURA
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATTLESONG_SANITYAURA"
msgid "We like singing songs!"
msgstr "Ми любимо співати пісень!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATTLESONG_SANITYGAIN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATTLESONG_SANITYGAIN"
msgid "We like singing songs!"
msgstr "Ми любимо співати пісень!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATTLESONG_SHADOWALIGNED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATTLESONG_SHADOWALIGNED"
msgid "We like singing songs!"
msgstr "Ми любимо співати пісень!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATWING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATWING"
msgid "This thing drives me batty."
msgstr "Крило кажана ліску."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATWING_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BATWING_COOKED"
msgid "Tastes like chicken."
msgstr "На смак як курка."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEARDHAIR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEARDHAIR"
msgid "In another life, I could've grown this."
msgstr "В іншому житті я міг би таке виростити."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEARGER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEARGER"
msgid "Run for the hills!"
msgstr "Час кивати п'ятами!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEARGERCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEARGERCORPSE.BURNING"
msgid "Now he won't come back."
msgstr "Тепер він більше не повернеться."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEARGERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEARGERCORPSE.GENERIC"
msgid "At least he won't try to stomp on us anymore."
msgstr "Принаймні більше він не намагатиметься нас розчавити."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEARGERCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEARGERCORPSE.REVIVING"
msgid "Aah! He's coming back!"
msgstr "А-а-а! Він повертається!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEARGERFUR_SACK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEARGERFUR_SACK"
msgid "We like our snacks cold."
msgstr "Нам подобається, коли наші закуски холодні."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEARGERVEST
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEARGERVEST"
msgid "We'll be the hairiest spider ever."
msgstr "Ми будемо найволохатішим павуком у світі."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEARGER_FUR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEARGER_FUR"
msgid "It's so thick!"
msgstr "Воно таке густе!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEAST_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEAST_BLUEPRINT"
msgid "Another costume for our lucky beefalo!"
msgstr "Ще один костюм для нашого щасливого біфало!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEDROLL_FURRY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEDROLL_FURRY"
msgid "I miss being able to properly feel a nice bedroll."
msgstr "Я сумую за можливістю відчувати приємний доторк постелі."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEDROLL_STRAW
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEDROLL_STRAW"
msgid "Musty but relaxing."
msgstr "Затхлий, але м'який."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEE.GENERIC"
msgid "Always Be Pollinating."
msgstr "Працюй, як бджілка."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEE.HELD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEE.HELD"
msgid "Ours now!"
msgstr "Тепер наша!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEBOX.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEBOX.BURNT"
msgid "The site of The Great Honey Fire."
msgstr "Осередок великого медового вогню."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEBOX.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEBOX.FULLHONEY"
msgid "It's full to brimming."
msgstr "Він заповнений по вінця."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEBOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEBOX.GENERIC"
msgid "It's a box with bees in it."
msgstr "Ящик, а всередині бджілки."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEBOX.NOHONEY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEBOX.NOHONEY"
msgid "There's no honey inside."
msgstr "Всередині немає меду."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEBOX.READY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEBOX.READY"
msgid "It's full to brimming."
msgstr "Він заповнений по вінця."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEBOX.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEBOX.SOMEHONEY"
msgid "Work faster, bees!"
msgstr "Працюйте швидше, бджілки!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEBOX_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEBOX_HERMIT.BURNT"
msgid "The site of The Great Honey Fire."
msgstr "Осередок великого медового вогню."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEBOX_HERMIT.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEBOX_HERMIT.FULLHONEY"
msgid "Hey Ms. Old Lady! Look at all the honey they made!"
msgstr "Агов, літня пані! Подивіться, скільки меду вони зробили!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEBOX_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEBOX_HERMIT.GENERIC"
msgid "We hear a lot of buzzing inside..."
msgstr "Ми чуємо всередині багато дзижчання..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEBOX_HERMIT.NOHONEY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEBOX_HERMIT.NOHONEY"
msgid "There's no honey inside."
msgstr "Всередині немає меду."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEBOX_HERMIT.READY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEBOX_HERMIT.READY"
msgid "Hey Ms. Old Lady! Look at all the honey they made!"
msgstr "Агов, літня пані! Подивіться, скільки меду вони зробили!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY"
msgid "Work faster, bees!"
msgstr "Працюйте швидше, бджілки!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO.DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO.DEAD"
msgid "We saw it walking around a minute ago."
msgstr "Ми бачили, як він іще хвилину тому був на ногах."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO.DEAD_MYPARTNER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO.DEAD_MYPARTNER"
msgid "Our poor beefalo! It's not fair!"
msgstr "Наш бідолашний біфало! Це нечесно!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO.DOMESTICATED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO.DOMESTICATED"
msgid "This one likes us!"
msgstr "Ми йому подобаємося!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO.FOLLOWER"
msgid "He seems to want to stick around."
msgstr "Здається, він хоче залишитися з нами."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO.GENERIC"
msgid "Big big beefalo!"
msgstr "Великий-великий біфало!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO.MYPARTNER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO.MYPARTNER"
msgid "That's our friend!"
msgstr "Він наш друзяка!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO.NAKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO.NAKED"
msgid "Shaved you good!"
msgstr "Гарно тебе побрили!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO.ORNERY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO.ORNERY"
msgid "We're kind of scared of this one."
msgstr "Ми його трошки побоюємось."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO.PUDGY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO.PUDGY"
msgid "We like to cuddle this one!"
msgstr "Ми любимо його міцно обіймати!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO.RIDER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO.RIDER"
msgid "This one looks fast."
msgstr "Гадаю, він швидко бігає."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO.SLEEPING"
msgid "Slumber deep, beefalo."
msgstr "Солодких снів, біфало."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALOFEED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALOFEED"
msgid "We take good care of our beefalo."
msgstr "Ми добре піклуємося про нашого біфало."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALOHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALOHAT"
msgid "The wearer will blend in perfectly."
msgstr "Якщо її надіти, то тебе не відрізнять від біфало."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALOTREAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALOTREAT"
msgid "Good beefalo deserve treats."
msgstr "Слухняний біфало заслуговує ласощів."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALOWOOL"
msgid "Thick fur."
msgstr "Густа шерсть."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO_GROOMER.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO_GROOMER.BURNT"
msgid "Aww..."
msgstr "Е-ех..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO_GROOMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO_GROOMER.GENERIC"
msgid "We want our beefalo to look its best!"
msgstr "Ми хочемо, щоб наш біфало мав найкращий вигляд!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO_GROOMER.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO_GROOMER.OCCUPIED"
msgid "You're going to look so good when we're finished!"
msgstr "Коли ми закінчимо, ти матимеш просто неперевершений вигляд!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO_GROOMER_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEFALO_GROOMER_ITEM"
msgid "We'd better get it set up."
msgstr "Краще нам її встановити."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEF_BELL"
msgid "The beefalo really like this bell, and whoever rings it!"
msgstr "Біфало дуже люблять цей дзвіночок і того, хто в нього дзвонить!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEGUARD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEGUARD"
msgid "So fluffy but so mean!!"
msgstr "Такий пухнастий, але такий злий!!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEHAT"
msgid "It's a face fortress!"
msgstr "Фортеця для обличчя!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEHIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEHIVE"
msgid "It's a hive of activity."
msgstr "Воно аж дзижчить від роботи."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEMINE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEMINE"
msgid "Would you bee mine?"
msgstr "Маєш кислу міну? Скуштуй медову міну!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEMINE_MAXWELL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEMINE_MAXWELL"
msgid "I just can't mosquito you."
msgstr "Тепер до мене навіть комар носа не підточить."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEQUEEN"
msgid "Bees aren't our friends!"
msgstr "Бджоли нам не друзі!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEQUEENHIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEQUEENHIVE.GENERIC"
msgid "Not web. We can't walk on it."
msgstr "Не павутиння. Не можемо по ній ходити."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEQUEENHIVE.GROWING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEQUEENHIVE.GROWING"
msgid "I wonder what the bees are making!"
msgstr "Мені цікаво, що бджоли там роблять!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEQUEENHIVEGROWN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEEQUEENHIVEGROWN"
msgid "Oh, bother!"
msgstr "Лишенько!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEESWAX
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEESWAX"
msgid "This stuff gives me hives."
msgstr "У мене на нього алергія."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEESWAX_SPRAY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEESWAX_SPRAY"
msgid "We're only allowed to spray it on plants."
msgstr "Нам дозволено пшикати ним тільки на рослини."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEETLETAUR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BEETLETAUR"
msgid "All that armor must be heavy."
msgstr "Мабуть, уся та броня така важка."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BELL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BELL"
msgid "Exactly the right amount of bell."
msgstr "Старий дзвін, але надійний як дзвін."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BERNIE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BERNIE_ACTIVE"
msgid "That teddy bear is moving!"
msgstr "Іграшковий ведмедик ходить!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BERNIE_BIG
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BERNIE_BIG"
