msgstr "Ці пташечки не дуже радісно цвірінькають."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LUNAR_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LUNAR_RIFT_MAX"
msgid "We can see something glowing waaay over there!"
msgstr "Ми бачимо, як о-о-он там щось світиться!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MAX_CLOCKWORKS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Maybe it's not allowed to play with us."
msgstr "Може, тобі не дозволяють з нами гратися..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MEGA_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MEGA_FLARE_SEEN"
msgid "Uh-oh, that bright light's attracting a lot of attention..."
msgstr "Ой-йой, те яскраве світло привертає до себе багато уваги..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MITEGLAND_DEBUFF.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MITEGLAND_DEBUFF.1"
msgid "Our tummy's all burny!"
msgstr "У нашому животику дуже пече!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MITEGLAND_DEBUFF.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MITEGLAND_DEBUFF.2"
msgid "We REALLY shouldn't have eaten that..."
msgstr "Нам правда не слід було її їсти..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MITEGLAND_DEBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MITEGLAND_DEBUFF_DONE"
msgid "Our tummy is finally feeling better."
msgstr "Нашому животику нарешті стало краще."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MONKEY_CURSE_1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MONKEY_CURSE_1"
msgid "We feel weird... weirder than usual..."
msgstr "Ми почуваємося дивно... Дивніше, ніж зазвичай..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MONKEY_CURSE_CHANGE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MONKEY_CURSE_CHANGE"
msgid "What? How...? Now we're really confused..."
msgstr "Що? Як?.. Тепер ми справді нічого не розуміємо..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MONKEY_CURSE_CHANGEBACK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MONKEY_CURSE_CHANGEBACK"
msgid "We're us again!"
msgstr "Ми знову стали нами!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW"
msgid "Almost!"
msgstr "Майже!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.GLASS_MED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.GLASS_MED"
msgid "We'll get you out."
msgstr "Ми витягнемо тебе."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL"
msgid "You're free!"
msgstr "Ти вільна!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW"
msgid "Almost!"
msgstr "Майже!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_MED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_MED"
msgid "We'll get you out."
msgstr "Ми витягнемо тебе."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL"
msgid "You're free!"
msgstr "Ти вільний!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_LOW
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_LOW"
msgid "Almost!"
msgstr "Майже!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_MED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_MED"
msgid "We'll get you out."
msgstr "Ми витягнемо тебе."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL"
msgid "You're free!"
msgstr "Ти вільна!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONPOTION_FAILED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONPOTION_FAILED"
msgid "Whoops!"
msgstr "Ой-йой!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOSQUITOS"
msgid "Suck someone else's blood!"
msgstr "Смокчи чиюсь іншу кров!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "Our hairy friend is hurt!"
msgstr "Нашого волохатого друзяку поранено!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL"
msgid "Buzzards! Hey, they look strange."
msgstr "Стерв'ятники! Йой, якісь вони дивні."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERGIFT"
