msgstr "Ха! Ложка ґрунту все виправить!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_DUSK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_DUSK"
