msgstr "Чи можна на ній зіграти «О Канадо»?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC"
