#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALL_SCRAP
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALL_SCRAP"
msgid "I hope wall of junk is strong."
msgstr "Сподіваюся, що стіна зі сміття міцна."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALL_SCRAP_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALL_SCRAP_ITEM"
msgid "I hope wall of junk is strong."
msgstr "Сподіваюся, що стіна зі сміття міцна."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALL_STONE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALL_STONE"
msgid "Wall is strong like me!"
msgstr "Стіна сильна, як я!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALL_STONE_2
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALL_STONE_2"
msgid "Wall is strong like me!"
msgstr "Стіна сильна, як я!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALL_STONE_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALL_STONE_ITEM"
msgid "Piles of rocks!"
msgstr "Купка каменюк!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALL_WOOD.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALL_WOOD.BURNT"
msgid "Goodbye, pointy sticks!"
msgstr "Бувайте, гострі палки!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALL_WOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALL_WOOD.GENERIC"
msgid "Hello, pointy sticks!"
msgstr "Привіт, гострі палки!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALL_WOOD_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALL_WOOD_ITEM"
msgid "Pokey sticks!"
msgstr "Гострі палки!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALRUS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALRUS"
msgid "Ha ha. Is blubbery flubbery man."
msgstr "Ха-ха. Товстенький, пухкенький чолов'яга."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALRUSHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALRUSHAT"
msgid "Sea cow man hat!"
msgstr "Капелюх того морського бика!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALRUS_CAMP.EMPTY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALRUS_CAMP.EMPTY"
msgid "Is locked."
msgstr "Зачинено."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALRUS_CAMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALRUS_CAMP.GENERIC"
msgid "How do they all fit?"
msgstr "Як вони усі поміщаються?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALRUS_TUSK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALRUS_TUSK"
msgid "Sea cow man tooth!"
msgstr "Зуб морського бика!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALTER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALTER.ATTACKER"
msgid "Tiny %s think he can pick fight with Wolfgang?"
msgstr "Крихітка %s думає, що може нариватися на Вольфґанґа?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALTER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALTER.FIRESTARTER"
msgid "Silly %s forget where firepit is!"
msgstr "От дурко! %s не знає, де палити вогнище!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALTER.GENERIC"
msgid "Is boy who tell the scary stories... h-hello %s!"
msgstr "Хлопчик, що розповідає страшні байки... п-привіт, %s!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALTER.GHOST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALTER.GHOST"
msgid "Wolfgang help you now, %s."
msgstr "Вольфґанґ зараз тобі допоможе, %s."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALTER.MURDERER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALTER.MURDERER"
msgid "Wolfgang will not be part of next camping fire story!"
msgstr "Вольфґанґ не стане персонажем наступної байки!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALTER.REVIVER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALTER.REVIVER"
msgid "%s always help Wolfgang. Wolfgang remember this!"
msgstr "%s завжди допомагає Вольфґанґові. Вольфґанґ про це пам'ятатиме!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALTERHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WALTERHAT"
msgid "Will tiny hat fit on Wolfgang's mighty head?"
msgstr "Чи пасуватиме крихітний капелюшок до Вольфґанґової могутньої голови?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WANDA.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WANDA.ATTACKER"
msgid "%s is strong for old lady!"
msgstr "%s має багато сили, як на літню людину!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WANDA.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WANDA.FIRESTARTER"
msgid "Clock lady say is for important reason. Wolfgang not sure..."
msgstr "Годинникарка каже, що були вагомі причини. Вольфґанґ не впевнений..."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WANDA.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WANDA.GENERIC"
msgid "Is clock lady, %s! Hello!"
msgstr "Це ж годинникарка! Привіт, %s!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WANDA.GHOST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WANDA.GHOST"
msgid "Clock lady wait here, Wolfgang will find heart!"
msgstr "Годинникарко, зажди тут, Вольфґанґ знайде серце!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WANDA.MURDERER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WANDA.MURDERER"
msgid "Clock lady %s is killer!"
msgstr "%s вбиває не тільки час!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WANDA.REVIVER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WANDA.REVIVER"
msgid "%s is strange lady, but kind."
msgstr "%s — дивна людина, але добра."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WANDERINGTRADER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WANDERINGTRADER.GENERIC"
msgid "Is not normal hair-cow."
msgstr "Це не звичайна волохата корова."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WANDERINGTRADER.REVEALED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WANDERINGTRADER.REVEALED"
msgid "Hello, hair-cow man! We trade, yes?"
msgstr "Вітаю, волохатий короволюде! Поторгуємо?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARDROBE.BURNING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARDROBE.BURNING"
msgid "Box of fire!"
msgstr "Ящик у вогні!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARDROBE.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARDROBE.BURNT"
msgid "Box all gone."
msgstr "Ящику кінець."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARDROBE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARDROBE.GENERIC"
msgid "Box of clothes!"
msgstr "Ящик з одягом!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARG
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARG"
msgid "Big puppy!"
msgstr "Великий цуцик!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARGCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARGCORPSE.BURNING"
msgid "Why burn doggy? Already dead."
msgstr "Нащо палити песика? Уже мертвий."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARGCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARGCORPSE.GENERIC"
msgid "Doggy has died. Moment of silent. Start now."
msgstr "Песик помер. Оголошую хвилину мовчання."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARGCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARGCORPSE.REVIVING"
msgid "Oh. Should have burn doggy."
msgstr "Ой. Треба було спалити песика."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARGLET
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARGLET"
msgid "Is bad dog!"
msgstr "Поганий песик!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARGSHRINE.BURNT"
msgid "Puppy box is burned."
msgstr "Буда з цуциком згоріла."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARGSHRINE.EMPTY"
msgid "Shiny puppy is wanting to play fetch."
msgstr "Блискучий цуцик хоче побігати за палицею."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARGSHRINE.GENERIC"
msgid "Stick made shiny puppy happy!"
msgstr "Блискучий цуцик дуже радий палиці!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARLY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARLY.ATTACKER"
msgid "Why not use fists for bread making, yes?"
msgstr "Чому б тобі цими кулаками не піти намісити тіста?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARLY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARLY.FIRESTARTER"
msgid "Tasty-making man was probably cook with big fire."
msgstr "Смаколикороб, напевно, готував на великому вогні."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARLY.GENERIC"
msgid "Is tasty-making man, %s! Hello!"
msgstr "Смаколикороб %s! Привіт!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARLY.GHOST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARLY.GHOST"
msgid "Does tiny man %s need Mighty Wolfgang's help?"
msgstr "%s, тобі треба допомога могутнього Вольфґанґа?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARLY.MURDERER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARLY.MURDERER"
msgid "Tasty-making man is murderer!"
msgstr "Смаколикороб — убивця!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARLY.REVIVER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WARLY.REVIVER"
msgid "%s has nice big heart."
msgstr "%s має чудове, велике серце."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAR_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAR_BLUEPRINT"
msgid "Yes, will make hairy cow fearsome!"
msgstr "Так, усі боятимуться мою волохату корову!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WASPHIVE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WASPHIVE"
msgid "Mind says no. Muscles say yes!"
msgstr "Розум каже: «ні». М'язи кажуть: «так»!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERBALLOON
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERBALLOON"
msgid "Is very squishy-wobbly!"
msgstr "Дуже м'яка й водяна!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERINGCAN.EMPTY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERINGCAN.EMPTY"
msgid "Is empty."
msgstr "Порожня."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERINGCAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERINGCAN.GENERIC"
msgid "Wolfgang will give garden a drink!"
msgstr "Вольфґанґ напоїть город!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERMELON
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERMELON"
msgid "So many seeds."
msgstr "Так багато насінин."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERMELONHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERMELONHAT"
msgid "Why not wear melon on head! Haha!"
msgstr "А цей кавун такий, що на голову налазить! Ха-ха!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERMELONICLE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERMELONICLE"
msgid "Ha! Melon on a stick."
msgstr "Ха! Кавун на паличці."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERMELON_COOKED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERMELON_COOKED"
msgid "Seeds is cooked out of melon now."
msgstr "Насінинки випеклися з кавуна."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERMELON_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERMELON_OVERSIZED"
msgid "Is extra big to hold more melon inside."
msgstr "Надвеликий, іще більш кавуновий."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERMELON_SEEDS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERMELON_SEEDS"
msgid "Maybe will grow into tasty snacks?"
msgstr "Може, з нього виросте смачна закуска?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERPLANT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERPLANT"
msgid "Tall plant makes Wolfgang nervous..."
msgstr "Висока рослина нервує Вольфґанґа..."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERPLANT_BABY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERPLANT_BABY"
msgid "Ha! So small and weak!"
msgstr "Ха! Такий малий та слабкий!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERPLANT_BOMB
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERPLANT_BOMB"
msgid "Is bad plant! Very bad plant!"
msgstr "Погана рослина! Дуже погана!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERPLANT_PLANTER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERPLANT_PLANTER"
msgid "It needs rock for the growing."
msgstr "Йому потрібна каменюка, щоб рости."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERPUMP
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERPUMP"
msgid "Splishy splashy pump."
msgstr "Хлюп-плесь помпа."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERTREE_PILLAR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERTREE_PILLAR"
msgid "Tree must lift lot of weights to get so big!"
msgstr "Певно, дерево добряче тренувалося, аби стати таким кремезним!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERTREE_ROOT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATERTREE_ROOT"
msgid "Is big tree root."
msgstr "Корінь кремезного дерева."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATHGRITHR.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATHGRITHR.ATTACKER"
msgid "%s will make a worthy fight!"
msgstr "%s дасть гідний бій!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATHGRITHR.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATHGRITHR.FIRESTARTER"
msgid "Why starting fires, stronglady? To fight them?"
msgstr "Нащо влаштовувати пожежу, силачко? Аби побороти її?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATHGRITHR.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATHGRITHR.GENERIC"
msgid "Is very strong %s! Hello!"
msgstr "%s має багато сили! Привіт!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATHGRITHR.GHOST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATHGRITHR.GHOST"
msgid "World needs stronglady! Wolfgang will get heart!"
msgstr "Силачка потрібна світові! Вольфґанґ дістане серце!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATHGRITHR.MURDERER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATHGRITHR.MURDERER"
msgid "Stronglady %s is killer!"
msgstr "%s хоче смертельного двобою!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATHGRITHR.REVIVER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATHGRITHR.REVIVER"
msgid "%s is nice, strong lady."
msgstr "%s чудова, сильна людина."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATHGRITHRHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATHGRITHRHAT"
msgid "Is strong helm for strong warrior!"
msgstr "Міцний шолом для сильної воїнки!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATHGRITHR_IMPROVEDHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATHGRITHR_IMPROVEDHAT"
msgid "Ah yes, Stronglady hat. She not mind if Wolfgang wear?"
msgstr "О так, капелюх силачки. Вона ж не проти, якщо Вольфґанґ надіне?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATHGRITHR_SHIELD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WATHGRITHR_SHIELD"
msgid "Wolfgang only carry shield for accessorize."
msgstr "Для Вольфґанґа щит — не більше, ніж аксесуар."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAXED_PLANT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAXED_PLANT"
msgid "Poor plant is too scared to grow."
msgstr "Бідолашна рослинка надто налякана, щоб рости."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAXPAPER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAXPAPER"
msgid "Strange paper not for make scribblemarks."
msgstr "Дивний папір, не для каракулів."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAXWELL.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAXWELL.ATTACKER"
msgid "Does fragile %s want to fight? Ha ha! Is funny."
msgstr "Невже %s хоче бійки? А сили вистачить? Ха-ха! Як смішно."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAXWELL.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAXWELL.FIRESTARTER"
msgid "Is dastardly plan with fire, %s?"
msgstr "Якийсь підступний задум із підпалом, %s?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAXWELL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAXWELL.GENERIC"
msgid "Is tiny frailman, %s! Hello!"
msgstr "Це ж %s! Привіт! Тобі не завадить підкачатися!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAXWELL.GHOST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAXWELL.GHOST"
msgid "%s is friend of Wolfgang. He will get raw heart."
msgstr "%s — Вольфґанґовий друг. Отримає від мене сире серце."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAXWELL.MURDERER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAXWELL.MURDERER"
msgid "%s has not changed. Killer!"
msgstr "%s не думає змінюватися. Убивця!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAXWELL.REVIVER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAXWELL.REVIVER"
msgid "%s is one of us. Ha ha! Yes!"
msgstr "%s — наша людина. Ха-ха! Так!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAXWELLJOURNAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAXWELLJOURNAL.GENERIC"
msgid "Wolfgang is glad he cannot read!"
msgstr "Вольфґанґ радий, що не вміє читати!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WEBBER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WEBBER.ATTACKER"
msgid "Ah! Tiny child is try to fight me!"
msgstr "А-а! Малий хлопчина намагається битися зі мною!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WEBBER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WEBBER.FIRESTARTER"
msgid "Please no. Please no burnings!"
msgstr "Прошу, ні! Прошу, жодних підпалів!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WEBBER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WEBBER.GENERIC"
msgid "Is tiny monsterchild, %s! H-hello!"
msgstr "Це ж мале монстреня %s! П-привіт!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WEBBER.GHOST
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WEBBER.GHOST"
