msgid "only_used_by_willow"
msgstr "only_used_by_willow"

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CASTSPELL.TERRAFORM_TOO_SOON
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CASTSPELL.TERRAFORM_TOO_SOON"
msgid "only_used_by_wurt"
msgstr "only_used_by_wurt"

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CHANGEIN.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CHANGEIN.BURNING"
msgid "I guess I won't be changing again anytime soon."
msgstr "Схоже, найближчим часом я не перевдягатимуся."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CHANGEIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CHANGEIN.GENERIC"
msgid "What's the point."
msgstr "А який у цьому сенс."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CHANGEIN.INUSE
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CHANGEIN.INUSE"
msgid "I'd like to use that after you. If you don't mind, I mean."
msgstr "Наступною буду я. Ну, якщо ніхто не проти."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CHANGEIN.NOOCCUPANT
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CHANGEIN.NOOCCUPANT"
msgid "There's nothing here for me to groom..."
msgstr "Мені нема за ким тут доглядати..."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CHANGEIN.NOTENOUGHHAIR
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CHANGEIN.NOTENOUGHHAIR"
msgid "Perhaps once its fur grows in."
msgstr "Можливо, щойно в нього відросте хутро."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CHARGE_FROM.CHARGE_FULL
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CHARGE_FROM.CHARGE_FULL"
msgid "Full charge."
msgstr "Повний заряд."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CHARGE_FROM.NOT_ENOUGH_CHARGE
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CHARGE_FROM.NOT_ENOUGH_CHARGE"
msgid "It's dead."
msgstr "Позбавлено життя."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.COMPARE_WEIGHABLE.FISH_TOO_SMALL
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.COMPARE_WEIGHABLE.FISH_TOO_SMALL"
msgid "It was taken too soon..."
msgstr "Її забрали так рано..."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.COMPARE_WEIGHABLE.OVERSIZEDVEGGIES_TOO_SMALL
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.COMPARE_WEIGHABLE.OVERSIZEDVEGGIES_TOO_SMALL"
msgid "Mine is too small..."
msgstr "Моє надто мале..."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CONSTRUCT.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CONSTRUCT.EMPTY"
msgid "Nothing comes of nothing."
msgstr "Нічого не береться з нічого."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CONSTRUCT.INUSE
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CONSTRUCT.INUSE"
msgid "No one wants to share with me."
msgstr "Ніхто не бажає зі мною ділитись."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CONSTRUCT.MISMATCH
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CONSTRUCT.MISMATCH"
msgid "I can't do anything right."
msgstr "Я нічого не можу зробити до пуття."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CONSTRUCT.NOTALLOWED
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CONSTRUCT.NOTALLOWED"
msgid "It doesn't go there. I know the feeling."
msgstr "Воно тут зайве. Мені знайоме це відчуття."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CONSTRUCT.NOTREADY
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CONSTRUCT.NOTREADY"
msgid "Perhaps when my life is in slightly less peril."
msgstr "Може, коли моє життя буде трохи менш під загрозою."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.COOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.COOK.GENERIC"
msgid "Oh. No one ever taught me to cook."
msgstr "Ой. Ніхто ніколи не вчив мене готувати."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.COOK.INUSE
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.COOK.INUSE"
msgid "What are you making...? Smells good..."
msgstr "Що там готується?.. Пахне добре..."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.COOK.TOOFAR
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.COOK.TOOFAR"
msgid "It's so... far away..."
msgstr "Він так... далеко..."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.DECORATESNOWMAN.HASHAT
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.DECORATESNOWMAN.HASHAT"
msgid "I can't crush that poor hat."
msgstr "Не можу я збити того нещасного капелюха."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.DECORATESNOWMAN.INUSE
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.DECORATESNOWMAN.INUSE"
msgid "I won't interrupt."
msgstr "Не буду заважати."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.DECORATESNOWMAN.MELTING
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.DECORATESNOWMAN.MELTING"
msgid "It's no use. It's the end for this one."
msgstr "Немає сенсу. Йому вже кінець."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.DECORATESNOWMAN.STACKEDTOOHIGH
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.DECORATESNOWMAN.STACKEDTOOHIGH"
