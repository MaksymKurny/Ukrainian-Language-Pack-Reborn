msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SAPLING.GENERIC"
msgid "Puny tree! I am stronger than you!"
msgstr "Кволе дерево! Я сильніший за тебе!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SAPLING.PICKED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SAPLING.PICKED"
msgid "Ha! Ha! Ha! Tree is floppy!"
msgstr "Ха! Ха! Ха! Дерево ламке!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SAPLING.WITHERED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SAPLING.WITHERED"
msgid "Puny tree could not take heat."
msgstr "Кволе дерево не витримало спеки."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCANDATA
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCANDATA"
msgid "Is tiny boring paper."
msgstr "Крихітний нудний папірець."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCARECROW.BURNING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCARECROW.BURNING"
msgid "Little straw man is burning!"
msgstr "Малий солом'яний чоловічок горить!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCARECROW.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCARECROW.BURNT"
msgid "Little straw man is dead."
msgstr "Малий солом'яний чоловічок помер."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCARECROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCARECROW.GENERIC"
msgid "Ha! Is not man! Is straw!"
msgstr "Ха! Не чоловічок! Солома!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCORCHED_SKELETON
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCORCHED_SKELETON"
msgid "Wolfgang does not like this!!"
msgstr "Вольфґанґові це не до вподоби!!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCRAPBOOK_PAGE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCRAPBOOK_PAGE"
msgid "Is page of funny scribbles."
msgstr "Сторінка з кумедними каракулями."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCRAPHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCRAPHAT"
msgid "Looks better on Wolfgang!"
msgstr "Вольфґанґові пасує більше!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCRAP_MONOCLEHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCRAP_MONOCLEHAT"
msgid "Makes Wolfgang's sight as strong as his muscles!"
msgstr "Робить Вольфґанґовий зір так само сильним, як м'язи!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTINGTABLE.BLOCK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTINGTABLE.BLOCK"
msgid "Is time for arts and crafts!"
msgstr "Час для рукотворного мистецтва!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTINGTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTINGTABLE.BURNT"
msgid "Is burny bits."
msgstr "Спалені тріски."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTINGTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTINGTABLE.EMPTY"
msgid "Is table for rocks!"
msgstr "Столик для каменюк!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTINGTABLE.SCULPTURE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTINGTABLE.SCULPTURE"
msgid "Does not compare to chiseled jaw of Wolfgang!"
msgstr "Навіть не порівняти з кам'яними м'язами Вольфґанґа!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED"
msgid "Lumpy, bumpy rock!"
msgstr "Горбата, незграбна каменюка!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED"
msgid "Marble man is fixed!"
msgstr "Мармурового чоловічка відновлено!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_BISHOPBODY.READY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_BISHOPBODY.READY"
msgid "Stone is getting scarier!"
msgstr "Каменюка стає страшнішою!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED"
msgid "Strange little man was in big rock!"
msgstr "Дивний маленький чоловічок застряг у великій каменюці!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_BISHOPHEAD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_BISHOPHEAD"
msgid "Watch Wolfgang lift little marble head!"
msgstr "Дивіться, як Вольфґанґ підійматиме маленьку мармурову голову!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED"
msgid "Is big fancy rock!"
msgstr "Велика гарненька каменюка!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED"
msgid "Booboo is all better!"
msgstr "Бо-бо вже більше не бо-бо!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_KNIGHTBODY.READY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_KNIGHTBODY.READY"
msgid "Stone is getting scarier!"
msgstr "Каменюка стає страшнішою!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED"
msgid "Hidden marble man has big booboo."
msgstr "Схованому мармуровому чоловічку дуже бо-бо."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_KNIGHTHEAD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_KNIGHTHEAD"
msgid "Everyone! Watch Wolfgang carry horse head!"
msgstr "Агов, усі! Дивіться, як Вольфґанґ нестиме конячу голову!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_ROOKBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_ROOKBODY.COVERED"
msgid "Does not budge, even under Wolfgang's mighty strength!"
msgstr "Не рухається, навіть Вольфґанґова могутня сила не допомагає!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED"
msgid "Rock has all pieces now."
msgstr "Тепер усі частини каменюки на місці."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_ROOKBODY.READY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_ROOKBODY.READY"
msgid "Stone is getting scarier!"
msgstr "Каменюка стає страшнішою!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED"
msgid "Is many big rocks!"
msgstr "Купа великих каменюк!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_ROOKNOSE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SCULPTURE_ROOKNOSE"
msgid "Wolfgang will carry long rock, is no problem!"
msgstr "Вольфґанґ нестиме довгу каменюку. Жодних проблем!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SEAFARING_PROTOTYPER.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SEAFARING_PROTOTYPER.BURNT"
msgid "Is burny stuff now."
msgstr "Штука згоріла."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC"
msgid "Wolfgang need help thinking on scary water."
msgstr "Вольфґанґові потрібна допомога, аби досліджувати страшні води."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SEAFOODGUMBO
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SEAFOODGUMBO"
msgid "This will make very strong Wolfgang!"
msgstr "Це зробить Вольфґанґа дуже сильним!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SEASTACK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SEASTACK"
msgid "Is a big watery rock."
msgstr "Велика морська каменюка."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SECURITY_PULSE_CAGE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SECURITY_PULSE_CAGE"
msgid "Is too small for Wolfgang to hide in. Not that Wolfgang need to hide."
msgstr "Замалий, Вольфґанґові не сховатися. Не те щоб Вольфґанґові це було треба."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SECURITY_PULSE_CAGE_FULL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SECURITY_PULSE_CAGE_FULL"
msgid "Glowing ball of energy not explode, right?"
msgstr "Сяйниста куля енергії не вибухне ж, правда?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SEEDPOUCH
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SEEDPOUCH"
msgid "Is small pack for seeds."
msgstr "Маленький рюкзачок для насіння."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SEEDS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SEEDS"
msgid "Too small to eat."
msgstr "Замале, щоб їсти."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SEEDS_COOKED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SEEDS_COOKED"
msgid "Fire make bigger, can eat now."
msgstr "Тепер велике після вогню, можна їсти."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SENTRYWARD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SENTRYWARD"
msgid "Wolfgang thinks is full of secrets."
msgstr "Вольфґанґ гадає, що він повен таємниць."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SEWING_KIT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SEWING_KIT"
msgid "Is pokey!"
msgstr "Колеться!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SEWING_MANNEQUIN.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SEWING_MANNEQUIN.BURNT"
msgid "Cloth man has even less to say now."
msgstr "Тепер одягайло взагалі не заговорить."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SEWING_MANNEQUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SEWING_MANNEQUIN.GENERIC"
msgid "Cloth man does not have much to say."
msgstr "Одягайло не багатослівний."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SEWING_TAPE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SEWING_TAPE"
msgid "Is sticky and good for mending!"
msgstr "Липка й чудово підходить для штопання!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOWDANCER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOWDANCER"
msgid "Yes!! Dance tiny man, dance!"
msgstr "Так!! Танцюй, чоловічку, танцюй!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOWDIGGER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOWDIGGER"
msgid "Ha ha! Tiny men should dance for amusement!"
msgstr "Ха-ха! Крихітні чоловічки мають танцювати нам на втіху!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOWHEART
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOWHEART"
msgid "Wolfgang is not shaking! Is manly flexing!!"
msgstr "Вольфґанґ не трясеться! Він мужньо грає м'язами!!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOWRIFT_PORTAL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOWRIFT_PORTAL"
msgid "Wolfgang will be very careful not to fall into that."
msgstr "Вольфґанґ буде дуже обережним, не впаде туди."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOWTHRALL_CENTIPEDE.BODY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOWTHRALL_CENTIPEDE.BODY"
msgid "Hm. It have strong core."
msgstr "Гм. Має міцне тіло."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOWTHRALL_CENTIPEDE.FLIPPED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOWTHRALL_CENTIPEDE.FLIPPED"
msgid "Ha! Not so tough now!"
msgstr "Ха! Вже не такий грізний!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOWTHRALL_CENTIPEDE.HEAD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOWTHRALL_CENTIPEDE.HEAD"
msgid "Which face do Wolfgang punch?"
msgstr "Яку з пик Вольфґанґові слід натовкти?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOWTHRALL_HANDS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOWTHRALL_HANDS"
msgid "Creepy shadow wants to arm wrestle?"
msgstr "Моторошна тінь хоче поборотися на руках?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOWTHRALL_HORNS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOWTHRALL_HORNS"
msgid "Eep! Wolfgang's muscles are too tough for chewing!"
msgstr "А-а-а! Вольфґанґові м'язи зажорсткі, їх не пожуєш!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOWTHRALL_MOUTH
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOWTHRALL_MOUTH"
msgid "That smile make Wolfgang uncomfortable."
msgstr "Через цю посмішку Вольфґанґові незатишно."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOWTHRALL_PARASITE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOWTHRALL_PARASITE"
msgid "Just stay away from Wolfgang, okay?"
msgstr "Просто тримайся подалі від Вольфґанґа, добре?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOWTHRALL_WINGS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOWTHRALL_WINGS"
msgid "Scary flapper!"
msgstr "Страшний літун!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOW_BATTLEAXE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOW_BATTLEAXE"
msgid "Does axe have to be so scary?"
msgstr "Хіба сокира має бути такою страшною?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOW_BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOW_BEEF_BELL"
msgid "Can bring back Wolfgang hair-cow?"
msgstr "Зможе повернути Вольфґанґові волохату корову?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOW_FORGE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOW_FORGE"
msgid "Creepy hands make things for Wolfgang."
msgstr "Моторошні руки роблять усе за Вольфґанґа."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOW_FORGE_KIT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOW_FORGE_KIT"
msgid "Is almost done!"
msgstr "Майже готово!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOW_HEART_VEIN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHADOW_HEART_VEIN"
msgid "Haha! Not as mighty as Wolfgang biceps vein!"
msgstr "Ха-ха! Не такий могутній, як вена на Вольфґанґовому біцепсі!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHALLOW_GRAVE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHALLOW_GRAVE"
msgid "Wolfgang will remember you."
msgstr "Вольфґанґ тебе пам'ятатиме."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHARK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHARK"
msgid "Eep! Wolfgang's muscles too tough for eating!"
msgstr "А-а-а! Вольфґанґові м'язи зажорсткі, їх не проковтнеш!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHARKBOI
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHARKBOI"
msgid "Wolfgang is stronger than any fish!"
msgstr "Вольфґанґ сильніший за будь-яку рибину!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHELLWEAVER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHELLWEAVER"
msgid "Careful with prickly lid!"
msgstr "Обережно, не вколіться кришкою!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHELL_CLUSTER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHELL_CLUSTER"
msgid "Wolfgang will break it open with own mighty fists!"
msgstr "Вольфґанґ потрощить їх власними могутніми кулаками!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHIELDOFTERROR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHIELDOFTERROR"
msgid "Haha! Now big scary teeth belong to Wolfgang!"
msgstr "Ха-ха! Тепер великі страшні зубиська належать Вольфґанґові!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHOVEL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHOVEL"
msgid "Dirt spoon!"
msgstr "Ложка для грязюки!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHOVEL_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHOVEL_LUNARPLANT"
msgid "But is not shoe? Wolfgang is confused..."
msgstr "Як квіточки можуть блищати? Вольфґанґ не розуміє..."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHROOMBAIT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHROOMBAIT"
msgid "Does not look tasty to Wolfgang."
msgstr "Вольфґанґові він здається не дуже апетитним."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHROOMCAKE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHROOMCAKE"
msgid "Wolfgang will eat whole cake!"
msgstr "Вольфґанґ з'їсть увесь торт!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHROOM_SKIN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SHROOM_SKIN"
msgid "Is squishy yucky frogman skin!"
msgstr "М'яка, бридка шкіра жабиська!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SIESTAHUT.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SIESTAHUT.BURNT"
msgid "Napping place is gone."
msgstr "Дрімальня згоріла."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SIESTAHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SIESTAHUT.GENERIC"
msgid "Napping place."
msgstr "Дрімальня."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SILK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SILK"
msgid "Is too fancy."
msgstr "Надто гарне."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SINGINGSHELL_OCTAVE3.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SINGINGSHELL_OCTAVE3.GENERIC"
msgid "Is mighty singing shell!"
msgstr "Могутня співоча мушля!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC"
msgid "Is singing shell?"
msgstr "Співоча мушля?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC"
msgid "Is wimpy small singing shell."
msgstr "Слабка мала співоча мушля."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SISTURN.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SISTURN.GENERIC"
msgid "Is like tiny house for bird! But why is little pot here?"
msgstr "Наче малесенький будиночок для пташок! Але навіщо тут маленький горщик?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SISTURN.LOTS_OF_FLOWERS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SISTURN.LOTS_OF_FLOWERS"
msgid "Wolfgang like the flowers, but why is little pot floating?"
msgstr "Вольфґанґові до вподоби квіточки, але чому маленький горщик літає?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_BLOSSOM"
msgid "What that spooky sound?"
msgstr "Що це за моторошний звук?"

