#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD"
msgid "Why you not hiding like other kitties?"
msgstr "Чому ти не ховаєшся, як інші кошенятка?"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1"
msgid "Here, Wolfgang found kitty kitty!"
msgstr "Ось, Вольфґанґ знайшов кошенятко!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2"
msgid "Wolfgang finds tiny kitties too easy!"
msgstr "Вольфґанґ знаходить маленьких кошенят так легко!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3"
