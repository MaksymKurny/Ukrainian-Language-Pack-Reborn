msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ENCUMBERED.6"
msgid "Ha ha...! Weight... is nothing!"
msgstr "Ха-ха!.. Вага... геть ніяка!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ENCUMBERED.7
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ENCUMBERED.7"
msgid "Little stone... cannot stop Wolfgang!"
msgstr "Маленький камінчик... не може зупинити Вольфґанґа!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ENCUMBERED.8
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ENCUMBERED.8"
msgid "Hngh...!"
msgstr "Гр-р-р!.."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ENCUMBERED.9
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ENCUMBERED.9"
msgid "Witness... Wolfgang strength!"
msgstr "Станьте свідками... Вольфґанґової сили!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ENGINEERING_CAN_UPGRADE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ENGINEERING_CAN_UPGRADE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ENTER_DARK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ENTER_DARK"
msgid "I cannot see! I am scared!"
msgstr "Я не бачу! Мені страшно!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ENTER_LIGHT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_ENTER_LIGHT"
msgid "I can see again!"
msgstr "Я знову бачу!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_EXITGYM.MIGHTY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_EXITGYM.MIGHTY"
msgid "Hah! Wolfgang feel back to old self!"
msgstr "Ха! Вольфґанґ почувається колишнім собою!"

