#. STRINGS.SKIN_DESCRIPTIONS.profileflair_victorian_pigeon
msgctxt "STRINGS.SKIN_DESCRIPTIONS.profileflair_victorian_pigeon"
msgid "Set your profile icon to a curious city pigeon."
msgstr "Встановіть допитливого міського голуба як значок свого профілю."

#. STRINGS.SKIN_DESCRIPTIONS.profileflair_victorian_safe
msgctxt "STRINGS.SKIN_DESCRIPTIONS.profileflair_victorian_safe"
