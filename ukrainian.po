msgstr "В'ялися! В'ялися!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN"
