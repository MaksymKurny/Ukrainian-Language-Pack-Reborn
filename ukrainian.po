msgstr "Вольфґанґ заколе багато ворогів!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPEAR_LANCE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPEAR_LANCE"
msgid "Wolfgang likes swirly stab-stick."
msgstr "Вольфґанґові до вподоби закручена палка-вбивалка."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPEAR_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.SPEAR_WATHGRITHR"
