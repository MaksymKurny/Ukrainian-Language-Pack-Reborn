msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_37"
msgid "Stab-stick is useless now."
msgstr "Палка-вбивалка стала мотлохом."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_38
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_38"
msgid "Is making tiny friends look tinier!"
msgstr "У ньому маленькі друзі стають ще менші!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_39
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_39"
msgid "Is just one glove."
msgstr "Просто одна рукавичка."

