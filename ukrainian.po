msgstr "Ха-ха! Крихітний чоловічок!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_40
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_40"
