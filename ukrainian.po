msgstr "Вольфґанґові не потрібне крихітне сміття."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_41
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_41"
msgid "Wolfgang will crush it!"
msgstr "Вольфґанґ розтрощить її!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_42
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_42"
msgid "Is tiny scary thing."
msgstr "Крихітна страшна штука."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_43
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_43"
msgid "Is tiny toy monster."
msgstr "Маленький іграшковий монстрик."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_44
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_44"
msgid "Is very broke."
msgstr "Дуже зламаний."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_45
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_45"
msgid "Wolfgang can barely hear this."
msgstr "Вольфґанґ заледве його чує."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_46
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_46"
msgid "Is useless thing, I think."
msgstr "Непотріб, гадаю."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_5
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_5"
msgid "What is do?"
msgstr "Для чого це?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_6
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_6"
msgid "Robot bits."
msgstr "Шматочки робота."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_7
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_7"
