msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COSTUME_PRINCESS_BODY"
msgid "Is for horsey princess."
msgstr "Це для принцеси-конячки."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COSTUME_QUEEN_BODY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.COSTUME_QUEEN_BODY"
msgid "Can tiny costume fit over Wolfgang's muscles?"
msgstr "Чи налізе крихітний костюмчик на Вольфґанґові м'язи?"

