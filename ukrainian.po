msgstr "Для тих, кому тепло цінніше за друзів."

#. STRINGS.RECIPE_DESC.CATTOY_MOUSE
msgctxt "STRINGS.RECIPE_DESC.CATTOY_MOUSE"
msgid "Start a game of cat and mouse."
msgstr "Розпочніть гру в кота і мишу."

#. STRINGS.RECIPE_DESC.CHESSPIECE_ANCHOR_BUILDER
msgctxt "STRINGS.RECIPE_DESC.CHESSPIECE_ANCHOR_BUILDER"
