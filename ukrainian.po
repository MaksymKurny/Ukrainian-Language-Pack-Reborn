msgstr "Вони такі ситні!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BERRYBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BERRYBUSH.BARREN"
