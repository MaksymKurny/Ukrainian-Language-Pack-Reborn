msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_EXITGYM.NORMAL"
msgid "Hmm muscles feel better, but could be stronger!"
msgstr "Гм-м, у м'язах є сила, проте я можу бути ще сильнішим!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_EXITGYM.WIMPY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_EXITGYM.WIMPY"
msgid "Wolfgang is just needing... a bit of rest..."
msgstr "Вольфґанґові просто потрібно... трошки відпочити..."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_EXIT_GELBLOB
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_EXIT_GELBLOB"
msgid "That is no place for Wolfgang."
msgstr "Тут Вольфґанґові не місце."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_EYEOFTERROR_ARRIVE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_EYEOFTERROR_ARRIVE"
msgid "Wolfgang no like the look of that!"
msgstr "Вольфґанґові це зовсім не до вподоби!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_EYEOFTERROR_FLYAWAY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_EYEOFTERROR_FLYAWAY"
msgid "Big scary eye scared of daylight? Ha ha ha!"
msgstr "Велике страшне око боїться денного світла? Ха-ха-ха!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_EYEOFTERROR_FLYBACK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_EYEOFTERROR_FLYBACK"
msgid "Wolfgang stronger and braver now!"
msgstr "Вольфґанґ тепер сильніший та хоробріший!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_FAN_OUT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_FAN_OUT"
msgid "Tiny fan is broken!"
msgstr "Вітрячок зламався!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_FERTILIZER_RESEARCHED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_FERTILIZER_RESEARCHED"
msgid "Wolfgang is learning much about stinky plant food."
msgstr "Вольфґанґ дізнається багато нового про смердючу їжу для рослин."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_FIRENETTLE_TOXIN.1
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_FIRENETTLE_TOXIN.1"
msgid "Burny! Wolfgang not like!"
msgstr "Пече! Вольфґанґові не до вподоби!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_FIRENETTLE_TOXIN.2
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_FIRENETTLE_TOXIN.2"
msgid "Puny plant has poisoned Wolfgang!"
msgstr "Хирлява рослинка отруїла Вольфґанґа!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_FIRENETTLE_TOXIN_DONE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_FIRENETTLE_TOXIN_DONE"
