msgstr "Данина холоднокровному розбишаці."

#. STRINGS.RECIPE_DESC.CHESSPIECE_STALKER_BUILDER
msgctxt "STRINGS.RECIPE_DESC.CHESSPIECE_STALKER_BUILDER"
