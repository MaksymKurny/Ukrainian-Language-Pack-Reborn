msgstr "Пахне досить смачно."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MERMCORPSE.GENERIC"
