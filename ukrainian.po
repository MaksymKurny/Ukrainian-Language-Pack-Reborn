msgstr "Крихітного павучка розчавлять Вольфґанґові могутні щелепи! Або, можливо, ні."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUTATOR_SPITTER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUTATOR_SPITTER"
msgid "Tiny spider will be crushed in Wolfgang's mighty jaws! Or maybe not."
msgstr "Крихітного павучка розчавлять Вольфґанґові могутні щелепи! Або, можливо, ні."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUTATOR_WARRIOR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUTATOR_WARRIOR"
msgid "Tiny spider will be crushed in Wolfgang's mighty jaws! Or maybe not."
msgstr "Крихітного павучка розчавлять Вольфґанґові могутні щелепи! Або, можливо, ні."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUTATOR_WATER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MUTATOR_WATER"
msgid "Tiny spider will be crushed in Wolfgang's mighty jaws! Or maybe not."
msgstr "Крихітного павучка розчавлять Вольфґанґові могутні щелепи! Або, можливо, ні."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NATURE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NATURE_BLUEPRINT"
msgid "Flowers would be good against cow smell."
msgstr "Квіточки добре приховають коров'ячий сморід."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTCAPHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTCAPHAT"
msgid "Is cozy sleeping hat."
msgstr "Затишний капелюшок для сну."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTLIGHT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTLIGHT"
msgid "Is strange glow."
msgstr "Дивне сяйво."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMAREFUEL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMAREFUEL"
msgid "Scary stuff."
msgstr "Страшна штука."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMAREGROWTH
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMAREGROWTH"
msgid "Wolfgang feels chill crawling up mighty spine..."
msgstr "Вольфґанґ відчуває, як холодок пробирає до могутніх кісток..."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARELIGHT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARELIGHT"
msgid "Is light, but not good light."
msgstr "Це світло, але недобре світло."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMAREPIE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMAREPIE"
msgid "Wolfgang must eat with eyes closed."
msgstr "Вольфґанґ повинен їсти із заплющеними очима."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM"
msgid "No bad light."
msgstr "Нема поганого світла."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN"
msgid "Good time is soon."
msgstr "Добрий час близько."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC"
msgid "Is safe from bad light."
msgstr "У безпеці від поганого світла."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY"
msgid "I think bad light not get stronger."
msgstr "Гадаю, погане світло не сильнішає."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING"
msgid "Bad light time is ending."
msgstr "Час поганого світла спливає."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN"
msgid "The bad light comes soon."
msgstr "Погане світло скоро прийде."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING"
msgid "The bad light is here and getting stronger."
msgstr "Погане світло вже тут і сильнішає."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTSTICK"
msgid "Wolfgang like fists better."
msgstr "Вольфґанґові значно більше подобаються кулаки."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTSWORD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NIGHTSWORD"
msgid "Is real? Is not real? Is sharp!"
msgstr "Справжній? Несправжній? Гострий!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NITRE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NITRE"
msgid "Is rock, but different."
msgstr "Камінець, але інакший."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NITRE_FORMATION
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NITRE_FORMATION"
msgid "It grew from burny rain?"
msgstr "Воно росте від пекучого дощу?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NONSLIPGRIT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NONSLIPGRIT"
msgid "Wolfgang never slip! But just in case."
msgstr "Вольфґанґ ніколи не послизнеться! Але про всяк випадок візьме."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NONSLIPGRITBOOSTED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NONSLIPGRITBOOSTED"
msgid "Wolfgang use for clumsy friends."
msgstr "Вольфґанґ допоможе незграбним друзям."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NUTRIENTSGOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.NUTRIENTSGOGGLESHAT"
msgid "Fills Wolfgang's head with the plant know-hows!"
msgstr "Наповнює Вольфґанґову голову розумними штуками про рослини!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OAR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OAR"
msgid "Wolfgang will be mighty rower!"
msgstr "Вольфґанґ буде могутнім веслярем!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OAR_DRIFTWOOD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OAR_DRIFTWOOD"
msgid "Oar feels so light in Wolfgang's mighty hands!"
msgstr "Весло відчувається таким легким у Вольфґанґових могутніх руках!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OAR_MONKEY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OAR_MONKEY"
msgid "Wolfgang is pretty sure that is not right way to use paddle."
msgstr "Вольфґанґ упевнений, що не так потрібно використовувати весло."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OASISLAKE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OASISLAKE.EMPTY"
msgid "Lake should be here!"
msgstr "Озеро ж мало бути тут!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OASISLAKE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OASISLAKE.GENERIC"
msgid "Splishes and splashes."
msgstr "Плесь-плесь та хлюп-хлюп."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHABLEFLOTSAM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHABLEFLOTSAM"
msgid "Is just lump of mud?"
msgstr "Просто купка бруду?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGBOBBER_BALL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGBOBBER_BALL"
msgid "Float well, tiny bobber!"
msgstr "Гарно тримайся, маленький поплавцю!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGBOBBER_CANARY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGBOBBER_CANARY"
msgid "Feather of yellow bird float well on water!"
msgstr "Перо жовтої пташки гарно тримається на воді!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGBOBBER_CROW
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGBOBBER_CROW"
msgid "Feather of crow float well on water!"
msgstr "Перо ворони гарно тримається на воді!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGBOBBER_GOOSE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGBOBBER_GOOSE"
msgid "Wolfgang use big feather to catch big fish!"
msgstr "Вольфґанґ використає велике перо, щоб зловити велику рибу!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGBOBBER_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGBOBBER_MALBATROSS"
msgid "Wolfgang use big feather to catch big fish!"
msgstr "Вольфґанґ використає велике перо, щоб зловити велику рибу!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGBOBBER_NONE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGBOBBER_NONE"
msgid "Need something to fish better."
msgstr "Потрібно щось, аби краще рибалити."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGBOBBER_OVAL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGBOBBER_OVAL"
msgid "Float well, tiny bobber!"
msgstr "Гарно тримайся, маленький поплавцю!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGBOBBER_ROBIN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGBOBBER_ROBIN"
msgid "Feather of red bird float well on water!"
msgstr "Перо червоної пташки гарно тримається на воді!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGBOBBER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGBOBBER_ROBIN_WINTER"
msgid "Feather of winter bird float well on water!"
msgstr "Перо зимової пташки гарно тримається на воді!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGLURE_HERMIT_DROWSY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGLURE_HERMIT_DROWSY"
msgid "Ha! It make fish stupid!"
msgstr "Ха! Завдяки їй риба дурнішає!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGLURE_HERMIT_HEAVY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGLURE_HERMIT_HEAVY"
msgid "Wolfgang will show all how to catch biggest fish!"
msgstr "Вольфґанґ покаже всім, як ловити найбільшу рибу!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGLURE_HERMIT_RAIN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGLURE_HERMIT_RAIN"
msgid "For fishing when raining."
msgstr "Для риболовлі, коли дощить."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGLURE_HERMIT_SNOW
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGLURE_HERMIT_SNOW"
msgid "For fishing when is snow outside."
msgstr "Для риболовлі, коли сніжить."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGLURE_SPINNER_BLUE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGLURE_SPINNER_BLUE"
msgid "Is tiny fish bait."
msgstr "Крихітна приманка для риби."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGLURE_SPINNER_GREEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGLURE_SPINNER_GREEN"
msgid "Is tiny fish bait."
msgstr "Крихітна приманка для риби."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGLURE_SPINNER_RED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGLURE_SPINNER_RED"
msgid "Is tiny fish bait."
msgstr "Крихітна приманка для риби."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGLURE_SPOON_BLUE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGLURE_SPOON_BLUE"
msgid "Is tiny fish bait."
msgstr "Крихітна приманка для риби."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGLURE_SPOON_GREEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGLURE_SPOON_GREEN"
msgid "Is tiny fish bait."
msgstr "Крихітна приманка для риби."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGLURE_SPOON_RED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGLURE_SPOON_RED"
msgid "Is tiny fish bait."
msgstr "Крихітна приманка для риби."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGROD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISHINGROD"
msgid "Strong rod to catch mighty fish!"
msgstr "Сильна вудка, аби ловити могутню рибу!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_MEDIUM_1
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_MEDIUM_1"
msgid "Don't like way its buggy eyes stare."
msgstr "Не подобається мені, як витріщаються ці замулені очі."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_MEDIUM_2
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_MEDIUM_2"
msgid "Aha! Big fish for dinner!"
msgstr "Ага! Велика рибина на вечерю!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_MEDIUM_3
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_MEDIUM_3"
msgid "This fish very pokey."
msgstr "Ця рибина дуже колюча."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_MEDIUM_4
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_MEDIUM_4"
msgid "Wolfgang doesn't want bad luck!"
msgstr "Вольфґанґ не хоче накликати невдачу!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_MEDIUM_5
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_MEDIUM_5"
msgid "Haha! Is corn and fish!"
msgstr "Ха-ха! Рибина й кукурудза!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_MEDIUM_6
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_MEDIUM_6"
msgid "Is mighty fish!"
msgstr "Могутня риба!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_MEDIUM_7
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_MEDIUM_7"
msgid "Is mighty fish!"
msgstr "Могутня риба!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_MEDIUM_8
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_MEDIUM_8"
msgid "Brrr, gives Wolfgang the chills."
msgstr "Бр-р-р, Вольфґанґ увесь тремтить."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_MEDIUM_9
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_MEDIUM_9"
msgid "Pretty purple fishy."
msgstr "Гарненька фіолетова риба."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_SMALL_1
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_SMALL_1"
msgid "Fish is puny!"
msgstr "Мізерна рибка!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_SMALL_2
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_SMALL_2"
msgid "Is tiny fish!"
msgstr "Крихітна рибинка!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_SMALL_3
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_SMALL_3"
msgid "Wolfgang could eat in one bite!"
msgstr "Вона Вольфґанґові на один укус!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_SMALL_4
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_SMALL_4"
msgid "Is small and weak fish."
msgstr "Маленька та слабка рибка."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_SMALL_5
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_SMALL_5"
msgid "Would make good snack for Wolfgang."
msgstr "Буде гарною закускою для Вольфґанґа."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_SMALL_6
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_SMALL_6"
msgid "Has creepy flat face, Wolfgang not like."
msgstr "Має моторошне пласке обличчя, Вольфґанґові не до вподоби."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_SMALL_7
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_SMALL_7"
msgid "Oh, is nice little flower fish."
msgstr "О, гарненька маленька рибка-квітка."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_SMALL_8
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_SMALL_8"
msgid "Is strange burny fish."
msgstr "Дивна пекуча риба."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_SMALL_9
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANFISH_SMALL_9"
msgid "Funny little spit fish."
msgstr "Смішна маленька риба-плювака."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANTREE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANTREE"
msgid "What is tree doing way out here?"
msgstr "Що дерево робить аж отут?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANTREENUT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANTREENUT"
msgid "Is heavy, but not too heavy for Wolfgang!"
msgstr "Важкий, але не заважкий для Вольфґанґа!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANTREE_PILLAR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANTREE_PILLAR"
msgid "Wolfgang make mighty tree of his own!"
msgstr "Вольфґанґ самотужки виростив могутнє дерево!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANVINE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANVINE"
msgid "AAAH-- oh. Wolfgang thought was snake."
msgstr "А-А-А-А... Ой. Вольфґанґ подумав, що то змія."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANVINE_COCOON
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANVINE_COCOON"
msgid "Wolfgang not like look of that..."
msgstr "Вольфґанґові це не до вподоби..."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANVINE_COCOON_BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANVINE_COCOON_BURNT"
msgid "Hmm, Wolfgang smell burnt spiders."
msgstr "Гм-м, Вольфґанґ чує запах горілих павуків."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANWHIRLBIGPORTALEXIT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANWHIRLBIGPORTALEXIT"
msgid "Any goodies for Wolfgang in sea garbage pile?"
msgstr "Купка морського сміття має щось гарненьке для Вольфґанґа?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANWHIRLPORTAL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEANWHIRLPORTAL"
msgid "Wolfgang does not run! He makes courageous escape!"
msgstr "Вольфґанґ не тікає! Він мужньо відступає!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEAN_TRAWLER.CAUGHT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEAN_TRAWLER.CAUGHT"
msgid "Net is full of fish, like Wolfgang's belly will be!"
msgstr "У сітці повно риби... а невдовзі буде повно у Вольфґанґовому животі!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEAN_TRAWLER.ESCAPED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEAN_TRAWLER.ESCAPED"
msgid "Net is empty... like Wolfgang's belly..."
msgstr "Сіть порожня... Як і Вольфґанґовий животик..."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEAN_TRAWLER.FIXED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEAN_TRAWLER.FIXED"
msgid "Net is ready for catching of fishies."
msgstr "Сіть готова ловити рибу."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEAN_TRAWLER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEAN_TRAWLER.GENERIC"
msgid "Will help with the fishing, yes?"
msgstr "Допоможе із риболовлею, еге ж?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEAN_TRAWLER.LOWERED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEAN_TRAWLER.LOWERED"
msgid "Wolfgang hope it catches many fish."
msgstr "Вольфґанґ сподівається наловити багато риби."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEAN_TRAWLER_KIT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OCEAN_TRAWLER_KIT"
msgid "Will build quick, Wolfgang want fish for dinner!"
msgstr "Збудую швидко! Вольфґанґ хоче повечеряти рибою!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OFFERING_POT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OFFERING_POT.GENERIC"
msgid "Bowl is empty? Poor fish men must be hungry..."
msgstr "Миска порожня? Бідолашні рибані, мабуть, голодні..."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OFFERING_POT.LOTS_OF_KELP
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OFFERING_POT.LOTS_OF_KELP"
msgid "Eat, fish men! Grow big and strong like Wolfgang!"
msgstr "Їжте, рибиська! Зростайте великими та сильними, як Вольфґанґ!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OFFERING_POT.SOME_KELP
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OFFERING_POT.SOME_KELP"
msgid "Wolfgang will find more sea spinach to fill their bellies!"
msgstr "Вольфґанґ знайде ще морського шпинату, щоб наповнити їхні животи!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OFFERING_POT_UPGRADED.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OFFERING_POT_UPGRADED.GENERIC"
msgid "Bowl is empty? Poor fish men must be hungry..."
msgstr "Миска порожня? Бідолашні рибані, мабуть, голодні..."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OFFERING_POT_UPGRADED.LOTS_OF_KELP
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OFFERING_POT_UPGRADED.LOTS_OF_KELP"
msgid "Eat, fish men! Grow big and strong like Wolfgang!"
msgstr "Їжте, рибиська! Зростайте великими та сильними, як Вольфґанґ!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OFFERING_POT_UPGRADED.SOME_KELP
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OFFERING_POT_UPGRADED.SOME_KELP"
msgid "Wolfgang will find more sea spinach to fill their bellies!"
msgstr "Вольфґанґ знайде ще морського шпинату, щоб наповнити їхні животи!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ONEMANBAND
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ONEMANBAND"
msgid "Is big and loud. I like!"
msgstr "Великий та гучний. Мені до вподоби!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ONION
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ONION"
msgid "Wolfgang eats like apple when not cooking."
msgstr "Вольфґанґ їсть їх, наче яблука, коли не готує."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ONION_COOKED"
msgid "Crispy, brown, sweet."
msgstr "Хрумка, коричнева, солодка."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ONION_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ONION_OVERSIZED"
msgid "Onion is good for you! Big ones even better!"
msgstr "Цибуля корисна! А величезна цибуля іще корисніша!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ONION_SEEDS"
msgid "Is little tiny seeds for burying."
msgstr "Крихітні насінини для висаджування."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OPALPRECIOUSGEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OPALPRECIOUSGEM"
msgid "Is very nice little stone."
msgstr "Дуже гарний маленький камінчик."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OPALSTAFF
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.OPALSTAFF"
msgid "Tiny stick make big cold!"
msgstr "Маленька паличка створює велику холоднечу!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ORANGEAMULET
