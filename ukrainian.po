msgstr "Ха! Нікчемна отрута рослини довго не протрималася у могутньому Вольфґанґовому тілі!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_FLARE_SEEN"
msgid "Sky fire! Wolfgang is coming, dear friend!"
msgstr "Вогонь у небі! Вольфґанґ уже в дорозі, любий друже!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_FLOATER_HELD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_FLOATER_HELD"
msgid "Wolfgang unsinkable!"
msgstr "Вольфґанґ непотопний!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_FLOATER_LETGO
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_FLOATER_LETGO"
msgid "Oopsie!"
msgstr "Ой-йой!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_FLOAT_SWIM_TIRED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_FLOAT_SWIM_TIRED"
msgid "Wolfgang just need a second."
msgstr "Дайте Вольфґанґові хвильку перепочити."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_FOODMEMORY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_FOODMEMORY"
msgid "only_used_by_warly"
msgstr "only_used_by_warly"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_FREEDOM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_FREEDOM"
msgid "I am free! Strong freedom!"
msgstr "Я вільний! Сила на свободі!"

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_GATHER_MERM
