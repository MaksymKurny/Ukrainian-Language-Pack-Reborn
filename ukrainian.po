msgstr "Вольфґанґові не потрібен захист."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMORDREADSTONE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMORDREADSTONE"
msgid "Wolfgang doesn't need scary rock armor!"
msgstr "Вольфґанґові не потрібна страшна кам'яна броня!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMORGRASS"
msgid "Is prickly."
msgstr "Колеться."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMORMARBLE"
msgid "Tie rocks to many muscles."
msgstr "Прив'язав камені до купи м'язів."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMORRUINS"
msgid "Protect me? I don't need it!"
msgstr "Захищати? Мене? Мені він не треба!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMORSKELETON"
msgid "Is scary strong bones."
msgstr "Страшні, міцні кістки."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMORSLURPER"
msgid "Is causing hunger or stopping it?"
msgstr "Викликає голод чи стримує його?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMORSNURTLESHELL"
msgid "Is sticky inside."
msgstr "Всередині липкий."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMORWAGPUNK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMORWAGPUNK"
msgid "Wolfgang not need robot armor for protection, only like it for color."
msgstr "Вольфґанґові не потрібна броня робота, аби захищатися, йому просто колір до вподоби."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMORWOOD"
msgid "Is almost strong as belly!"
msgstr "Майже так само міцний, як живіт!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMOR_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMOR_BRAMBLE"
msgid "Mighty Wolfgang does not need armor!"
msgstr "Могутньому Вольфґанґові не потрібна броня!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMOR_CARROTLURE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMOR_CARROTLURE"
msgid "Looks healthy."
msgstr "На вигляд корисний."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMOR_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMOR_LUNARPLANT"
msgid "Tough, like Wolfgang!"
msgstr "Стійка, як Вольфґанґ!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMOR_LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMOR_LUNARPLANT_HUSK"
msgid "Only for leafy friend? Too small for Wolfgang muscles anyway."
msgstr "Тільки для листочка-дружочка? Все одно замала для Вольфґанґових м'язів."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMOR_SANITY"
msgid "Is like wearing scary little rag!"
msgstr "Наче ношу страшну малу ганчірку!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMOR_VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMOR_VOIDCLOTH"
msgid "Creepy shirt is happy to be worn by Wolfgang."
msgstr "Моторошна сорочка рада, що її носить Вольфґанґ."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMOR_YOTH_KNIGHT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARMOR_YOTH_KNIGHT"
msgid "Ooh... Sir Wolfgang!"
msgstr "О-о-о... сер Вольфґанґ!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "Sign can't be read."
msgstr "Табличку вже не прочитаєш."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "Is no time for reading signs!"
msgstr "Не час читати таблички!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "Practice my letters!"
msgstr "Потренуюся писати літери!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "Sign can't be read."
msgstr "Табличку вже не прочитаєш."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "Is no time for reading signs!"
msgstr "Не час читати таблички!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "Practice my letters!"
msgstr "Потренуюся писати літери!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ASH.GENERIC"
msgid "Is skeleton of fire."
msgstr "Скелет вогню."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "Is burned pieces of eyebone from teleport!"
msgstr "Залишки згорілого кістяного ока після телепортації!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "Is burned pieces of flower from teleport!"
msgstr "Залишки згорілої квітки після телепортації!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "Is burned pieces of some thing. Is dead now..."
msgstr "Залишки згорілого чогось. Тепер уже мертвого..."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ASPARAGUS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ASPARAGUS"
msgid "Wolfgang always eat his vegetables."
msgstr "Вольфґанґ завжди їсть свої овочі."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ASPARAGUSSOUP
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ASPARAGUSSOUP"
msgid "Is warm in Wolfgang's belly."
msgstr "Гріє Вольфґанґовий животик."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ASPARAGUS_COOKED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ASPARAGUS_COOKED"
msgid "Vegetables make me big and strong."
msgstr "Овочі роблять мене великим і сильним."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ASPARAGUS_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ASPARAGUS_OVERSIZED"
msgid "Big vegetables for growing even bigger and stronger!"
msgstr "Великі овочі, щоб стати ще більшим і сильнішим!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ASPARAGUS_SEEDS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ASPARAGUS_SEEDS"
msgid "It grows up to make food."
msgstr "Воно виросте й стане їжею."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "Looks very scary now!"
msgstr "Тепер вона дуже страшна!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.ATRIUM_GATE.COOLDOWN
