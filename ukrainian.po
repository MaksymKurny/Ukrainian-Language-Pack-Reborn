msgstr "Ха! Він думає, що він людина!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCORCHED_SKELETON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCORCHED_SKELETON"
