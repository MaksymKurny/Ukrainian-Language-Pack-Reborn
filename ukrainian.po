msgstr "Скриня має великі сильні роги."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MINOTAURHORN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MINOTAURHORN"
msgid "Is trophy from mighty foe."
msgstr "Трофей з могутнього ворога."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MITEGLAND.COLD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MITEGLAND.COLD"
