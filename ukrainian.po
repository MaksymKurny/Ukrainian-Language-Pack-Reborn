msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_EAT.STALE"
msgid "Tastes funny."
msgstr "Дивний смак."

#. STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_EAT.YUCKY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ANNOUNCE_EAT.YUCKY"
