msgstr "Крихітна палійка Віллоу розкладає вогнища іграшкою! Дуже вражає."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_8
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_8"
msgid "Hardened, like Wolfgang."
msgstr "Гума тверда, як Вольфґанґ."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_9
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRINKET_9"
msgid "Strong brainlady Wickerbottom maybe need for repair cardigans."
msgstr "Може, вони знадобляться сильній розумниці Вікерботтом для її кардиганів."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_FISH.BURNING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_FISH.BURNING"
